{
  "mcpServers": {
    "chrome-mcp": {
      "command": "npx",
      "args": [
        "node",
        "/Users/enes/.nvm/versions/node/v22.17.0/lib/node_modules/mcp-chrome-bridge/dist/mcp/mcp-server-stdio.js"
      ]
    },
    "clojure-mcp": {
      "command": "/bin/sh",
      "args": [
        "-c",
        "cd /Users/enes/Projects/clojure-mcp && PATH=/opt/homebrew/bin:$PATH && clojure -X:mcp-shadow-dual"
      ],
      "env": {
        "HOME": "/tmp"
      }
    }
  ,
  "morph-mcp": {
    "type": "stdio",
    "command": "/bin/sh",
    "args": [
      "-c",
      "set -a; [ -f /Users/enes/Projects/single-tenant-template/.api_credentials.sh ] && source /Users/enes/Projects/single-tenant-template/.api_credentials.sh; set +a; exec /Users/enes/.nvm/versions/node/v22.17.0/bin/npx -y @morphllm/morphmcp"
    ],
    "env": {
      "PATH": "/Users/enes/.nvm/versions/node/v22.17.0/bin:/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin",
      "WARPGREP_EXCLUDES": ".git,node_modules,target,.shadow-cljs,.clj-kondo,.cpcache,dist,build,out,.next,.idea,.vscode,.DS_Store,npm-debug.log*,yarn-debug.log*,yarn-error.log*",
      "ENABLED_TOOLS": "edit_file,warpgrep_codebase_search"
    }
  }
}
}