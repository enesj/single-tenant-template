# Copy this file to `.env` (gitignored) and fill in the values.
# All secrets can be supplied via env vars — they take precedence over config/.secrets.edn.
# run-app.sh sources .env automatically; docker-compose.yml reads it for container passwords.

# ── Docker / Database ────────────────────────────────────────────────────────
# Required: docker-compose.yml uses these for the dev/test Postgres containers.
POSTGRES_PASSWORD=password
POSTGRES_TEST_PASSWORD=password

# Mirror the values above so the Clojure app connects without needing .secrets.edn.
DB_DEV_PASSWORD=password
DB_TEST_PASSWORD=password

# ── App config ───────────────────────────────────────────────────────────────
# Optional: override Aero profile (dev / test / prod). Defaults to dev.
# AERO_PROFILE=dev

# Optional: full JDBC URL — takes highest priority, overrides all other DB config.
# DATABASE_URL=jdbc:postgresql://localhost:55432/multi_tenant_pos?user=app_user&password=password

# ── OAuth ────────────────────────────────────────────────────────────────────
# GOOGLE_OAUTH_CLIENT_ID=
# GOOGLE_OAUTH_CLIENT_SECRET=
# GITHUB_OAUTH_CLIENT_ID=
# GITHUB_OAUTH_CLIENT_SECRET=

# ── Stripe ───────────────────────────────────────────────────────────────────
# STRIPE_TEST_API_KEY=sk_test_...
# STRIPE_TEST_WEBHOOK_SECRET=whsec_...
# STRIPE_LIVE_API_KEY=sk_live_...
# STRIPE_LIVE_WEBHOOK_SECRET=whsec_...

# ── Email / SMTP ─────────────────────────────────────────────────────────────
# SMTP_HOST=smtp.gmail.com
# SMTP_USER=
# SMTP_PASS=              # Gmail: use an App Password, not your account password
# SMTP_FROM_EMAIL=
# POSTMARK_API_KEY=
# POSTMARK_FROM_EMAIL=

# ── External APIs ────────────────────────────────────────────────────────────
# GOOGLE_PLACES_API_KEY=
# SERPER_API_KEY=
# CEREBRAS_API_KEY=
