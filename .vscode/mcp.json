        "PATH=/opt/homebrew/bin:$PATH && npx node /Users/enes/.nvm/versions/node/v22.17.0/lib/node_modules/mcp-chrome-bridge/dist/mcp/mcp-server-stdio.js"
      ]
    },
    "postgres": {
      "command": "/bin/sh",
      "args": [
        "-c",
        "cd /Users/enes/Projects/single-tenant-template && docker compose up -d db && set -a; [ -f /Users/enes/Projects/single-tenant-template/.postgres.env ] && source /Users/enes/Projects/single-tenant-template/.postgres.env; set +a; exec /Users/enes/Projects/toolbox --prebuilt postgres --stdio"
