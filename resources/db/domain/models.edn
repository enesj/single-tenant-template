{;; ============================================================================
 ;; Home Expenses Tracker — Domain Database Schema
 ;; ============================================================================
 ;; This file defines all tables for the expense tracking domain.
 ;; ============================================================================

 ;; ----------------------------------------------------------------------------
 ;; Suppliers (stores, shops, vendors)
 ;; ----------------------------------------------------------------------------

 :suppliers {:fields [[:id :uuid {:primary-key true}]
                      [:display_name [:varchar 255] {:null false}]
                      [:normalized_key [:varchar 255] {:null false}]
                      [:address :text]
                      [:archived_at :timestamptz]
                      [:created_at :timestamptz {:default "NOW()"}]
                      [:updated_at :timestamptz {:default "NOW()"}]]
             :indexes [[:idx_suppliers_normalized_key :btree {:fields [:normalized_key] :unique true}]]}

 ;; ----------------------------------------------------------------------------
 ;; Supplier Aliases (deduplicated raw supplier guesses -> canonical suppliers)
 ;; ----------------------------------------------------------------------------

 :supplier_aliases {:fields [[:id :uuid {:primary-key true}]
                             ;; Representative latest-seen raw label text
                             [:raw_label :text]
                             ;; Canonical normalized key for dedupe
                             [:raw_label_normalized [:varchar 255] {:null false}]
                             ;; NULL = unmapped
                             [:supplier_id :uuid {:foreign-key :suppliers/id :on-delete :set-null}]
                             [:confidence :integer {:default 100}]
                             [:created_at :timestamptz {:default "NOW()"}]
                             [:updated_at :timestamptz {:default "NOW()"}]]
                    :indexes [[:idx_supplier_aliases_raw_label_normalized
                               :btree
                               {:fields [:raw_label_normalized] :unique true}]
                              [:idx_supplier_aliases_supplier_id
                               :btree
                               {:fields [:supplier_id]}]]}

 ;; ----------------------------------------------------------------------------
 ;; Manufacturers (canonical product manufacturers/brands)
 ;; ----------------------------------------------------------------------------

 :manufacturers {:fields [[:id :uuid {:primary-key true}]
                          [:display_name [:varchar 255] {:null false}]
                          [:normalized_key [:varchar 255] {:null false}]
                          [:archived_at :timestamptz]
                          [:created_at :timestamptz {:default "NOW()"}]
                          [:updated_at :timestamptz {:default "NOW()"}]]
                 :indexes [[:idx_manufacturers_normalized_key :btree {:fields [:normalized_key] :unique true}]]}

 ;; ----------------------------------------------------------------------------
 ;; Manufacturer Aliases (deduplicated raw manufacturer guesses -> canonical manufacturers)
 ;; ----------------------------------------------------------------------------

 :manufacturer_aliases {:fields [[:id :uuid {:primary-key true}]
                                 ;; Representative latest-seen raw label text
                                 [:raw_label :text]
                                 ;; Canonical normalized key for dedupe
                                 [:raw_label_normalized [:varchar 255] {:null false}]
                                 ;; NULL = unmapped
                                 [:manufacturer_id :uuid {:foreign-key :manufacturers/id :on-delete :set-null}]
                                 [:confidence :integer {:default 100}]
                                 [:created_at :timestamptz {:default "NOW()"}]
                                 [:updated_at :timestamptz {:default "NOW()"}]]
                        :indexes [[:idx_manufacturer_aliases_raw_label_normalized
                                   :btree
                                   {:fields [:raw_label_normalized] :unique true}]
                                  [:idx_manufacturer_aliases_manufacturer_id
                                   :btree
                                   {:fields [:manufacturer_id]}]]}

;; ----------------------------------------------------------------------------
 ;; Payers (payment methods: cash, cards, accounts, people)
 ;; ----------------------------------------------------------------------------

 :payers {:fields [[:id :uuid {:primary-key true}]
                   [:payer_type_id :uuid {:foreign-key :payer_types/id :on-delete :set-null}]
                   [:label [:varchar 255] {:null false}]
                   [:last4 [:varchar 4]]  ;; For cards
                   [:is_default :boolean {:default false}]
                   [:created_at :timestamptz {:default "NOW()"}]
                   [:updated_at :timestamptz {:default "NOW()"}]]
          :indexes [[:idx_payers_payer_type :btree {:fields [:payer_type_id]}]]}

 ;; ----------------------------------------------------------------------------
 ;; Payer Types (reference table for payer categories)
 ;; ----------------------------------------------------------------------------

 :payer_types {:fields [[:id :uuid {:primary-key true}]
                        [:label [:varchar 255] {:null false}]
                        [:is_default :boolean {:null false :default false}]
                        [:created_at :timestamptz {:default "NOW()"}]
                        [:updated_at :timestamptz {:default "NOW()"}]]
               :indexes [[:idx_payer_types_label :btree {:fields [:label] :unique true}]
                         [:uniq_payer_types_default :btree {:fields [:is_default]
                                                            :unique true
                                                            :where [:= :is_default true]}]]}

;; ----------------------------------------------------------------------------
 ;; Receipts (uploaded images, ADE processing status)
 ;; ----------------------------------------------------------------------------

 :receipts {:fields [[:id :uuid {:primary-key true}]
                     [:user_id :uuid {:foreign-key :users/id :on-delete :set-null}]  ;; User who uploaded this receipt
                     [:payer_id :uuid {:foreign-key :payers/id :on-delete :set-null}]  ;; Optional payer chosen at upload time (used as default during approval)
                     [:storage_key :text {:null false}]  ;; S3/local path
                     [:file_hash [:varchar 64] {:null false}]  ;; SHA-256 for dedupe
                     [:original_filename [:varchar 255]]
                     [:content_type [:varchar 100]]
                     [:file_size :integer]
                     [:status [:enum :receipt-status] {:null false :default "uploaded"}]
                     [:raw_parse_json :jsonb]
                     [:raw_extract_json :jsonb]
                     [:parsed_markdown :text]
                     [:supplier_guess [:varchar 255]]
                     [:supplier_alias_id :uuid {:foreign-key :supplier_aliases/id :on-delete :set-null}]
                     [:total_amount_guess [:decimal 12 2]]
                     [:currency_guess [:enum :currency]]
                     [:purchased_at_guess :timestamptz]
                     [:error_message :text]
                     [:error_details :jsonb]
                     [:retry_count :integer {:default 0}]
                     [:expense_id :uuid]  ;; Reference to expense (FK to be added in later migration)
                     [:created_at :timestamptz {:default "NOW()"}]
                     [:updated_at :timestamptz {:default "NOW()"}]]
            :types [[:receipt-status :enum {:choices ["uploaded" "parsing" "parsed"
                                                      "extracting" "extracted" "review_required"
                                                      "approved" "posted" "failed"]}]]
            :indexes [[:idx_receipts_user :btree {:fields [:user_id]}]
                      [:idx_receipts_file_hash :btree {:fields [:file_hash] :unique true}]
                      [:idx_receipts_status :btree {:fields [:status]}]
                      [:idx_receipts_supplier_alias_id :btree {:fields [:supplier_alias_id]}]
                      [:idx_receipts_created_at :btree {:fields [:created_at]}]]}

;; ----------------------------------------------------------------------------
 ;; Expenses (posted entries with totals)
 ;; ----------------------------------------------------------------------------

 :expenses {:fields [[:id :uuid {:primary-key true}]
                     [:user_id :uuid {:foreign-key :users/id :on-delete :set-null}]  ;; User who owns this expense
                     [:receipt_id :uuid {:foreign-key :receipts/id :on-delete :set-null}]
                     [:supplier_id :uuid {:foreign-key :suppliers/id :null false :on-delete :restrict}]
                     [:payer_id :uuid {:foreign-key :payers/id :null false}]
                     [:purchased_at :timestamptz {:null false}]
                     [:total_amount [:decimal 12 2] {:null false}]
                     [:currency [:enum :currency] {:null false :default "BAM"}]
                     [:notes :text]
                     [:is_posted :boolean {:default true :null false}]  ;; Draft vs Posted
                     [:deleted_at :timestamptz]  ;; Soft delete
                     [:created_at :timestamptz {:default "NOW()"}]
                     [:updated_at :timestamptz {:default "NOW()"}]]
            :types [[:currency :enum {:choices ["BAM" "EUR" "USD"]}]]
            :indexes [[:idx_expenses_user :btree {:fields [:user_id]}]
                      [:idx_expenses_supplier :btree {:fields [:supplier_id]}]
                      [:idx_expenses_payer :btree {:fields [:payer_id]}]
                      [:idx_expenses_purchased_at :btree {:fields [:purchased_at]}]
                      [:idx_expenses_is_posted :btree {:fields [:is_posted]}]]}

;; ----------------------------------------------------------------------------
;; User Expense Settings (per-user defaults)
;; ----------------------------------------------------------------------------

 :user_expense_settings {:fields [[:user_id :uuid {:primary-key true}
                                   :foreign-key :users/id
                                   :on-delete :cascade]
                                  [:default_currency [:enum :currency] {:null false :default "BAM"}]
                                  [:default_payer_id :uuid {:foreign-key :payers/id :on-delete :set-null}]
                                  [:notifications_enabled :boolean {:null false :default true}]
                                  [:auto_post_after_upload_enabled :boolean {:null false :default false}]
                                  [:receipt_refine_enabled :boolean {:null false :default false}]
                                  [:created_at :timestamptz {:default "NOW()"}]
                                  [:updated_at :timestamptz {:default "NOW()"}]]}

;; ----------------------------------------------------------------------------
 ;; Expense Items (line items on receipts)
 ;; ----------------------------------------------------------------------------

 ;; ----------------------------------------------------------------------------
 ;; Raw Labels (deduplicated receipt line item labels)
 ;; ----------------------------------------------------------------------------

 :raw_labels {:fields [[:id :uuid {:primary-key true}]
                       [:raw_label :text {:null false}]
                       [:normalized_key [:varchar 255] {:null false}]
                       [:created_at :timestamptz {:default "NOW()"}]
                       [:updated_at :timestamptz {:default "NOW()"}]]
              :indexes [[:idx_raw_labels_normalized_key :btree {:fields [:normalized_key] :unique true}]]}

 :expense_items {:fields [[:id :uuid {:primary-key true}]
                          [:expense_id :uuid {:foreign-key :expenses/id :null false :on-delete :cascade}]
                           ;; Canonical raw label reference (deduped). Use joins to render raw_labels.raw_label.
                           ;; NOTE (Phase 1): this becomes optional once we switch to alias-based labeling.
                           ;; We keep the column for backward-compat & later cleanup, but allow NULL for new writes.
                           [:raw_label_id :uuid {:foreign-key :raw_labels/id}]
                          ;; NEW (Phase 1): canonical alias reference (eventually replaces raw_label_id + article_id)
                          [:alias_id :uuid {:foreign-key :article_aliases/id}]
                          [:article_id :uuid {:foreign-key :articles/id :on-delete :set-null}]
                          [:qty [:decimal 10 3]]
                          [:unit_price [:decimal 12 2]]
                          [:line_total [:decimal 12 2] {:null false}]
                          [:deleted_at :timestamptz]  ;; Soft delete
                          [:created_at :timestamptz {:default "NOW()"}]]
                 :indexes [[:idx_expense_items_expense :btree {:fields [:expense_id]}]
                           [:idx_expense_items_article :btree {:fields [:article_id]}]
                           [:idx_expense_items_raw_label_id :btree {:fields [:raw_label_id]}]
                           [:idx_expense_items_alias :btree {:fields [:alias_id]}]]}

;; ----------------------------------------------------------------------------
 ;; Articles (canonical products/items)
 ;; ----------------------------------------------------------------------------

 :articles {:fields [[:id :uuid {:primary-key true}]
                     [:canonical_name [:varchar 255] {:null false}]
                     [:normalized_key [:varchar 255] {:null false}]
                     [:category [:varchar 100]]
                     [:link :text]
                     ;; Raw manufacturer string (legacy / display-only). Canonical manufacturer is manufacturer_id.
                     [:manufacturer [:varchar 255]]
                     ;; Optional link to observed manufacturer label (alias) for unmapped/mapping workflows.
                     [:manufacturer_alias_id :uuid {:foreign-key :manufacturer_aliases/id :on-delete :set-null}]
                     ;; Canonical manufacturer link (Option A). Keep nullable until backfill.
                     [:manufacturer_id :uuid {:foreign-key :manufacturers/id :on-delete :set-null}]
                     [:created_at :timestamptz {:default "NOW()"}]
                     [:updated_at :timestamptz {:default "NOW()"}]]
            :indexes [[:idx_articles_normalized_key :btree {:fields [:normalized_key] :unique true}]
                      [:idx_articles_category :btree {:fields [:category]}]
                      [:idx_articles_manufacturer_alias_id :btree {:fields [:manufacturer_alias_id]}]
                      [:idx_articles_manufacturer_id :btree {:fields [:manufacturer_id]}]]}

;; ----------------------------------------------------------------------------
 ;; Article Aliases (mapping raw labels → canonical articles)
 ;; ----------------------------------------------------------------------------

 :article_aliases {:fields [[:id :uuid {:primary-key true}]
                            [:supplier_id :uuid {:foreign-key :suppliers/id :on-delete :cascade}]
                            ;; NEW (Phase 1): representative latest-seen raw label text
                            [:raw_label :text]
                            [:raw_label_normalized [:varchar 255] {:null false}]
                            ;; CHANGED (Phase 1): allow NULL = unmapped
                            [:article_id :uuid {:foreign-key :articles/id :on-delete :cascade}]
                            [:confidence :integer {:default 100}]  ;; 0-100, 100 = user confirmed
                            [:created_at :timestamptz {:default "NOW()"}]]
                   :indexes [[:idx_article_aliases_supplier_label :btree
                              {:fields [:supplier_id :raw_label_normalized] :unique true}]
                             [:idx_article_aliases_article :btree {:fields [:article_id]}]]}

;; ----------------------------------------------------------------------------
 ;; Price Observations (track prices over time)
 ;; ----------------------------------------------------------------------------

 :price_observations {:fields [[:id :uuid {:primary-key true}]
                               [:article_id :uuid {:foreign-key :articles/id :null false :on-delete :cascade}]
                               [:supplier_id :uuid {:foreign-key :suppliers/id :null false :on-delete :cascade}]
                               [:expense_item_id :uuid {:foreign-key :expense_items/id :on-delete :set-null}]
                               [:observed_at :timestamptz {:null false}]
                               [:unit_price [:decimal 12 2]]
                               [:line_total [:decimal 12 2] {:null false}]
                               [:qty [:decimal 10 3]]
                               [:currency [:enum :currency] {:default "BAM"}]
                               [:created_at :timestamptz {:default "NOW()"}]]
                      :indexes [[:idx_price_obs_article :btree {:fields [:article_id]}]
                                [:idx_price_obs_supplier :btree {:fields [:supplier_id]}]
                                [:idx_price_obs_observed_at :btree {:fields [:observed_at]}]]}}
