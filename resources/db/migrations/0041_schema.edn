({:action :create-table,
  :model-name :stores,
  :fields
  {:updated-at {:default "NOW()", :type :timestamptz},
   :address {:type :text},
   :archived-at {:type :timestamptz},
   :normalized-key {:null false, :type [:varchar 255]},
   :supplier-id
   {:foreign-key :suppliers/id,
    :null false,
    :on-delete :cascade,
    :type :uuid},
   :id {:primary-key true, :type :uuid},
   :place-id {:type :text},
   :display-name {:null false, :type [:varchar 255]},
   :created-at {:default "NOW()", :type :timestamptz}}}
 {:action :create-table,
  :model-name :store_aliases,
  :fields
  {:id {:primary-key true, :type :uuid},
   :raw-label {:type :text},
   :raw-label-normalized {:null false, :type [:varchar 255]},
   :store-id
   {:foreign-key :stores/id, :on-delete :set-null, :type :uuid},
   :confidence {:default 100, :type :integer},
   :created-at {:default "NOW()", :type :timestamptz},
   :updated-at {:default "NOW()", :type :timestamptz}}}
 {:action :add-column,
  :field-name :store-alias-id,
  :model-name :receipts,
  :options
  {:foreign-key :store_aliases/id, :on-delete :set-null, :type :uuid}}
 {:action :create-index,
  :index-name :idx-receipts-store-alias-id,
  :model-name :receipts,
  :options {:fields [:store_alias_id], :type :btree}}
 {:action :create-index,
  :index-name :idx-stores-supplier-normalized-key,
  :model-name :stores,
  :options
  {:fields [:supplier_id :normalized_key], :unique true, :type :btree}}
 {:action :create-index,
  :index-name :idx-store-aliases-store-id,
  :model-name :store_aliases,
  :options {:fields [:store_id], :type :btree}}
 {:action :create-index,
  :index-name :idx-stores-supplier,
  :model-name :stores,
  :options {:fields [:supplier_id], :type :btree}}
 {:action :add-column,
  :field-name :store-guess,
  :model-name :receipts,
  :options {:type [:varchar 255]}}
 {:action :add-column,
  :field-name :store-id,
  :model-name :expenses,
  :options
  {:foreign-key :stores/id, :on-delete :set-null, :type :uuid}}
 {:action :create-index,
  :index-name :idx-expenses-store,
  :model-name :expenses,
  :options {:fields [:store_id], :type :btree}}
 {:action :create-index,
  :index-name :idx-stores-place-id,
  :model-name :stores,
  :options {:fields [:place_id], :type :btree}}
 {:action :create-index,
  :index-name :idx-store-aliases-raw-label-normalized,
  :model-name :store_aliases,
  :options
  {:fields [:raw_label_normalized], :unique true, :type :btree}})
