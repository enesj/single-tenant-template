-- allium: 3

entity FrontendEntityTemplate {
    entity_id: String
    uses_shared_list_view: Boolean
    entity_spec_driven: Boolean
    supports_inline_form_mode: Boolean
    supports_modal_form_mode: Boolean
}

entity FrontendAdapterToolkit {
    normalizer: String
    entity_spec_subscription_registration: String
    sync_registration: String
    upsert_registration: String
}

entity CrudBridgeRuntime {
    entity_key: String
    operation: delete | batch-delete | create | update
    handler_type: request | on-success | on-failure
    admin_context_detected: Boolean
}

entity BackendGenericCrudTemplate {
    generic_path: String
    versioned_entity_path: String
    is_metadata_driven: Boolean
    requires_user_authentication: Boolean
    requires_entities_authorization: Boolean
}

entity GenericCrudAccessPolicy {
    admin_only_entities: Set<String>
    protected_entities: Set<String>
    public_entities: Set<String>
    unknown_entities_blocked: Boolean
}

entity TemplateServiceGraph {
    registered_service_ids: Set<String>
    dependency_ordered_lifecycle: Boolean
    exposes_crud_routes_service: Boolean
}

entity DomainPluginManifest {
    id: String
    has_admin_api_builder: Boolean
    has_user_api_builder: Boolean
    has_spa_fallback_paths: Boolean
}

surface FrontendListViewReuseBoundary {
    context templates: List<FrontendEntityTemplate>

    provides:
        ResolveTableEntitySpec(entity)
            when templates = templates
        ComposeListViewProps(entity)
        RenderListView(entity)

    @guarantee TableEntitySpecResolutionUsesSharedSubscriptionAndRouteAwareConfig
        -- ResolveTableEntitySpec(entity) reads from shared `:entity-specs/by-name` subscription
        -- and resolves route-aware table config (`:admin` or `:domain` table-columns),
        -- including computed field metadata when present.

    @guarantee ListViewPropsAlwaysSeedEntityNameAndSpecBeforeCallerOverrides
        -- ComposeListViewProps(entity) always includes `:entity-name` + `:entity-spec`,
        -- then merges caller-provided props including form display mode, permission flags,
        -- and custom form renderers.

    @guarantee SharedListViewCentralizesCoreListBehaviors
        -- RenderListView(entity) centralizes table/filter/pagination/selection/form behavior
        -- in one `list-view` component, with form mode selected by `:form-display`
        -- (`:inline` or `:modal`).

    @guidance
        -- DRY at this layer is configuration-driven: each page directly composes `list-view`
        -- with subscription-resolved entity specs instead of routing through a shared page wrapper.
}

surface FrontendEntitySpecAndAdapterUtilitiesBoundary {
    context toolkit: FrontendAdapterToolkit

    provides:
        NormalizeEntityName(entity_name)
            when toolkit = toolkit
        BuildEntitySpec(entity_name)
        NormalizeEntity(entity, options)
        RegisterEntitySpecSub(options)
        RegisterSyncEvent(options)
        RegisterUpsertEvent(options)

    @guarantee EntitySpecLookupNormalizesSnakeAndKebabIdentifiers
        -- `:entity-specs/by-name` normalizes identifiers with `normalize-entity-name` so
        -- snake_case and kebab-case inputs resolve consistently.

    @guarantee EntitySpecLookupMergesBackendFieldsWithRouteAwareColumns
        -- `:entity-specs/by-name` merges backend/model fields with route-aware table config
        -- (`:admin` or `:domain` table-columns), including computed field metadata when present.

    @guarantee NormalizeEntityCentralizesIdAliasAndPostTransformRules
        -- `normalize-entity` centralizes ID coercion to strings, namespaced alias generation,
        -- optional alias mirroring, fallback ID synthesis, and post-transform hooks.

    @guarantee AdapterRegistrationHelpersReplacePerEntityBoilerplate
        -- `register-entity-spec-sub!`, `register-sync-event!`, and `register-upsert-event!`
        -- provide reusable adapter registration primitives instead of per-entity
        -- subscription/event boilerplate.

    @guidance
        -- Adapter reuse is intentionally data-shape focused; HTTP event ownership remains outside
        -- these utility helpers.
}

surface FrontendCrudBridgeAndSuccessBoundary {
    context runtime: CrudBridgeRuntime

    provides:
        RegisterCrudBridge(options)
            when runtime = runtime
        RunBridgeOperation(operation, handler_type, entity_type, args)
        BuildDefaultCrudRequest(entity_type, payload)
        HandleCreateSuccess(entity_type, response)
        HandleUpdateSuccess(entity_type, id, response)

    @guarantee CrudBridgeRegistrationMergesNestedOperationOverrides
        -- `register-crud-bridge!` stores bridge overrides per entity and merges nested operation
        -- configs, enabling additive customization without replacing entire handlers.

    @guarantee BridgeOperationStartsFromDefaultEffectThenAppliesEligibleOverrides
        -- `run-bridge-operation` computes a default effect first, then applies only context-eligible
        -- bridges ordered by descending priority.

    @guarantee DefaultCrudHandlersChooseEndpointFromAdminContext
        -- Default create/update/delete request handlers route to admin or public endpoints via
        -- `in-admin-context?` (route-name/path based, token presence ignored).

    @guarantee SharedCrudSuccessHandlingLivesInOneNamespace
        -- Shared success handling is centralized in `app.template.frontend.shared.crud.success`
        -- (`extract-entity-id`, recently-created/recently-updated tracking, form success-state merge).

    @guidance
        -- DRY here standardizes success/failure semantics while still permitting domain/admin-
        -- specific bridge overrides.
}

surface DomainLocalListEventSupportBoundary {
    provides:
        BuildDomainListRequestParams(namespace, entity_type)
        BeginDomainListLoading(namespace, entity_type)
        FinishDomainListLoading(namespace, entity_type, error)
        BuildEntityListFetchEffect(namespace, entity_type, params)
        BuildEntityListSuccessEffect(namespace, entity_type, response)

    @guarantee DomainListStacksCanReuseLocalHelperNamespacesWithoutGlobalFactoryCoupling
        -- Domain-owned list stacks may extract a local helper namespace for request-param
        -- derivation, loading/error state, and narrow entity-backed fetch/success effects
        -- without coupling that reuse to global admin event factories.

    @guarantee SharedListEffectHelpersStayIntentionallyNarrow
        -- Shared list-effect helpers stay intentionally narrow: they apply only where rows
        -- come from `:data`, totals fall back to row count, optional highlight metadata is
        -- stored uniformly, and the success path needs one sync dispatch plus standard list
        -- metadata writes.

    @guidance
        -- User-expenses list events now use this boundary via a local helper namespace.
        -- Bespoke flows such as receipts, recent pages, lookup lists with extra local state,
        -- and entity families that maintain additional caches remain outside the narrow helper
        -- until their contracts genuinely match.
}

surface BackendGenericCrudReuseBoundary {
    context boundary: BackendGenericCrudTemplate

    provides:
        BuildGenericCrudHandlers(crud_service)
            when boundary = boundary
        BuildGenericCrudRouteTree(crud_service)
        ResolveEntityRoutesFromContainer(db, models_data, service_container)
        ComposeVersionedEntityCrudRoutes(db, models_data, service_container)

    @guarantee CrudRouteNamespaceExposesReusableProtocolBackedHandlers
        -- `routes/crud.clj` exposes reusable handler constructors (`get-items-handler`,
        -- `get-item-handler`, `create-item-handler`, `update-item-handler`, `delete-item-handler`,
        -- batch handlers, validation handler`) that delegate to `crud-protocols/*`.

    @guarantee CrudRoutesUseSingleMetadataDrivenRouteTemplate
        -- `crud-routes` defines one metadata-driven route template (`/api/:entity` + subroutes)
        -- instead of duplicating per-entity backend route definitions.

    @guarantee EntitiesRoutesReuseContainerProvidedCrudRoutes
        -- `entities-routes` requires a non-nil service container and reuses container-provided
        -- `:crud-routes` rather than rebuilding route trees per caller.

    @guarantee VersionedEntityRoutesAddUserAuthAndEntitiesAuthorization
        -- `create-versioned-api-routes` remaps the generic path to `/entities/:entity`, adds
        -- user-auth + entities-authorization middleware, and mounts it inside the versioned API
        -- composition.

    @guarantee VersionedEntityRoutesKeepExplicitUsersReadException
        -- `create-versioned-api-routes` keeps an explicit users-read exception: GET
        -- `/entities/users` delegates to `app.backend.routes.admin-api/list-users-handler`.

    @guidance
        -- Generic CRUD reuse is intentionally broad for mechanical CRUD, but explicit exceptions
        -- are kept where existing behavior requires tighter coupling.
}

surface GenericCrudSecurityConstraintBoundary {
    context policy: GenericCrudAccessPolicy

    provides:
        CheckGenericCrudEntityAccess(entity_key, is_admin)
            when policy = policy
        BuildBlockedEntityResponse(entity_key, reason)
        ReadAllowedUserEntities()

    @guarantee GenericCrudAllowlistIsFailSafeDenyByDefault
        -- `entity-allowed-for-generic-crud?` is fail-safe deny-by-default: unknown entities are
        -- blocked.

    @guarantee AdminOnlyEntitiesRemainBlockedFromGenericCrud
        -- Admin-only entities (`:admins`, `:admin-sessions`, `:audit-logs`) are blocked from
        -- generic CRUD regardless of request context.

    @guarantee ProtectedUsersEntityRequiresProtectedHandlingPath
        -- Protected entities (`:users`) are allowed only through protected handling paths;
        -- public-entity set is currently empty.

    @guidance
        -- This is a deliberate DRY boundary: shared generic handlers exist, but security policy
        -- intentionally narrows what can reuse them.
}

surface DIContainerAndFactoryReuseBoundary {
    context graph: TemplateServiceGraph

    provides:
        RegisterTemplateServices(di_container, config, db_connection, metadata, domain_config)
            when graph = graph
        InitializeContainer(di_container)
        StartContainer(di_container)
        BuildServiceContainer(config, db_connection, metadata, domain_config)

    @guarantee TemplateServiceRegistrationDefinesSharedConstructorsOnce
        -- `register-template-services!` registers shared constructors once (`:db-adapter`,
        -- metadata/type-casting/validation/query services, `:crud-service`, auth/email services,
        -- route services including `:crud-routes`).

    @guarantee ServiceLifecycleExecutesInDependencyOrder
        -- `initialize-services!` and `start-services!` execute service lifecycle in topological
        -- dependency order, preventing duplicate manual boot ordering across callers.

    @guarantee ServiceContainerFactoryExposesCompatibilityMap
        -- `create-service-container` reuses the DI container and exposes a compatibility map
        -- (`:crud-service`, `:crud-routes`, `:get-service`, etc.) for downstream route composition.

    @guidance
        -- DRY at this layer removes repeated service wiring while preserving explicit service IDs
        -- and dependency declarations.
}

surface DomainRegistryPluginReuseBoundary {
    context manifests: List<DomainPluginManifest>

    provides:
        CollectAdminDomainRoutes(db, service_container)
            when manifests = manifests
        CollectUserDomainRoutes(db, wrap_user_auth, app_config)
        CollectDomainSpaFallbackRoutes()
        ComposeAdminApiWithDomains(db, service_container)
        ComposeUserApiWithDomains(db, service_container)

    @guarantee EnabledDomainsIsTheSinglePluginManifestList
        -- `enabled-domains` is the single plugin list; each manifest contributes optional
        -- `:routes :admin-api`, optional `:routes :user-api`, and SPA fallback paths.

    @guarantee DomainRouteCollectorsPreserveManifestOrderAndAllowNilBuilders
        -- `all-admin-api-routes` and `all-user-api-routes` map enabled manifests in order and
        -- permit nil entries when a domain omits a route builder.

    @guarantee ApiComposersFilterNilDomainTreesBeforeMounting
        -- Both API composers filter nil domain route trees before mounting (`admin_api.clj` and
        -- `api.clj`), enabling plugin-style reuse without route duplication.

    @guarantee SpaFallbackCollectorDeduplicatesStableFirstSeenPaths
        -- `all-spa-routes` concatenates domain SPA paths, drops nils, and de-duplicates in stable
        -- first-seen order.

    @guidance
        -- Domain reuse is composition-first: template route shells stay stable while domain modules
        -- plug in route trees.
}

rule FrontendCrudReuseIsSpecDriven {
    when: PageComposesListView(entity)

    ensures:
        FrontendCrudReuseConfirmed(entity: entity)
        SharedEntitySpecResolutionConfirmed(entity: entity)
        SharedListViewReuseConfirmed(entity: entity)
}

rule AdapterUtilitiesEliminatePerEntityGlueDuplication {
    when: DomainOrAdminAdapterRegisters(entity)

    ensures:
        EntityNormalizationReuseConfirmed(entity: entity)
        EntitySpecSubscriptionReuseConfirmed(entity: entity)
        SharedSyncAndUpsertRegistrationConfirmed(entity: entity)
}

rule BridgeAndSuccessReuseKeepsCrudSemanticsConsistent {
    when: CrudOperationDispatched(operation, entity)

    ensures:
        CrudBridgeOperationConsistencyConfirmed(operation: operation, entity: entity)
        SharedCrudSuccessHandlingConfirmed(entity: entity)
}

rule GenericCrudReuseIsConstrainedBySecurityBoundaries {
    when: GenericCrudRequestReceived(entity)

    ensures:
        GenericCrudAccessPolicyApplied(entity: entity)
        ProtectedEntityHandlingRemainsExplicit(entity: entity)
        DomainSpecificCrudFallbackPreserved(entity: entity)
}

rule DIAndRegistryReuseMinimizeRouteAndServiceDuplication {
    when: BackendComposesApisAndServices()

    ensures:
        ServiceContainerReuseConfirmed()
        DomainRouteCompositionReuseConfirmed()
        SharedSpaFallbackCollectionConfirmed()
}

open question "GET /entities/users currently delegates to `app.backend.routes.admin-api/list-users-handler` as an explicit coupling point. Should this eventually move to a dedicated user-boundary endpoint while preserving existing behavior?"

open question "`public-entities` is currently empty in generic entity access policy. If broadened later, should expansion require explicit per-entity security and domain-rule validation tests before allowlisting?"