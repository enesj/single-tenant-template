-- allium: 3

-- Railway production deployment workflow.
--
-- Covers: CI pipeline (GitHub Actions, parallel backend + frontend jobs);
--         Docker two-stage build (builder → runtime uberjar);
--         Railway container deploy; health-check readiness gate;
--         required env var startup preconditions;
--         automatic preDeploy migrations on every deploy;
--         production inspection via Railway MCP and CLI.
--
-- Sources: .github/workflows/ci.yml, Dockerfile,
--          docs/general/operations/railway-deployment.md

use "../shared/infrastructure.allium" as infra

-- ---------------------------------------------------------------------------
-- Actors
-- ---------------------------------------------------------------------------

entity Developer {
    github_username: String
}

entity Operator {
    railway_account: String
}

external entity Railway {}

-- ---------------------------------------------------------------------------
-- Entities
-- ---------------------------------------------------------------------------

entity CodePush {
    sha: String
    branch: String
    repository: String
    pushed_by: Developer
}

entity CIPipeline {
    push: CodePush
    status: running | passed | failed
    backend_job: CIJob
    frontend_job: CIJob

    transitions status {
        running -> passed
        running -> failed
        terminal: passed, failed
    }
}

entity CIJob {
    name: String
    status: running | passed | failed
    failure_reason: String?

    transitions status {
        running -> passed
        running -> failed
        terminal: passed, failed
    }
}

entity DockerBuild {
    push: CodePush
    status: building | succeeded | failed
    artifact: UberJar?

    transitions status {
        building -> succeeded
        building -> failed
        terminal: succeeded, failed
    }
}

entity UberJar {
    -- Produced by Stage 1 (builder: JDK 21 + Node 22 + Clojure CLI):
    --   npm ci → clj -T:build uber (PostCSS → Shadow CLJS release → AOT uberjar)
    -- Copied to Stage 2 (runtime: JRE 21 only) at /app/app.jar.
    -- The runtime image intentionally ships no Clojure CLI, bb, or npm.
    path: String
}

entity DeployedRevision {
    build: DockerBuild
    status: starting | healthy | unhealthy | replaced
    port: Integer
    health_check_failures: Integer

    transitions status {
        starting -> healthy
        starting -> unhealthy
        healthy -> replaced
        terminal: unhealthy, replaced
    }
}

entity SchemaRevision {
    applied_migrations: List<String>
    pending_migrations: List<String>
}

-- Railway config: railway.json
-- - preDeployCommand runs migrations before the app starts on every deploy
-- - healthcheckPath: /health, healthcheckTimeout: 300s
-- - restartPolicyType: ON_FAILURE, maxRetries: 3
--
-- Standalone migration runner: src/app/migrate.clj
-- - AOT-compiled into the uberjar alongside app.main
-- - Reads DATABASE_URL, calls automigrate.core/migrate, then exits

-- ---------------------------------------------------------------------------
-- Config
-- ---------------------------------------------------------------------------

config {
    health_check_interval: Duration  = 30.seconds
    health_check_timeout:  Duration  = 5.seconds
    health_check_start_period: Duration = 30.seconds   -- JVM cold-start grace period
    health_check_retries:  Integer   = 3
    default_port:          Integer   = 8080            -- Runtime image falls back to 8080 when PORT is absent
}

-- ---------------------------------------------------------------------------
-- Rules
-- ---------------------------------------------------------------------------

rule CITriggeredOnMainPush {
    when: push: CodePush.created
    requires: push.branch = "main"

    ensures:
        let backend_job = CIJob.created(
            name: "backend",
            status: running,
            failure_reason: null
        )
        let frontend_job = CIJob.created(
            name: "frontend",
            status: running,
            failure_reason: null
        )
        CIPipeline.created(
            push: push,
            status: running,
            backend_job: backend_job,
            frontend_job: frontend_job
        )
}

rule RailwayBuildTriggeredOnMainPush {
    when: push: CodePush.created
    requires: push.branch = "main"
    ensures: DockerBuild.created(push: push, status: building)
}

-- CI and Railway build are triggered in parallel by the same GitHub push.
-- Railway does NOT wait for CI to pass before building and deploying.

open question "Should Railway deployment be gated on CI passing, given that CI and Railway are currently triggered independently by the same push to main and a failed CI run does not prevent the build from reaching production?"

rule DockerBuildSucceeds {
    when: build: DockerBuild.status becomes building
    ensures: build.artifact = UberJar.created(path: "/app/app.jar")
    ensures: build.status = succeeded
}

rule DockerBuildFails {
    when: build: DockerBuild.status becomes building
    requires: build.artifact = null
    ensures: build.status = failed
}

rule CIJobSucceeds {
    when: job: CIJob.status becomes running
    requires: job.failure_reason = null
    ensures: job.status = passed
}

rule CIJobFails {
    when: job: CIJob.status becomes running
    requires: job.failure_reason != null
    ensures: job.status = failed
}

rule RestartPassedCIJob {
    when: CIJobPassedRestarted(ciJob)

    requires: ciJob.status = passed

    ensures: ciJob.status = running
}

rule RestartFailedCIJob {
    when: CIJobFailedRestarted(ciJob)

    requires: ciJob.status = failed

    ensures: ciJob.status = running
}

rule MarkCIJobPassed {
    when: CIJobPassed(ciJob)

    requires: ciJob.status = running

    ensures: ciJob.status = passed
}

rule MarkCIJobFailed {
    when: CIJobFailed(ciJob)

    requires: ciJob.status = running

    ensures: ciJob.status = failed
}

rule CIPipelinePassesWhenJobsPass {
    when: job: CIJob.status transitions_to passed

    let pipelines = CIPipeline where backend_job = job or frontend_job = job

    ensures:
        for pipeline in pipelines:
            if pipeline.status = running
               and pipeline.backend_job.status = passed
               and pipeline.frontend_job.status = passed:
                pipeline.status = passed
}

rule CIPipelineFailsWhenAnyJobFails {
    when: job: CIJob.status transitions_to failed

    let pipelines = CIPipeline where backend_job = job or frontend_job = job

    ensures:
        for pipeline in pipelines:
            if pipeline.status = running:
                pipeline.status = failed
}

rule RestartPassedCIPipeline {
    when: CIPipelinePassedRestarted(ciPipeline)

    requires: ciPipeline.status = passed

    ensures: ciPipeline.status = running
}

rule RestartFailedCIPipeline {
    when: CIPipelineFailedRestarted(ciPipeline)

    requires: ciPipeline.status = failed

    ensures: ciPipeline.status = running
}

rule MarkCIPipelinePassed {
    when: CIPipelinePassed(ciPipeline)

    requires: ciPipeline.status = running

    ensures: ciPipeline.status = passed
}

rule MarkCIPipelineFailed {
    when: CIPipelineFailed(ciPipeline)

    requires: ciPipeline.status = running

    ensures: ciPipeline.status = failed
}

rule ServiceStartsAfterSuccessfulBuild {
    when: build: DockerBuild.status transitions_to succeeded
    ensures: DeployedRevision.created(
        build: build,
        status: starting,
        port: config.default_port,
        health_check_failures: 0
    )
}

rule RestartSucceededDockerBuild {
    when: DockerBuildSucceededRestarted(dockerBuild)

    requires: dockerBuild.status = succeeded

    ensures: dockerBuild.status = building
}

rule RestartFailedDockerBuild {
    when: DockerBuildFailedRestarted(dockerBuild)

    requires: dockerBuild.status = failed

    ensures: dockerBuild.status = building
}

rule MarkDockerBuildSucceeded {
    when: DockerBuildSucceeded(dockerBuild)

    requires: dockerBuild.status = building

    ensures: dockerBuild.status = succeeded
}

rule MarkDockerBuildFailed {
    when: DockerBuildFailed(dockerBuild)

    requires: dockerBuild.status = building

    ensures: dockerBuild.status = failed
}

rule ServiceBecomesHealthy {
    -- Health check: GET /health polled every config.health_check_interval.
    -- The config.health_check_start_period grace window lets the JVM complete
    -- its cold start before failures count toward config.health_check_retries.
    when: revision: DeployedRevision.status becomes starting
    requires: revision.health_check_failures < config.health_check_retries
    ensures: revision.status = healthy
}

rule ServiceBecomesUnhealthy {
    -- Triggered when required env vars are absent (DATABASE_URL, BASE_URL, etc.)
    -- or when the JVM fails to bind the port within the start-period grace window.
    when: revision: DeployedRevision.status becomes starting
    requires: revision.health_check_failures >= config.health_check_retries
    ensures: revision.status = unhealthy
}

rule PreviousRevisionReplaced {
    when: revision: DeployedRevision.status transitions_to healthy
    let previous = DeployedRevision where status = healthy and build != revision.build
    for old in previous:
        ensures: old.status = replaced
}

rule RestartUnhealthyDeployedRevision {
    when: DeployedRevisionUnhealthyRestarted(deployedRevision)

    requires: deployedRevision.status = unhealthy

    ensures: deployedRevision.status = starting
}

rule RestartReplacedDeployedRevision {
    when: DeployedRevisionReplacedRestarted(deployedRevision)

    requires: deployedRevision.status = replaced

    ensures: deployedRevision.status = starting
}

rule MarkDeployedRevisionHealthy {
    when: DeployedRevisionHealthy(deployedRevision)

    requires: deployedRevision.status = starting

    ensures: deployedRevision.status = healthy
}

rule MarkDeployedRevisionUnhealthy {
    when: DeployedRevisionUnhealthy(deployedRevision)

    requires: deployedRevision.status = starting

    ensures: deployedRevision.status = unhealthy
}

rule ReplaceDeployedRevisionStatus {
    when: DeployedRevisionReplaced(deployedRevision)

    requires: deployedRevision.status = healthy

    ensures: deployedRevision.status = replaced
}

rule MigrationsRunBeforeDeploy {
    -- Railway's preDeployCommand runs migrations BEFORE the app starts (every deploy).
    -- Config: railway.json → deploy.preDeployCommand
    -- Command: java -cp /app/app.jar clojure.main -m app.migrate
    -- Runner: src/app/migrate.clj — reads DATABASE_URL, calls automigrate.core/migrate.
    -- If migrations fail, the deploy is aborted (app never starts).
    when: build: DockerBuild.status transitions_to succeeded
    ensures: SchemaRevision.created(pending_migrations: {})
}

rule MigrationsFailAbortsDeploy {
    -- If the preDeployCommand exits non-zero (e.g. DATABASE_URL missing, migration
    -- SQL error), Railway aborts the deployment. The previous revision stays live.
    when: build: DockerBuild.status transitions_to succeeded
    requires: SchemaRevision.pending_migrations != {}
    ensures: build.status = failed
}

-- ---------------------------------------------------------------------------
-- Surfaces
-- ---------------------------------------------------------------------------

surface CIPipelineBoundary {
    facing viewer: Developer

    context pipeline: CIPipeline where push.branch = "main"

    exposes:
        pipeline.status
        pipeline.backend_job.status
        pipeline.frontend_job.status
        pipeline.backend_job.failure_reason
        pipeline.frontend_job.failure_reason

    @guarantee BackendJobUsesExpectedToolchainAndTestDb
        -- pipeline.backend_job runs Java 21 + Clojure CLI + Babashka against a Postgres 13
        -- test DB on port 55433.

    @guarantee FrontendJobUsesExpectedToolchain
        -- pipeline.frontend_job runs Java 21 + Node 25 + npm + Clojure CLI + Babashka.

    @guarantee BackendAndFrontendJobsRunInParallel
        -- pipeline.backend_job and pipeline.frontend_job execute in parallel.

    @guidance
        -- CI results appear as GitHub commit and PR status checks.
        -- A passing CI pipeline does not gate Railway deployment — it is an independent signal.
}

surface RailwayDeployBoundary {
    facing operator: Operator

    context revision: DeployedRevision

    exposes:
        revision.status
        revision.port
        revision.health_check_failures
        revision.build.status

    @guarantee RuntimePortPrefersRailwayInjectedValue
        -- Railway injects PORT in production deploys.
        -- When PORT is absent, the runtime image falls back to config.default_port (8080).

    @guarantee DatabaseUrlIsInjectedWhenPostgresIsLinked
        -- DATABASE_URL is injected automatically when a Railway Postgres service is linked.

    @guarantee StartupHardFailsOnlyForCoreSecrets
        -- Startup hard-fails when database connectivity cannot be resolved
        -- (DATABASE_URL or equivalent DB password config) and, in production,
        -- when EMAIL_PRIVACY_ENCRYPTION_KEY_B64 or EMAIL_PRIVACY_LOOKUP_KEY_B64 are missing.

    @guarantee OptionalIntegrationsWarnRatherThanAbortStartup
        -- Missing GOOGLE_OAUTH_CLIENT_SECRET or outbound-email provider credentials
        -- leave those integrations disabled and emit warnings rather than aborting startup.
}

surface HealthCheckBoundary {
    facing platform: Railway

    context revision: DeployedRevision

    provides:
        CheckHealth(platform, revision)

    @guarantee HealthCheckSucceedsOnHttp200
        -- CheckHealth succeeds when GET /health returns HTTP 200.

    @guarantee HealthCheckUsesConfiguredPollingIntervalAndDeadline
        -- CheckHealth is polled every config.health_check_interval with a
        -- config.health_check_timeout response deadline.

    @guarantee StartPeriodFailuresDoNotCountTowardRetryBudget
        -- Failures within the first config.health_check_start_period do not count
        -- toward config.health_check_retries (JVM cold-start grace).

    @guarantee RepeatedFailuresOutsideGraceRestartContainer
        -- After config.health_check_retries consecutive failures outside the grace
        -- period, the container is restarted.

    timeout: ServiceBecomesUnhealthy
}

surface ProductionInspectionBoundary {
    facing operator: Operator

    context revision: DeployedRevision where status = healthy

    provides:
        InspectLogs(operator, revision)
        InspectVariables(operator, revision)
        RunCommandWithProdEnv(operator, revision, command)

    @guarantee ProdEnvCommandsRunLocallyWithInjectedVariables
        -- RunCommandWithProdEnv executes command locally on the operator's machine
        -- with all Railway env vars (including DATABASE_URL) injected.
        -- It does NOT execute inside the running container.

    @guarantee RuntimeContainerRemainsJreOnly
        -- The runtime container image is JRE-only: no Clojure CLI, bb, or npm.
        -- All interactive tooling must run via RunCommandWithProdEnv.

    @guarantee NreplCommandsTargetTheProductionDatabase
        -- RunCommandWithProdEnv with command = "clj -M:nrepl" opens a live nREPL
        -- session connected to the production database.
        -- Writes via that session are production mutations.

    @guidance
        -- Preferred path: Railway MCP tools (get-logs, list-variables, list-services)
        -- — structured output, queryable by AI agents.
        -- Install: claude mcp add Railway npx @railway/mcp-server
        -- Fallback: railway logs, railway variables, railway run clj -M:nrepl (CLI).
        -- During triage, prefer read-only queries. Wrap any mutations in explicit
        -- transactions that can be rolled back before committing.
}
