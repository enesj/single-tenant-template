-- Multi-Tenancy: Shared-Schema, Tenant-Scoped Access
-- Status: candidate (initial elicitation — to be refined)
--
-- Approach: shared database schema with tenant_id FK on tenant-owned tables.
-- No row-level security policies (enforcement at application/middleware layer).
-- Users can belong to multiple tenants via TenantMembership.

use "./authentication.allium" as auth

-- ============================================================
-- ENTITIES
-- ============================================================

entity Tenant {
    name: String
    slug: String                                        -- URL-safe, unique
    status: active | suspended | archived

    -- Relationships
    memberships: TenantMembership with tenant = this

    -- Projections
    owners: memberships where role = owner and status = active
    active_memberships: memberships where status = active
}

entity TenantMembership {
    tenant: Tenant
    user: auth/User
    role: owner | admin | member | viewer
    status: active | suspended | invited
    invited_by: auth/User?

    -- Derived
    can_manage_users: role in {owner, admin}
    has_full_domain_access: role in {owner, admin}
    has_expense_access: role in {owner, admin, member}
    has_expense_read_access: role in {owner, admin, member, viewer}
}

entity TenantInvitation {
    tenant: Tenant
    email: String
    role: admin | member | viewer                       -- can't invite as owner
    invited_by: auth/User
    status: pending | accepted | expired | revoked
    token: String
    expires_at: Timestamp

    is_valid: status = pending and expires_at > now
}

-- ============================================================
-- DATA SCOPING CLASSIFICATION
-- ============================================================

-- Tenant-scoped tables (get tenant_id FK, NOT NULL):
--
--   Transactional (user-owned):
--     expenses, expense_items, receipts,
--     user_expense_settings, payers
--
--   Reference (per-tenant catalog):
--     suppliers, stores, articles, manufacturers,
--     categories, subcategories,
--     supplier_aliases, store_aliases, article_aliases,
--     price_observations
--
-- Global tables (no tenant_id, shared across all tenants):
--     cities, countries, payer_types, expense_categories, raw_labels
--
-- Platform tables (no tenant_id, admin-only):
--     admins, admin_sessions, audit_logs, login_events,
--     backlog, dedup_ignored_clusters

-- ============================================================
-- ACCESS MODEL
-- ============================================================

-- Two identity pools, separate concerns:
--
--   Platform Admins (admins table):
--     Full access to ALL tables EXCEPT:
--       expenses, expense_items, receipts, payers, payer_types
--     Manage global reference data (cities, countries, expense_categories).
--     Can view/manage tenants and memberships.
--
--   Tenant Users (users table + tenant_memberships):
--     ALL access scoped to their tenant's rows via tenant_id filtering.
--     A user NEVER sees another tenant's data, regardless of role.
--
--     owner:  full domain access within tenant + user management + tenant settings
--     admin:  full domain access within tenant + user management
--     member: expenses, expense_items, receipts (read + write) + payers (read)
--     viewer: expenses, expense_items, receipts (read only) + payers (read)

-- ============================================================
-- TENANT PROVISIONING (self-service)
-- ============================================================

-- Fires for both password registration AND OAuth signup (Google/GitHub).
-- UserAuthenticated is emitted by auth/LoginWithPassword, auth/OAuthCreatesUser,
-- and auth/OAuthUpdatesExistingOAuthUser — so any first-time login creates a tenant.
rule CreateTenantOnFirstLogin {
    when: UserAuthenticated(user)

    requires: user.memberships.count = 0                -- first-time user, no tenant yet

    ensures:
        let tenant = Tenant.created(
            name: user.full_name + "'s workspace",
            slug: generate_slug(user.email),
            status: active
        )
        TenantMembership.created(
            tenant: tenant,
            user: user,
            role: owner,
            status: active,
            invited_by: null
        )
        TenantProvisioned(tenant: tenant, owner: user)
}

rule SeedTenantReferenceData {
    when: TenantProvisioned(tenant, owner)

    -- Copy current global reference data into tenant-scoped rows.
    -- Each copied row gets tenant_id = tenant.id.
    -- Source: the reference tables at the time of provisioning.

    ensures:
        for s in Supplier:
            Supplier.created(tenant: tenant, name: s.name, metadata: s.metadata)
        for st in Store:
            Store.created(tenant: tenant, supplier: st.supplier, city: st.city, name: st.name)
        for a in Article:
            Article.created(tenant: tenant, name: a.name, subcategory: a.subcategory, manufacturer: a.manufacturer)
        for m in Manufacturer:
            Manufacturer.created(tenant: tenant, name: m.name)
        for c in Category:
            Category.created(tenant: tenant, name: c.name)
        for sc in Subcategory:
            Subcategory.created(tenant: tenant, name: sc.name, category: sc.category)
        TenantReferenceDataSeeded(tenant: tenant)

    guidance:
        Alias tables (supplier_aliases, store_aliases, article_aliases) and
        price_observations start empty — they accumulate as the tenant uses the system.
}

rule JoinTenantFromInvitation {
    when: UserAcceptsInvitation(user, invitation_token)

    let invitation = TenantInvitation{token: invitation_token}

    requires: exists invitation
    requires: invitation.is_valid
    requires: user.email = invitation.email
    requires: not exists TenantMembership{tenant: invitation.tenant, user: user}

    ensures:
        TenantMembership.created(
            tenant: invitation.tenant,
            user: user,
            role: invitation.role,
            status: active,
            invited_by: invitation.invited_by
        )
        invitation.status = accepted
        TenantJoined(tenant: invitation.tenant, user: user)
}

-- ============================================================
-- TENANT USER MANAGEMENT
-- ============================================================

rule InviteUserToTenant {
    when: TenantUserInvited(inviter, tenant, email, role)

    let inviter_membership = TenantMembership{tenant: tenant, user: inviter}

    requires: exists inviter_membership
    requires: inviter_membership.can_manage_users
    requires: inviter_membership.status = active
    requires: role in {admin, member, viewer}           -- can't invite as owner
    requires: not exists TenantInvitation{tenant: tenant, email: email, status: pending}

    ensures:
        TenantInvitation.created(
            tenant: tenant,
            email: email,
            role: role,
            invited_by: inviter,
            status: pending,
            token: generate_invitation_token(),
            expires_at: now + 7.days
        )
        InvitationEmailDispatched(email: email, tenant: tenant)
}

rule ChangeTenantMemberRole {
    when: TenantMemberRoleChanged(actor, tenant, target_user, new_role)

    let actor_membership = TenantMembership{tenant: tenant, user: actor}
    let target_membership = TenantMembership{tenant: tenant, user: target_user}

    requires: exists actor_membership
    requires: exists target_membership
    requires: actor_membership.status = active
    requires: actor != target_user                      -- can't change own role

    -- Only owners can promote to admin or change admin roles
    requires:
        if new_role = admin or target_membership.role = admin:
            actor_membership.role = owner
        else:
            actor_membership.can_manage_users

    -- Owner role is not assignable this way
    requires: new_role in {admin, member, viewer}

    ensures: target_membership.role = new_role
}

rule RemoveUserFromTenant {
    when: TenantMemberRemoved(actor, tenant, target_user)

    let actor_membership = TenantMembership{tenant: tenant, user: actor}
    let target_membership = TenantMembership{tenant: tenant, user: target_user}

    requires: exists actor_membership
    requires: exists target_membership
    requires: actor_membership.can_manage_users
    requires: actor != target_user
    requires: target_membership.role != owner           -- can't remove an owner

    ensures: not exists target_membership
}

-- ============================================================
-- TENANT-SCOPED DATA ACCESS RULES
-- ============================================================

entity TenantDataRequest {
    user: auth/User
    tenant: Tenant
    resource: String
    action: read | write | power
    membership: TenantMembership?

    -- Derived
    membership: TenantMembership{tenant: tenant, user: user}
}

-- Resource tiers define which tenant roles can access which resources.
-- ALL tiers are scoped to the requesting user's active tenant (tenant_id filtering).
-- No rule in this spec ever grants cross-tenant data access.
config {
    -- Expense tier: core transactional data. Members can read+write, viewers read-only.
    expense_tier_resources: Set<String> = {
        "expenses", "expense_items", "receipts"
    }

    -- Payers: needed by all members to create expenses. Read-only for members/viewers.
    expense_tier_read_resources: Set<String> = {
        "expenses", "expense_items", "receipts", "payers"
    }

    -- Full tier: all tenant-scoped resources. Admin and owner only, within their tenant.
    full_tier_resources: Set<String> = {
        "expenses", "expense_items", "receipts",
        "payers", "user_expense_settings",
        "suppliers", "stores", "articles", "manufacturers",
        "categories", "subcategories",
        "supplier_aliases", "store_aliases", "article_aliases",
        "price_observations"
    }
}

rule AllowExpenseTierReadForAllTenantMembers {
    when: TenantDataRequested(request)

    requires: request.action = read
    requires: request.resource in config.expense_tier_read_resources
    requires: exists request.membership
    requires: request.membership.status = active
    requires: request.membership.has_expense_read_access

    ensures: TenantDataGranted(request: request, scope: request.tenant)
}

rule AllowExpenseTierWriteForMembersAndAbove {
    when: TenantDataRequested(request)

    requires: request.action = write
    requires: request.resource in config.expense_tier_resources
    requires: exists request.membership
    requires: request.membership.status = active
    requires: request.membership.has_expense_access

    ensures: TenantDataGranted(request: request, scope: request.tenant)
}

rule AllowFullTierForTenantAdminsAndOwners {
    when: TenantDataRequested(request)

    requires: request.resource in config.full_tier_resources
    requires: exists request.membership
    requires: request.membership.status = active
    requires: request.membership.has_full_domain_access

    ensures: TenantDataGranted(request: request, scope: request.tenant)
}

-- TENANT ISOLATION GUARANTEE
-- Every TenantDataGranted emission carries scope = request.tenant.
-- The implementation layer MUST filter all queries by tenant_id = scope.id.
-- This is enforced at the middleware/service layer (not RLS) for now.

rule DenyAccessWhenNoMembership {
    when: TenantDataRequested(request)

    requires:
        not exists request.membership
        or request.membership.status != active

    ensures: TenantDataDenied(request: request, reason: no_active_membership)
}

rule DenyNonExpenseTierWriteForRegularMembers {
    when: TenantDataRequested(request)

    requires: request.action = write
    requires: request.resource not in config.expense_tier_resources
    requires: exists request.membership
    requires: request.membership.status = active
    requires: not request.membership.has_full_domain_access

    ensures: TenantDataDenied(request: request, reason: insufficient_tenant_role)
}

rule DenyNonExpenseTierReadForRegularMembers {
    when: TenantDataRequested(request)

    requires: request.action = read
    requires: request.resource not in config.expense_tier_read_resources
    requires: exists request.membership
    requires: request.membership.status = active
    requires: not request.membership.has_full_domain_access

    ensures: TenantDataDenied(request: request, reason: insufficient_tenant_role)
}

-- ============================================================
-- PLATFORM ADMIN ACCESS RULES
-- ============================================================

entity PlatformAdminDataRequest {
    admin: auth/Admin
    resource: String
    action: read | write
}

config {
    platform_admin_blocked_resources: Set<String> = {
        "expenses", "expense_items", "receipts", "payers", "payer_types"
    }
}

rule AllowPlatformAdminAccessOutsideBlockedResources {
    when: PlatformAdminDataRequested(request)

    requires: request.admin.status = active
    requires: request.resource not in config.platform_admin_blocked_resources

    ensures: PlatformAdminDataGranted(request: request)
}

rule DenyPlatformAdminAccessToBlockedResources {
    when: PlatformAdminDataRequested(request)

    requires: request.resource in config.platform_admin_blocked_resources

    ensures: PlatformAdminDataDenied(
        request: request,
        reason: expense_data_restricted_from_platform_admin
    )
}

-- ============================================================
-- TENANT CONTEXT IN SESSION
-- ============================================================

rule SetActiveTenantInSession {
    when: UserSelectsTenant(user, tenant, session)

    let membership = TenantMembership{tenant: tenant, user: user}

    requires: exists membership
    requires: membership.status = active

    ensures:
        session.active_tenant = tenant
        session.active_membership = membership
        TenantContextSet(user: user, tenant: tenant)
}

-- ============================================================
-- SURFACES
-- ============================================================

surface TenantManagementBoundary {
    facing viewer: auth/User

    context membership: TenantMembership where user = viewer and status = active

    exposes:
        membership.tenant.name
        membership.tenant.slug
        membership.tenant.status
        membership.role

    provides:
        TenantUserInvited(viewer, membership.tenant, email, role)
            when membership.can_manage_users

        TenantMemberRoleChanged(viewer, membership.tenant, target_user, new_role)
            when membership.can_manage_users

        TenantMemberRemoved(viewer, membership.tenant, target_user)
            when membership.can_manage_users

    related:
        TenantMembersView(membership.tenant)
            when membership.can_manage_users
}

surface TenantMembersView {
    facing viewer: auth/User

    context tenant: Tenant

    exposes:
        for m in tenant.active_memberships:
            m.user.full_name
            m.user.email
            m.role
            m.status

    provides:
        TenantMemberRoleChanged(viewer, tenant, target_user, new_role)
        TenantMemberRemoved(viewer, tenant, target_user)
}

surface TenantSwitcher {
    facing viewer: auth/User

    exposes:
        for m in TenantMembership with user = viewer and status = active:
            m.tenant.name
            m.tenant.slug
            m.role

    provides:
        UserSelectsTenant(viewer, tenant, session)
}

surface PlatformTenantAdminView {
    facing admin: auth/Admin

    exposes:
        for t in Tenant:
            t.name
            t.slug
            t.status
            t.owners.count
            t.active_memberships.count

    guidance:
        Platform admins can view all tenants but cannot access
        tenant expense data (expenses, expense_items, receipts, payers, payer_types).
}

-- ============================================================
-- OPEN QUESTIONS
-- ============================================================

-- resolved: Tenant members DO have read access to payers (added to expense_tier_read_resources).
-- resolved: OAuth signup DOES auto-create a tenant (CreateTenantOnFirstLogin chains from UserAuthenticated).
-- resolved: No data migration needed — fresh start, just seed the platform admin.
-- resolved: New tenants start with a COPY of current reference data (SeedTenantReferenceData rule).

open question "Tenant ownership transfer — should an owner be able to transfer ownership to another admin? What happens if the only owner leaves?"

open question "Should the tenant slug be used for URL routing (e.g., /t/{slug}/expenses) or should tenant context be purely session-based?"

open question "Rate limiting and quotas — should these be per-tenant or remain global?"
