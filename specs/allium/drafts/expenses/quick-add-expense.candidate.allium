-- allium: 2
-- quick-add-expense.candidate.allium
--
-- Scope: current Quick Add expense workflow only.
-- Includes:
--   - dashboard entry point for users who can write expenses
--   - /expenses/new manual entry form
--   - expense creation through /api/v1/expenses
--   - success and failure outcomes visible to the user
-- Excludes:
--   - receipt upload / OCR / approval flows
--   - smart search / inline creation flow from smart-expense-form
--   - expense editing, deletion, and posting after creation
--   - admin reference-data management outside the Quick Add form

external entity ExpenseUser {
    id: UUID
    tenant_id: UUID
    membership_role: viewer | member | admin | owner
    can_write_expenses: membership_role in {member, admin, owner}
}

actor ExpenseWriter {
    identified_by: ExpenseUser where can_write_expenses
}

external entity Supplier {
    id: UUID
    display_name: String
}

external entity Store {
    id: UUID
    display_name: String
    supplier_id: UUID?
}

external entity ExpenseCategory {
    id: UUID
    name: String
}

external entity Article {
    id: UUID
    canonical_name: String
}

external entity Payer {
    id: UUID
    label: String
}

external entity Expense {
    id: UUID
    tenant_id: UUID
    user_id: UUID?
    created_by: UUID?
    supplier_id: UUID?
    store_id: UUID?
    payer_id: UUID
    expense_category_id: UUID?
    purchased_at: Timestamp
    total_amount: Decimal
    currency: BAM | EUR | USD
    notes: String?
}

external entity ExpenseItem {
    id: UUID
    expense_id: UUID
    raw_label: String?
    qty: Decimal?
    unit_price: Decimal?
    line_total: Decimal
}

value QuickAddLineItem {
    raw_label: String?
    qty: Decimal?
    unit_price: Decimal?
    line_total: Decimal?
}

entity QuickAddExpenseDraft {
    supplier: Supplier?
    store: Store?
    expense_category: ExpenseCategory?
    article: Article?
    payer: Payer?
    purchased_at: Timestamp = now
    currency: BAM | EUR | USD = BAM
    entered_total: Decimal?
    notes: String?
    line_items: List<QuickAddLineItem>

    has_any_context: supplier != null or store != null or expense_category != null
    complete_line_items: line_items where raw_label != null and raw_label != "" and line_total != null
    computed_total: complete_line_items.sum(i => i.line_total)
    effective_total: entered_total ?? computed_total
}

surface ExpensesDashboardQuickActions {
    facing viewer: ExpenseUser

    provides:
        OpenQuickAddExpense(viewer)
            when viewer.can_write_expenses

    @guarantee QuickAddVisibility
        -- The dashboard shows the Quick Add action only to users with
        -- expense-write capability.
}

surface QuickAddExpenseForm {
    facing viewer: ExpenseWriter

    context draft: QuickAddExpenseDraft

    exposes:
        draft.supplier
        draft.store
        draft.expense_category
        draft.article
        draft.payer
        draft.purchased_at
        draft.currency
        draft.entered_total
        draft.notes
        draft.line_items
        draft.computed_total
            when draft.complete_line_items.count > 0

    provides:
        SearchQuickAddSuppliers(viewer, draft, query: String)
        SearchQuickAddStores(viewer, draft, query: String)
        SearchQuickAddCategories(viewer, draft, query: String)
        SearchQuickAddArticles(viewer, draft, query: String)
        AddQuickAddLineItem(draft)
        RemoveQuickAddLineItem(draft, line_item: QuickAddLineItem)
            when draft.line_items.count > 1
        CancelQuickAdd(viewer)
        SubmitQuickAddExpense(viewer, draft)
            when draft.payer != null
            and draft.purchased_at != null
            and draft.has_any_context
            and draft.complete_line_items.count > 0
            and draft.effective_total > 0

    @guarantee DefaultSelections
        -- Opening the form loads suppliers and payers and selects the first
        -- available supplier and payer when no value has been chosen yet.

    @guarantee ContextFirstEntry
        -- Quick Add starts with context fields available immediately.
        -- Users may begin by choosing supplier, store, category, article, or a
        -- combination of them; the workflow does not force an article-first
        -- or item-search-first opening step.

    @guarantee StoreInfersSupplier
        -- Selecting a store automatically fills supplier from that store.
        -- The draft cannot hold a store whose supplier conflicts with the
        -- selected supplier context.

    @guarantee SupplierChangeClearsConflictingStore
        -- If the user changes supplier and the currently selected store does
        -- not belong to that supplier, the store selection is cleared before
        -- further search or submission continues.

    @guarantee CategorySelectionIsStable
        -- Once the user chooses an expense category, later supplier, store,
        -- or article choices do not auto-change or clear that category.
        -- The chosen category remains part of the filtering context until the
        -- user explicitly changes it.

    @guarantee ArticleIsNotSupplierOrStoreScoped
        -- Article choice is not constrained by supplier, store, or prior
        -- purchase history. The same article may be used with different
        -- suppliers and different stores.

    @guarantee ContextConstrainedSearch
        -- Every context search and picker result is filtered by all choices
        -- already made in the draft where a real domain relationship exists.
        -- Each new choice narrows only the candidate sets that are actually
        -- constrained by that context.

    @guidance
        -- Example: if a store is chosen first, supplier is inferred from that
        -- store. If supplier is chosen first, store search only shows stores
        -- belonging to that supplier. Article search is not narrowed by
        -- supplier/store history alone.

    @guarantee AtLeastOneRowRemains
        -- Removing line items never leaves the form without a row; the user
        -- always sees at least one editable line-item row.

    @guarantee LineTotalAutofill
        -- When quantity and unit price are entered for a line item and its
        -- line total is still blank, the form auto-fills line total as
        -- quantity × unit price.

    @guarantee TotalConsistency
        -- If the user enters an explicit total, it must match the sum of the
        -- complete line items within minor rounding tolerance.

    @guarantee SuccessfulSubmitOutcome
        -- A successful submit navigates to the created expense detail.
        -- Recent expenses are refreshed so the created expense appears in
        -- dashboard-backed recent data.

    @guarantee FailedSubmitOutcome
        -- Validation failures and API failures keep the user on the form and
        -- display an error message.
}

rule CreateExpenseFromQuickAdd {
    when: SubmitQuickAddExpense(writer, draft)

    let prepared_items = draft.complete_line_items
    let effective_total = draft.effective_total

    requires: draft.payer != null
    requires: draft.purchased_at != null
    requires: draft.has_any_context
    requires: draft.store = null or draft.supplier = null or draft.store.supplier_id = draft.supplier.id
    requires: prepared_items.count > 0
    requires: effective_total > 0

    ensures: expense: Expense.created(
        tenant_id: writer.tenant_id,
        user_id: writer.id,
        created_by: writer.id,
        supplier_id: draft.supplier?.id,
        store_id: draft.store?.id,
        payer_id: draft.payer.id,
        expense_category_id: draft.expense_category?.id,
        purchased_at: draft.purchased_at,
        total_amount: effective_total,
        currency: draft.currency,
        notes: draft.notes
    )

    ensures:
        for item in prepared_items:
            ExpenseItem.created(
                expense_id: expense.id,
                raw_label: item.raw_label,
                qty: item.qty,
                unit_price: item.unit_price,
                line_total: item.line_total
            )

    @guidance
        -- The current backend may also resolve created expense items against
        -- supplier-scoped article aliases when a matching alias already exists.
        -- That enrichment is part of persisted behavior, but it is not the
        -- primary focus of this first Quick Add workflow slice.
}
