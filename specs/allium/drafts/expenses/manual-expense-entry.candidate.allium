-- Manual Expense Entry
-- Status: candidate (v2 — fixed from review comments)
--
-- Allows users to enter expenses manually with maximum flexibility:
-- from a minimal "total + one context" entry to a full itemized expense.
-- One adaptive form that reveals detail progressively.

use "./../../domain/expenses/implementation.allium" as impl


-- ─────────────────────────────────────────────
-- External entities (defined elsewhere in domain)
-- ─────────────────────────────────────────────

external entity User { id: UUID, tenant_id: UUID }
external entity Tenant { id: UUID }

external entity Supplier {
    id: UUID, display_name: String, normalized_key: String
}

external entity Store {
    id: UUID, supplier_id: UUID, display_name: String, normalized_key: String, city_id: UUID?
}

external entity Article {
    id: UUID, canonical_name: String, normalized_key: String,
    subcategory_id: UUID?, manufacturer_id: UUID?
}

external entity ExpenseCategory {
    id: UUID, tenant_id: UUID, name: String
}

external entity Payer {
    id: UUID, tenant_id: UUID, label: String, is_default: Boolean
}

external entity Expense {
    id: UUID, tenant_id: UUID, user_id: UUID?, created_by: UUID?,
    receipt_id: UUID?, supplier_id: UUID?, store_id: UUID?,
    payer_id: UUID, expense_category_id: UUID?,
    purchased_at: Timestamp, total_amount: Decimal,
    currency: Currency, notes: String?, is_posted: Boolean
}

external entity ExpenseItem {
    id: UUID, tenant_id: UUID, expense_id: UUID,
    alias_id: UUID?, article_id: UUID?,
    raw_label: String?, qty: Decimal?, unit_price: Decimal?,
    line_total: Decimal
}


-- ─────────────────────────────────────────────
-- Value types
-- ─────────────────────────────────────────────

value Currency = BAM | EUR | USD

value MoneyAmount {
    value: Decimal
    requires: value > 0
}

value LineItemDraft {
    raw_label: String
    qty: Decimal?
    unit_price: Decimal?
    line_total: MoneyAmount

    requires: raw_label.trim().length >= 1
    requires: qty = null or qty > 0
    requires: unit_price = null or unit_price > 0

    -- Auto-calculate line_total when both qty and unit_price are present
    guarantee: qty != null and unit_price != null implies line_total.value = qty * unit_price
}

value InlineReference {
    -- A user-provided reference that may resolve to an existing entity or create a new one.
    -- Exactly one of existing_id or new_name must be set.
    kind: supplier | store | article | expense_category
    existing_id: UUID?
    new_name: String?

    requires: (existing_id != null) xor (new_name != null)
    requires: new_name = null or new_name.trim().length >= 1
}


-- ─────────────────────────────────────────────
-- Manual expense entry draft (client-side form state)
-- ─────────────────────────────────────────────

entity ManualExpenseDraft {
    -- Core (always required)
    total_amount: MoneyAmount?                          -- user-entered; nil when itemized mode computes it
    payer: Payer                                        -- defaults to user's default payer

    -- Context references (at least one required)
    supplier: InlineReference?                          -- pick existing or create new
    store: InlineReference?                             -- pick existing or create new
    expense_category: InlineReference?                  -- pick existing or create new
    article: InlineReference?                           -- single article for minimal entry (no items)

    -- Defaults
    purchased_at: Timestamp = now                       -- defaults to today
    currency: Currency = BAM                            -- defaults to BAM
    notes: String?

    -- Line items (optional — presence switches to itemized mode)
    items: List<LineItemDraft>
    itemized_mode: Boolean = false                      -- explicit toggle; true once user adds items

    -- Derived
    has_items: items.count > 0
    computed_total: if has_items then items.sum(i => i.line_total.value) else null
    effective_total: if has_items then computed_total else total_amount?.value
    has_any_context: supplier != null or store != null
                     or expense_category != null or article != null

    -- ── Validation ──

    -- Payer is always required
    requires: payer != null

    -- At least one context reference beyond payer
    requires: has_any_context

    -- Must have a positive total (either user-entered or computed)
    requires: effective_total != null and effective_total > 0

    -- In non-itemized mode, total_amount must be explicitly set
    requires: not has_items implies total_amount != null

    -- Article (single-article shortcut) is mutually exclusive with itemized mode
    requires: article != null implies not has_items

    -- Store requires a supplier context (a store belongs to a supplier)
    requires: store != null implies supplier != null
}


-- ─────────────────────────────────────────────
-- Submission rule
-- ─────────────────────────────────────────────

rule SubmitManualExpense {
    when: UserSubmitsExpense(user: User, draft: ManualExpenseDraft)

    requires: draft.payer != null
    requires: draft.has_any_context
    requires: draft.effective_total > 0

    -- ── Phase 1: Resolve or create inline references ──
    -- Each inline ref either validates an existing entity or creates a new one.
    -- Tenant-scoped entities (ExpenseCategory) are validated against user's tenant.
    -- Global catalog entities (Supplier, Store, Article) are created without tenant scope.

    if draft.supplier != null and draft.supplier.new_name != null:
        ensures: supplier: Supplier.created(
            display_name: draft.supplier.new_name
        )

    if draft.store != null and draft.store.new_name != null:
        -- Store creation requires supplier context: use resolved or existing supplier
        let store_supplier_id = if draft.supplier != null and draft.supplier.existing_id != null
            then draft.supplier.existing_id
            else supplier.id    -- from the Supplier.created above
        ensures: store: Store.created(
            supplier_id: store_supplier_id,
            display_name: draft.store.new_name
        )

    if draft.expense_category != null and draft.expense_category.new_name != null:
        ensures: category: ExpenseCategory.created(
            tenant_id: user.tenant_id,
            name: draft.expense_category.new_name
        )

    if draft.article != null and draft.article.new_name != null:
        ensures: new_article: Article.created(
            canonical_name: draft.article.new_name
        )

    -- ── Phase 2: Resolve final IDs ──
    -- For existing references, use their existing_id directly.
    -- For new references, use the ID from the entity created above.
    -- Tenant-scoped existing refs must belong to user's tenant.

    let final_supplier_id = if draft.supplier = null then null
        else if draft.supplier.existing_id != null then draft.supplier.existing_id
        else supplier.id

    let final_store_id = if draft.store = null then null
        else if draft.store.existing_id != null then draft.store.existing_id
        else store.id

    let final_category_id = if draft.expense_category = null then null
        else if draft.expense_category.existing_id != null then draft.expense_category.existing_id
        else category.id

    let final_article_id = if draft.article = null then null
        else if draft.article.existing_id != null then draft.article.existing_id
        else new_article.id

    -- ── Phase 3: Build final items ──
    -- If itemized: use draft items as-is.
    -- If single article (no items): synthesize one line item.
    -- If neither: no line items (total-only expense).

    let final_items = if draft.has_items then draft.items
        else if final_article_id != null then
            [LineItemDraft(
                raw_label: draft.article.new_name ?? article_name_for(final_article_id),
                qty: 1,
                unit_price: draft.effective_total,
                line_total: MoneyAmount(value: draft.effective_total)
            )]
        else []

    -- ── Phase 4: Create expense + items ──

    ensures: expense: Expense.created(
        tenant_id: user.tenant_id,
        user_id: user.id,
        created_by: user.id,
        supplier_id: final_supplier_id,
        store_id: final_store_id,
        expense_category_id: final_category_id,
        payer_id: draft.payer.id,
        purchased_at: draft.purchased_at,
        total_amount: draft.effective_total,
        currency: draft.currency,
        notes: draft.notes,
        is_posted: true
    )

    ensures:
        for item in final_items:
            ExpenseItem.created(
                tenant_id: user.tenant_id,
                expense_id: expense.id,
                raw_label: item.raw_label,
                qty: item.qty,
                unit_price: item.unit_price,
                line_total: item.line_total.value
            )
}


-- ─────────────────────────────────────────────
-- Tenant safety on existing reference resolution
-- ─────────────────────────────────────────────

rule ValidateExistingReferences {
    when: UserSubmitsExpense(user: User, draft: ManualExpenseDraft)

    -- Tenant-scoped entities must belong to the user's tenant
    if draft.expense_category != null and draft.expense_category.existing_id != null:
        requires: ExpenseCategory where id = draft.expense_category.existing_id
            and tenant_id = user.tenant_id
            exists

    if draft.payer != null:
        requires: Payer where id = draft.payer.id
            and tenant_id = user.tenant_id
            exists

    -- Global catalog entities: just verify existence
    if draft.supplier != null and draft.supplier.existing_id != null:
        requires: Supplier where id = draft.supplier.existing_id exists

    if draft.store != null and draft.store.existing_id != null:
        requires: Store where id = draft.store.existing_id exists
        -- Also verify store belongs to selected supplier
        requires: Store where id = draft.store.existing_id
            and supplier_id = draft.supplier.existing_id
            exists

    if draft.article != null and draft.article.existing_id != null:
        requires: Article where id = draft.article.existing_id exists
}


-- ─────────────────────────────────────────────
-- Adaptive form surface
-- ─────────────────────────────────────────────

actor ExpenseUser {
    identified_by: User where tenant_id = tenant.id
    within: Tenant
}

surface ManualExpenseForm {
    facing viewer: ExpenseUser

    context draft: ManualExpenseDraft

    -- ── Always visible ──
    exposes:
        draft.currency
        draft.purchased_at
        draft.payer
        draft.notes

    -- ── Total: editable when no items, read-only when itemized ──
    exposes:
        draft.total_amount
            when not draft.has_items
        draft.computed_total
            when draft.has_items

    -- ── Context section (at least one must be filled) ──
    exposes:
        draft.supplier
        draft.store
            when draft.supplier != null
        draft.expense_category
        draft.article
            when not draft.itemized_mode

    -- ── Itemized section (toggled by user) ──
    exposes:
        draft.itemized_mode
        draft.items
            when draft.itemized_mode

    -- ── Actions ──
    provides:
        UserSubmitsExpense(viewer, draft)
            when draft.effective_total != null
            and draft.effective_total > 0
            and draft.payer != null
            and draft.has_any_context

        ToggleItemizedMode(draft)
        AddLineItem(draft)
            when draft.itemized_mode
        RemoveLineItem(draft, item_index: Integer)
            when draft.itemized_mode and draft.items.count > 0

    -- ── Reference pickers with inline creation ──
    provides:
        PickOrCreateSupplier(draft, ref: InlineReference)
            when ref.kind = supplier
        PickOrCreateStore(draft, ref: InlineReference)
            when ref.kind = store and draft.supplier != null
        PickOrCreateCategory(draft, ref: InlineReference)
            when ref.kind = expense_category
        PickOrCreateArticle(draft, ref: InlineReference)
            when ref.kind = article and not draft.itemized_mode

    guidance:
        The form starts in minimal mode: total, payer (pre-filled with default),
        purchased_at (pre-filled with today), currency (default BAM),
        and the context reference pickers (supplier, category, article).
        Store picker appears only after supplier is selected.
        Article picker disappears when user toggles itemized mode.

    guidance:
        When user toggles itemized mode ON: total_amount becomes read-only
        (computed from line items), article field is hidden and cleared.
        When toggled OFF: items list is cleared, total becomes editable again.

    guidance:
        Store picker resets when supplier changes, since stores belong to suppliers.
        Store options should be filtered by the selected supplier.

    guidance:
        When user selects an article in minimal mode (no items), show a hint:
        "This will create a single line item on save."
}


-- ─────────────────────────────────────────────
-- Phase 2 (deferred): Smart suggestions
-- ─────────────────────────────────────────────

deferred SmartSuggestions    -- see: manual-expense-entry-suggestions.candidate.allium

guidance:
    Smart suggestions use hybrid ranking: recency-weighted frequency.
    Recent entries count more, but frequently used references always surface.

guidance:
    Suggestions should pre-fill payer + category combos based on supplier history.
    e.g., "last time you bought from Bingo you used Cash and categorized as Groceries."

guidance:
    Store inline creation requires supplier context (store belongs to supplier).
    Orphan stores are not allowed.
