-- allium: 2
-- expense-entry.candidate.allium
--
-- Scope: Manual expense entry — Smart Input flow (two-phase) on web AND mobile
-- Includes:
--   - Expense + ExpenseItem creation (shared domain rules)
--   - Desktop Smart Input form surface (modal from dashboard or list page)
--     Phase 1: unified search across entity types, progressive item entry with price data
--     Phase 2: context (supplier/store/category), payer chips, date, currency, notes
--   - Mobile Smart Input form surface (dedicated page from upload tab)
--     Same two-phase structure; diverges on entry point, per-entity autocomplete
--     in Phase 2, payer dropdown, hardcoded currency list, no article_mode,
--     no inline entity creation, no keyboard shortcuts
--   - Unified search endpoint (all | supplier | store | category | article)
--   - Co-occurring article suggestions during item entry (both surfaces)
--   - Context suggestions (history-based) during context phase (both surfaces)
--   - Quick picks (top entities as clickable chips when input is empty; desktop only)
--   - Inline entity creation via type picker (desktop only)
--   - Store→supplier inference, article alias resolution on save
--   - Last-price lookup for articles (supplier-specific preferred, global fallback)
--   - Payer/currency/date defaults, validation rules
-- Excludes:
--   - Receipt upload / OCR / approval flows (separate spec)
--   - Expense editing, deletion, posting after creation
--   - Admin reference-data management
--   - Smart suggestions / hybrid ranking (deferred)
--   - Expense list / dashboard (except entry-point actions)
--   - Currency management & exchange rate fetching (settings-hierarchy.candidate.allium)
--   - Mobile device detection & routing (mobile-web.candidate.allium)
-- Dependencies:
--   - settings-hierarchy.candidate.allium: GlobalSettings, EnabledCurrency, DailyExchangeRate
--   - payer-and-defaults.candidate.allium: UserExpenseDefaults.default_payer,
--     tenant ExpenseCategory.is_default
--   - mobile-web.candidate.allium: device detection, tab navigation (entry point only)
-- Note: Desktop uses a modal; mobile uses a dedicated /m/upload/manual page.
--       A single SmartExpenseDraft entity and a single CreateExpenseFromSmartInput
--       rule serve both surfaces — divergence is UX-only, not domain-level.
-- Supersedes:
--   - quick-add-expense.candidate.allium
--   - manual-expense-entry.candidate.allium (v2)
--   - Previous two-form design (Quick Add + Standard) in this file
--   - MobileManualExpenseEntry rule + ManualExpenseData value in
--     mobile-web.candidate.allium (to be removed in follow-up)

use "./../../domain/expenses/implementation.allium" as impl


-- ─────────────────────────────────────────────
-- External entities
-- ─────────────────────────────────────────────

external entity UUID {}
external entity Date {}

external entity User {
    id: UUID
    tenant_id: UUID
    membership_role: viewer | member | admin | owner
    can_write_expenses: membership_role in {member, admin, owner}
}

external entity Tenant { id: UUID }

external entity Supplier {
    id: UUID
    display_name: String
    normalized_key: String
}

external entity Store {
    id: UUID
    supplier: Supplier
    display_name: String
    normalized_key: String
    city_id: UUID?
}

external entity Article {
    id: UUID
    canonical_name: String
    normalized_key: String
    subcategory_id: UUID?
}

external entity ArticleAlias {
    id: UUID
    supplier: Supplier?
    article: Article?
    raw_label: String
    raw_label_normalized: String
}

external entity ExpenseCategory {
    id: UUID
    tenant_id: UUID
    name: String
}

external entity Payer {
    id: UUID
    tenant_id: UUID
    label: String
    payer_type: PayerType
    is_active: Boolean
    -- Default payer is now per-user via UserExpenseDefaults (see payer-and-defaults.candidate.allium).
    -- is_default: Boolean has been removed.
}

external entity PayerType {
    id: UUID
    tenant_id: UUID
    name: String
    is_system: Boolean
}

external entity Expense {
    id: UUID
    tenant_id: UUID
    user_id: UUID?
    created_by: UUID?
    receipt_id: UUID?
    supplier_id: UUID?
    store_id: UUID?
    payer_id: UUID
    expense_category_id: UUID?
    purchased_at: Timestamp
    total_amount: Decimal
        -- Sum of line items in the expense's currency.
    currency: String
        -- ISO 4217 code. Must be an enabled currency (see EnabledCurrency).
    original_amount: Decimal
        -- Same as total_amount (the amount in the expense's currency).
    bam_amount: Decimal
        -- Equivalent in BAM. Equals original_amount when currency = "BAM".
    exchange_rate: Decimal?
        -- Rate used: 1 unit of currency = exchange_rate BAM.
        -- null when currency = "BAM".
    rate_fetched_at: Timestamp?
        -- When the exchange rate was fetched. null when currency = "BAM".
    notes: String?
}

external entity GlobalSettings {
    -- Singleton, defined in settings-hierarchy.candidate.allium.
    default_currency: String
    default_note: String?
}

external entity EnabledCurrency {
    -- Admin-curated list, defined in settings-hierarchy.candidate.allium.
    code: String
    name: String
    is_base: Boolean
}

external entity DailyExchangeRate {
    -- Daily cached rates, defined in settings-hierarchy.candidate.allium.
    currency_code: String
    rate_date: Date
    rate: Decimal
}

external entity ExpenseItem {
    id: UUID
    tenant_id: UUID
    expense_id: UUID
    alias_id: UUID?
    article_id: UUID?
    raw_label: String?
    qty: Decimal?
    unit_price: Decimal?
    line_total: Decimal
}


-- ─────────────────────────────────────────────
-- Value types
-- ─────────────────────────────────────────────

-- Currency is no longer a hardcoded enum. Users select from the admin-curated
-- EnabledCurrency list (see settings-hierarchy.candidate.allium).
-- References to Currency in this spec use String (ISO 4217 code).

value ItemDraft {
    -- In-form representation. article_id captured when item originates from search.
    article_id: UUID?
    label: String
    qty: Decimal = 1
    unit_price: Decimal?

    requires: label.trim().length >= 1
    requires: qty > 0
    requires: unit_price = null or unit_price >= 0

    -- Derived
    line_total: qty * (unit_price ?? 0)
}

value SubmitItem {
    -- Backend-ready format produced from ItemDraft on submit.
    raw_label: String
    qty: Decimal
    unit_price: Decimal
    line_total: Decimal

    requires: raw_label.trim().length >= 1
    requires: line_total > 0
}

value SearchResult {
    -- Unified result from the quick-add-search endpoint.
    id: UUID
    label: String
    entity_type: supplier | store | category | article
    relevance: Decimal?

    -- Store-specific (for supplier inference)
    supplier_id: UUID?
    supplier_display_name: String?

    -- Article-specific price enrichment
    last_price: Decimal?
    last_price_source: supplier_specific | global | null
    last_price_supplier_display_name: String?
}

value ContextChip {
    -- Selected context reference displayed as a removable chip.
    id: UUID
    label: String

    -- Store chips carry supplier info for inference
    supplier_id: UUID?
    supplier_display_name: String?
}

value ContextSuggestions {
    -- History-based suggestions for Phase 2 context, ranked by co-occurrence frequency.
    suppliers: List<SearchResult>
    stores: List<SearchResult>
    categories: List<SearchResult>
}

-- ─────────────────────────────────────────────
-- Config
-- ─────────────────────────────────────────────

config {
    -- default_currency: removed — now sourced from GlobalSettings.default_currency
    --   (see settings-hierarchy.candidate.allium)
    search_debounce_ms: Integer = 250
    search_min_query_length: Integer = 2
    search_default_limit: Integer = 8
    search_max_limit: Integer = 25
    search_visible_cap: Integer = 10
    cooccurring_default_limit: Integer = 5
    cooccurring_max_limit: Integer = 10
    context_suggestions_default_limit: Integer = 5
    context_suggestions_max_limit: Integer = 10
    payer_chip_limit: Integer = 5
    alias_min_normalized_length: Integer = 2
    fuzzy_similarity_threshold: Decimal = 0.5
    -- When type = all, results sorted by relevance DESC then entity priority:
    search_sort_priority: article > category > store > supplier
}


-- ─────────────────────────────────────────────
-- Actor
-- ─────────────────────────────────────────────

actor ExpenseWriter {
    identified_by: User where can_write_expenses
    within: Tenant
}


-- ═════════════════════════════════════════════
-- SMART EXPENSE DRAFT
-- ═════════════════════════════════════════════

entity SmartExpenseDraft {
    -- Two-phase progressive form: items first, then context + metadata.

    -- ── Phase (state machine) ──
    phase: items | context

    -- ── Phase 1: Items ──
    items: List<ItemDraft>
    article_mode: Boolean = false
        -- After first article selected from search, narrows search to articles only.
        -- Reset when all items removed or when transitioning to context phase.

    -- ── Context (collected in both phases — Phase 1 via search, Phase 2 as primary focus) ──
    supplier: ContextChip?
    store: ContextChip?
    expense_category: ContextChip?

    -- ── Metadata (Phase 2) ──
    payer: Payer?
    purchased_at: Timestamp = now
    currency: String = GlobalSettings.first.default_currency
        -- Pre-selected from GlobalSettings. User can change to any EnabledCurrency.
    notes: String? = GlobalSettings.first.default_note
        -- Pre-filled from GlobalSettings (was per-user, now global).

    -- ── Derived ──
    has_items: items.count > 0
    computed_total: items.sum(i => i.line_total)
    has_any_context: supplier != null or store != null or expense_category != null
    article_ids: map(items where article_id != null, i => i.article_id)

    -- ── Search type narrowing ──
    -- Phase 1 before article_mode: search all types (missing context + article)
    -- Phase 1 in article_mode: search articles only
    -- Phase 2: search only missing context types (no articles)
    missing_context_types: {supplier, store, expense_category}

    -- ── Submission readiness ──
    is_submittable: phase = context
        and has_items
        and computed_total > 0
        and has_any_context
        and payer != null
        and purchased_at != null
}


-- ═════════════════════════════════════════════
-- SHARED DOMAIN RULES
-- ═════════════════════════════════════════════

-- Structural invariant: every expense with a store must also have a supplier.
-- Enforced client-side (store selection infers supplier) and server-side
-- (create-expense! looks up store.supplier_id when supplier_id is nil).

invariant StoreRequiresSupplier {
    for expense in Expense:
        expense.store_id != null implies expense.supplier_id != null
}


-- ─────────────────────────────────────────────
-- Expense creation
-- ─────────────────────────────────────────────

rule CreateExpenseFromSmartInput {
    when: SubmitSmartExpense(writer, draft)

    requires: draft.is_submittable
    requires: exists EnabledCurrency where code = draft.currency
        -- Currency must be in the admin-enabled list.

    -- Store→supplier inference (server-side safety net)
    let final_supplier_id =
        if draft.store != null and draft.supplier = null: Store{id: draft.store.id}.supplier.id
        else: draft.supplier?.id

    -- Prepare submit items from drafts
    let submit_items = for item in draft.items where item.line_total > 0:
        SubmitItem(
            raw_label: item.label,
            qty: item.qty,
            unit_price: item.unit_price ?? 0,
            line_total: item.line_total
        )

    -- Exchange rate resolution (see settings-hierarchy.candidate.allium)
    -- FetchDailyRatesIfMissing fires first if today's rates aren't cached.
    let today = to_date(draft.purchased_at)
    let bam_conversion = if draft.currency = "BAM":
        {bam_amount: draft.computed_total, exchange_rate: null, rate_fetched_at: null}
    else:
        let daily_rate = DailyExchangeRate{currency_code: draft.currency, rate_date: today}
        {
            bam_amount: draft.computed_total * daily_rate.rate,
            exchange_rate: daily_rate.rate,
            rate_fetched_at: daily_rate.fetched_at
        }

    ensures:
        let expense = Expense.created(
            tenant_id: writer.tenant_id,
            user_id: writer.id,
            created_by: writer.id,
            supplier_id: final_supplier_id,
            store_id: draft.store?.id,
            payer_id: draft.payer.id,
            expense_category_id: draft.expense_category?.id,
            purchased_at: draft.purchased_at,
            total_amount: draft.computed_total,
            currency: draft.currency,
            original_amount: draft.computed_total,
            bam_amount: bam_conversion.bam_amount,
            exchange_rate: bam_conversion.exchange_rate,
            rate_fetched_at: bam_conversion.rate_fetched_at,
            notes: draft.notes
        )
        for item in submit_items:
            ExpenseItem.created(
                tenant_id: writer.tenant_id,
                expense_id: expense.id,
                raw_label: item.raw_label,
                qty: item.qty,
                unit_price: item.unit_price,
                line_total: item.line_total
            )

    ensures: ExpenseCreated(expense)

    @guidance
        -- Server validates: payer_id, purchased_at, total_amount required.
        -- Context validation: at least one of supplier, store, category required.
        -- Total is always computed from items; no user-entered override.
        -- Currency conversion: for non-BAM expenses, the daily CBBH rate is
        -- looked up from DailyExchangeRate (fetched lazily on first non-BAM
        -- expense of the day — see FetchDailyRatesIfMissing rule in
        -- settings-hierarchy.candidate.allium). The BAM equivalent is stored
        -- alongside the original amount for report aggregation.
        -- If daily rates are not available and no fallback exists, submission
        -- fails with an error asking the user to try again.
}


-- ─────────────────────────────────────────────
-- Reference validation
-- ─────────────────────────────────────────────

rule ValidateSmartExpenseReferences {
    when: SubmitSmartExpense(writer, draft)

    let payer = Payer{id: draft.payer.id}
    let category = if draft.expense_category != null: ExpenseCategory{id: draft.expense_category.id} else: null
    let supplier = if draft.supplier != null: Supplier{id: draft.supplier.id} else: null
    let store = if draft.store != null: Store{id: draft.store.id} else: null

    -- Payer is tenant-scoped: must belong to the user's tenant
    requires: exists payer
    requires: payer.tenant_id = writer.tenant_id

    -- Category is tenant-scoped
    if draft.expense_category != null:
        requires: exists category
        requires: category.tenant_id = writer.tenant_id

    -- Global catalog entities: verify existence
    if draft.supplier != null:
        requires: exists supplier

    if draft.store != null:
        requires: exists store
        -- Store must belong to selected supplier (enforced by UI but verified)
        requires: draft.supplier != null
        requires: store.supplier.id = draft.supplier.id
}


-- ─────────────────────────────────────────────
-- Alias resolution (shared — fires after any expense creation)
-- ─────────────────────────────────────────────

rule ResolveLineItemAliases {
    when: ExpenseCreated(expense)
    requires: expense.supplier_id != null

    ensures:
        for item in ExpenseItem where expense_id = expense.id and raw_label != null:
            let normalized = normalize(item.raw_label)
            if normalized.length >= config.alias_min_normalized_length:
                let existing = ArticleAlias where supplier.id = expense.supplier_id
                    and raw_label_normalized = normalized
                if existing != null:
                    item.alias_id = existing.id
                    item.article_id = existing.article?.id
                else:
                    let alias = ArticleAlias.created(
                        supplier: Supplier{id: expense.supplier_id},
                        raw_label: item.raw_label,
                        raw_label_normalized: normalized
                    )
                    item.alias_id = alias.id
}

-- allium-ignore allium.deferred.missingLocationHint
deferred normalize    -- label normalization (trim, lowercase, collapse whitespace)


-- ═════════════════════════════════════════════
-- SEARCH & SUGGESTIONS
-- ═════════════════════════════════════════════

-- ─────────────────────────────────────────────
-- Unified search
-- ─────────────────────────────────────────────

rule UnifiedSearch {
    when: SearchSmartExpense(writer: ExpenseWriter, query: String,
                             type: String, supplier_id: UUID?)

    requires: query.trim().length >= config.search_min_query_length
    requires: type in {"all", "supplier", "store", "category", "article"}

    -- When type = "all", search all four entity types and merge.
    -- When type = specific entity, search only that type.
    -- Store search narrows by supplier_id when provided.
    -- Category search scoped to writer's tenant.
    -- Article search is not narrowed by supplier or store.
    -- Results sorted by: relevance DESC, then config.search_sort_priority.
    -- Article results enriched with last_price data.
    -- Capped at config.search_max_limit backend results.

    ensures: SearchResults(results: List<SearchResult>)

    @guidance
        -- Implementation uses two search layers merged on the client:
        -- 1. Local: immediate in-memory matches from pre-loaded entity lists
        -- 2. Backend: pg_trgm word_similarity + ILIKE for fuzzy matching
        -- Results are merged, deduped by id+entity_type, capped at
        -- config.search_visible_cap visible entries in the dropdown.
        -- A "Create [text]" option always appears at the bottom when input
        -- is non-empty, allowing inline entity creation.
}


-- ─────────────────────────────────────────────
-- Co-occurring articles
-- ─────────────────────────────────────────────

rule FetchCoOccurringArticles {
    when: ArticleAddedToItems(writer, article_ids, supplier_id)

    requires: article_ids.count > 0

    -- Find articles that frequently appear on the same expenses as the given article IDs.
    -- Excludes already-selected article_ids.
    -- Enriched with last_price data (supplier-specific preferred, global fallback).
    -- Limited to config.cooccurring_max_limit results.

    ensures: CoOccurringResults(results: List<SearchResult>)

    @guidance
        -- Backend: joins expense_items → expenses to find articles that co-occur.
        -- Results displayed as quick-pick chips labeled "Frequently added together".
        -- Triggered every time an article is added; re-fetched with updated article_ids.
        -- Cleared when all items are removed.
}


-- ─────────────────────────────────────────────
-- Context suggestions (history-based)
-- ─────────────────────────────────────────────

rule FetchContextSuggestions {
    when: ItemsPhaseComplete(writer, article_ids)

    requires: article_ids.count > 0

    -- Find suppliers, stores, and categories historically associated
    -- with the selected articles, ranked by co-occurrence frequency.
    -- Called when transitioning from items phase to context phase.
    -- Limited to config.context_suggestions_max_limit per entity type.

    ensures: ContextSuggestionsReady(suggestions: ContextSuggestions)

    @guidance
        -- Three parallel queries: one each for suppliers, stores, categories.
        -- Each joins through expense_items → article_aliases → expenses → target entity.
        -- Store results include supplier_id and supplier_display_name for automatic
        -- store→supplier inference when the user picks a store suggestion.
        -- Suggestions shown as quick-pick chips in Phase 2, prioritized over
        -- alphabetical fallback from pre-loaded entity lists.
}


-- ═════════════════════════════════════════════
-- SURFACES
-- ═════════════════════════════════════════════

-- ─────────────────────────────────────────────
-- Dashboard entry point
-- ─────────────────────────────────────────────

surface ExpensesDashboard {
    facing viewer: User

    provides:
        OpenSmartExpenseForm(viewer)
            when viewer.can_write_expenses

    @guarantee WriteRoleVisibility
        -- The "Add expense" button is visible only to users with
        -- expense-write capability (member, admin, owner).
        -- Viewers see the dashboard but not the creation action.

    @guarantee FormOpensModal
        -- OpenSmartExpenseForm opens a modal overlay on the dashboard.
        -- The dashboard remains visible behind the modal.
        -- On successful submit, the modal closes and recent expenses refresh.
}


-- ─────────────────────────────────────────────
-- List page entry point
-- ─────────────────────────────────────────────

surface ExpensesListPage {
    facing viewer: User

    provides:
        OpenSmartExpenseForm(viewer)
            when viewer.can_write_expenses

    @guarantee WriteRoleVisibility
        -- The "Add" button is visible only to users with
        -- expense-write capability (member, admin, owner).

    @guarantee FormOpensModal
        -- Opens the same Smart Input form as the dashboard, as a modal.
        -- On successful submit, the modal closes and the list refreshes.
}


-- ─────────────────────────────────────────────
-- Smart Expense Form (two-phase)
-- ─────────────────────────────────────────────

surface SmartExpenseForm {
    facing writer: ExpenseWriter

    context draft: SmartExpenseDraft

    -- ═══ Phase 1: Items ═══

    exposes:
        draft.phase
        draft.items
            when draft.phase = items
        draft.article_mode
            when draft.phase = items
        draft.computed_total
            when draft.phase = items and draft.has_items

    -- Context chips visible in Phase 1 (if user selected context via search)
    exposes:
        draft.supplier
            when draft.phase = items and draft.supplier != null
        draft.store
            when draft.phase = items and draft.store != null
        draft.expense_category
            when draft.phase = items and draft.expense_category != null

    -- Search (active in both phases)
    provides:
        SearchSmartExpense(writer, query: String, type: String, supplier_id: UUID?)

    -- Item management (Phase 1)
    provides:
        SelectArticleItem(draft, result: SearchResult)
            when result.entity_type = article
        RemoveItem(draft, item: ItemDraft)
            when draft.phase = items
        UpdateItemQty(draft, item: ItemDraft, qty: Decimal)
            when draft.phase = items
        UpdateItemPrice(draft, item: ItemDraft, unit_price: Decimal)
            when draft.phase = items
        BackspaceRemoveLastItem(draft)
            when draft.phase = items and draft.has_items

    -- Context via search (available in Phase 1 before article_mode)
    provides:
        SelectContextFromSearch(draft, result: SearchResult)
            when result.entity_type != article
        RemoveContext(draft, entity_type: String)

    -- Transition to Phase 2
    provides:
        FinishItemsPhase(draft)
            when draft.phase = items and draft.has_items

    -- ═══ Phase 2: Context & Metadata ═══

    exposes:
        draft.items
            when draft.phase = context     -- read-only summary
        draft.computed_total
            when draft.phase = context
        draft.supplier
            when draft.phase = context
        draft.store
            when draft.phase = context and draft.supplier != null
        draft.expense_category
            when draft.phase = context
        draft.payer
            when draft.phase = context
        draft.purchased_at
            when draft.phase = context
        draft.currency
            when draft.phase = context
        draft.notes
            when draft.phase = context
        -- Available currencies for the currency dropdown
        for c in EnabledCurrency:
            c.code
            c.name
            when draft.phase = context

    -- Context management (Phase 2)
    provides:
        BackspaceRemoveLastContext(draft)
            when draft.phase = context and draft.has_any_context
        SelectPayer(draft, payer: Payer)
            when draft.phase = context
        SelectCurrency(draft, currency: String)
            when draft.phase = context

    -- Navigation
    provides:
        BackToItemsPhase(draft)
            when draft.phase = context

    -- Inline creation (both phases — via type picker)
    provides:
        CreateInlineEntity(draft, entity_type: String, name: String)

    -- Submit / Cancel
    provides:
        CancelSmartExpense(writer)
        SubmitSmartExpense(writer, draft)
            when draft.is_submittable

    -- ═══ Guarantees ═══

    -- Phase structure
    @guarantee TwoPhaseFlow
        -- The form progresses through two phases:
        -- Phase 1 (Items): user searches and selects articles, building a line-item list.
        --   Each item gets inline qty (default 1) and unit_price (auto-filled from last price).
        --   Non-article search results (supplier, store, category) add to context chips.
        --   Pressing Enter on empty input transitions to Phase 2.
        -- Phase 2 (Context & Metadata): user provides supplier, store, category,
        --   payer, date, currency, notes.
        --   Items are shown as a read-only summary with computed total.
        --   "Back to items" link allows returning to Phase 1.

    @guarantee AdaptiveSearchNarrowing
        -- Phase 1 initial: search returns all entity types (supplier, store,
        --   category, article). User is free to start with any type.
        -- Phase 1 article_mode: after first article selected, search narrows
        --   to articles only — focusing rapid item entry.
        -- Phase 2: search shows only missing context types (those not yet selected).
        --   Articles are excluded from Phase 2 search results.

    @guarantee ArticleMode
        -- After the first article is selected in Phase 1, search narrows to
        -- articles only (article_mode = true). This focuses the entry experience.
        -- Article mode resets when all items are removed or on phase transition.

    -- Defaults
    @guarantee DefaultSelections
        -- Opening the form pre-selects:
        --   payer: from UserExpenseDefaults.default_payer (per-user, sticky)
        --   expense_category: from tenant ExpenseCategory where is_default = true
        --   notes: from GlobalSettings.default_note (global, admin-set)
        --   currency: from GlobalSettings.default_currency (global, admin-set)
        --   purchased_at: today
        -- Expense category prefill is always non-null because tenant
        -- provisioning seeds exactly one default expense category.
        -- Payer selection list shows only active payers (is_active = true).
        -- Currency dropdown shows all EnabledCurrency entries.
        -- (see payer-and-defaults.candidate.allium, settings-hierarchy.candidate.allium)

    @guarantee CategoryFallbackAppliedAtSubmit
        -- If SubmitSmartExpense reaches the backend without an expense category,
        -- expense creation resolves the category using the tenant default.

    -- Search
    @guarantee SearchDebouncing
        -- Search queries are debounced at config.search_debounce_ms
        -- to avoid excessive API calls during typing.

    @guarantee SearchMinQueryLength
        -- Search queries shorter than config.search_min_query_length
        -- return empty results immediately without hitting the server.

    @guarantee FuzzyMatching
        -- All search uses pg_trgm word_similarity with a threshold of
        -- config.fuzzy_similarity_threshold combined with ILIKE substring
        -- matching. This catches common typos and inflection variants.

    @guarantee DualSearchLayer
        -- Search results combine two sources:
        -- 1. Immediate local matches from pre-loaded entity lists (fast, no latency)
        -- 2. Backend fuzzy matches via pg_trgm (comprehensive, slight latency)
        -- Results are merged, deduped, and capped at config.search_visible_cap.

    @guarantee SearchSortPriority
        -- When searching all entity types, results are sorted by relevance DESC,
        -- then by entity type priority: config.search_sort_priority.

    @guarantee ContextConstrainedSearch
        -- Store search narrows by selected supplier (supplier_id param).
        -- Category search scoped to the user's tenant.
        -- Article search is not narrowed by supplier or store.

    -- Price data
    @guarantee ArticlePriceInSearchResults
        -- Article search results include last_price, last_price_source
        -- (supplier_specific or global), and last_price_supplier_display_name
        -- when prior price data exists. This allows the user to see price
        -- context before selecting an article.

    @guarantee ArticlePriceAutofill
        -- When an article is selected, unit_price auto-fills from the
        -- article's last known price. Supplier-specific price (from the
        -- draft's current supplier context) is preferred; falls back to
        -- global price across all suppliers within the tenant.

    -- Co-occurring articles
    @guarantee CoOccurringSuggestions
        -- After each article is added, the system fetches articles that
        -- frequently appear on the same expenses. These are shown as
        -- quick-pick chips labeled "Frequently added together", enabling
        -- rapid entry of commonly co-purchased items.
        -- Cleared when all items are removed.

    -- Context suggestions
    @guarantee HistoryBasedContextSuggestions
        -- When transitioning to Phase 2, the system fetches suppliers,
        -- stores, and categories historically associated with the selected
        -- articles. These appear as quick-pick chips grouped by entity type,
        -- prioritized over alphabetical fallback from pre-loaded entity lists.
        -- Store suggestions include supplier data for automatic inference.

    -- Quick picks
    @guarantee QuickPicks
        -- When the search input is empty and some context types are still
        -- missing, top entities are shown as clickable chips grouped by type.
        -- If a supplier is selected, store picks are filtered to that supplier.
        -- Related records (stores for a supplier, articles for a store) are
        -- fetched to populate picks when context narrows the scope.
        -- Limit: 10 when one type missing, 5 per type when multiple missing.

    -- Payer
    @guarantee PayerChips
        -- In Phase 2, when no payer is selected, available payers are shown
        -- as clickable chips (up to config.payer_chip_limit) for instant selection.

    -- Currency
    @guarantee CurrencyDropdown
        -- In Phase 2, currency is shown as a dropdown populated from
        -- EnabledCurrency. Pre-selected to GlobalSettings.default_currency.
        -- User can change to any enabled currency.
        -- The currency is for the manual expense amount — it does not
        -- affect receipt-originated expenses (always BAM).

    @guarantee CurrencyConversionSilent
        -- When a non-BAM currency is selected, no conversion preview is
        -- shown in the form. The BAM equivalent is calculated silently
        -- on the server at submission time using the daily CBBH rate.
        -- If daily rates fail to fetch and no fallback exists, submission
        -- fails with an error message.

    -- Store→supplier inference
    @guarantee StoreInfersSupplier
        -- Selecting a store automatically fills supplier from that store's
        -- supplier relationship (via supplier_id on the SearchResult/ContextChip).
        -- The draft cannot hold a store whose supplier conflicts with
        -- the selected supplier.

    @guarantee SupplierChangeClearsConflictingStore
        -- Changing supplier clears the store selection when the current
        -- store does not belong to the new supplier.
        -- Removing supplier also removes store.

    @guarantee CategorySelectionIsStable
        -- Once the user chooses an expense category, supplier, store, or
        -- article changes do not auto-change or clear that category.

    -- Line items
    @guarantee LineTotalComputed
        -- Each item's line_total = qty × unit_price. Displayed inline
        -- in the item row. Total is always computed, never user-entered.

    -- Inline creation
    @guarantee InlineCreationViaTypePicker
        -- When search text doesn't match existing entities, a "Create [text]"
        -- option appears at the bottom of the dropdown. Selecting it opens
        -- a type picker: "What is [text]?" with buttons for each available
        -- entity type (filtered to the types the current search is showing).
        -- The entity is created immediately via a dispatch, and on success:
        -- articles are added as items, others are added as context chips.
        -- Store creation requires supplier context.

    -- Keyboard navigation
    @guarantee KeyboardNavigation
        -- ArrowDown/ArrowUp navigate the autocomplete dropdown.
        -- Enter selects the highlighted result, or opens create flow for text.
        -- Enter on empty input in Phase 1 transitions to Phase 2.
        -- Backspace on empty input removes the last item (Phase 1) or
        -- last context chip (Phase 2).
        -- Escape closes the dropdown without selecting.

    -- Validation
    @guarantee AtLeastOneItemRequired
        -- The form requires at least one item with a positive line total.

    @guarantee AtLeastOneContextRequired
        -- At least one of supplier, store, or category must be selected.

    -- Submit outcomes
    @guarantee SuccessfulSubmitOutcome
        -- Successful submit closes the modal and refreshes the parent view
        -- (dashboard recent expenses or list page) so the new expense
        -- appears immediately. The user returns to the parent view.

    @guarantee FailedSubmitOutcome
        -- Validation failures and API errors keep the modal open with an
        -- error message displayed. No data is lost.
}


-- ─────────────────────────────────────────────
-- Mobile upload-tab entry point
-- ─────────────────────────────────────────────

surface MobileUploadTab {
    facing viewer: User

    provides:
        OpenSmartExpenseForm(viewer)
            when viewer.can_write_expenses

    @guarantee WriteRoleVisibility
        -- The "Add Expense Manually" button is visible only to users with
        -- expense-write capability (member, admin, owner).

    @guarantee FormOpensAsPage
        -- OpenSmartExpenseForm navigates to a dedicated page
        -- (/m/upload/manual). It is NOT a modal — the mobile tab shell
        -- remains, with the form filling the content area.
        -- On successful submit, the user is navigated to /m/expenses.
        -- The upload tab also hosts receipt capture and pending review
        -- entry points, which are out of scope here.
}


-- ─────────────────────────────────────────────
-- Smart Expense Form (mobile, two-phase)
-- ─────────────────────────────────────────────

surface MobileSmartExpenseForm {
    facing writer: ExpenseWriter

    context draft: SmartExpenseDraft
        -- Same draft entity as desktop. Same CreateExpenseFromSmartInput
        -- rule fires on submit. Divergence is UX-only.

    -- ═══ Phase 1: Items ═══

    exposes:
        draft.phase
        draft.items
            when draft.phase = items
        draft.computed_total
            when draft.phase = items and draft.has_items

    -- Context and default metadata are visible as removable chips in Phase 1.
    exposes:
        draft.supplier
            when draft.phase = items and draft.supplier != null
        draft.store
            when draft.phase = items and draft.store != null
        draft.expense_category
            when draft.phase = items and draft.expense_category != null
        draft.payer
            when draft.phase = items and draft.payer != null
        draft.purchased_at
            when draft.phase = items
        draft.currency
            when draft.phase = items

    -- Phase 1 unified search (all entity types)
    provides:
        SearchSmartExpense(writer, query: String, type: "all", supplier_id: UUID?)
            when draft.phase = items

    -- Item management
    provides:
        SelectArticleItem(draft, result: SearchResult)
            when draft.phase = items and result.entity_type = article
        RemoveItem(draft, item: ItemDraft)
            when draft.phase = items
        UpdateItemQty(draft, item: ItemDraft, qty: Decimal)
            when draft.phase = items
        UpdateItemPrice(draft, item: ItemDraft, unit_price: Decimal)
            when draft.phase = items

    -- Context selection via Phase 1 search
    provides:
        SelectContextFromSearch(draft, result: SearchResult)
            when draft.phase = items and result.entity_type != article
        RemoveContext(draft, entity_type: String)
            when draft.phase = items

    -- Phase transition
    provides:
        FinishItemsPhase(draft)
            when draft.phase = items and draft.has_items

    -- ═══ Phase 2: Context & Metadata ═══

    exposes:
        draft.items
            when draft.phase = context     -- read-only summary
        draft.computed_total
            when draft.phase = context
        draft.supplier
            when draft.phase = context
        draft.store
            when draft.phase = context and draft.supplier != null
        draft.expense_category
            when draft.phase = context
        draft.payer
            when draft.phase = context
        draft.purchased_at
            when draft.phase = context
        draft.currency
            when draft.phase = context
        draft.notes
            when draft.phase = context

    -- Phase 2 uses THREE per-entity autocomplete fields (not a unified search).
    -- Each field is shown only when its context slot is empty.
    provides:
        SearchSupplier(writer, query: String)
            when draft.phase = context and draft.supplier = null
        SearchStore(writer, query: String, supplier_id: UUID)
            when draft.phase = context
                and draft.store = null
                and draft.supplier != null
        SearchCategory(writer, query: String)
            when draft.phase = context and draft.expense_category = null
        SelectContextFromSearch(draft, result: SearchResult)
            when draft.phase = context and result.entity_type != article
        RemoveContext(draft, entity_type: String)
            when draft.phase = context

    -- Metadata fields
    provides:
        SelectPayer(draft, payer: Payer)
            when draft.phase = context
        SelectCurrency(draft, currency: String)
            when draft.phase = context
        SetPurchasedAt(draft, purchased_at: Timestamp)
            when draft.phase = context
        SetNotes(draft, notes: String)
            when draft.phase = context

    -- Navigation
    provides:
        BackToItemsPhase(draft)
            when draft.phase = context

    -- Submit / Cancel
    provides:
        CancelSmartExpense(writer)
        SubmitSmartExpense(writer, draft)
            when draft.is_submittable

    -- ═══ Guarantees shared with desktop ═══

    @guarantee TwoPhaseFlow
        -- Same phase progression as SmartExpenseForm (items → context).
        -- Items are read-only in Phase 2; "Back" returns to Phase 1.
        -- Difference from desktop: Phase 1 → Phase 2 is an EXPLICIT button
        -- ("Add store"/Next); there is no Enter-on-empty keyboard shortcut.

    @guarantee SearchDebouncing
        -- Phase 1 unified search is debounced at config.search_debounce_ms.

    @guarantee SearchMinQueryLength
        -- Queries shorter than config.search_min_query_length return
        -- empty results without hitting the server.

    @guarantee FuzzyMatching
        -- Shares backend pg_trgm word_similarity + ILIKE matching with
        -- config.fuzzy_similarity_threshold.

    @guarantee ContextConstrainedSearch
        -- Phase 2 store autocomplete narrows by selected supplier_id.
        -- Supplier and category autocomplete are tenant-scoped.

    @guarantee ArticlePriceInSearchResults
        -- Article search results carry last_price data for user context.

    @guarantee ArticlePriceAutofill
        -- Selecting an article auto-fills unit_price from the article's
        -- last known price (supplier-specific preferred, global fallback).

    @guarantee CoOccurringSuggestions
        -- Phase 1 renders "Frequently added together" article pills when
        -- the search input is empty. Re-fetched after each article is added;
        -- cleared when all items are removed.

    @guarantee HistoryBasedContextSuggestions
        -- On entering Phase 2, the system fetches suppliers/stores/categories
        -- historically associated with the selected articles. These appear
        -- as chips above the autocomplete fields. Store suggestions carry
        -- supplier info for automatic store→supplier inference.

    @guarantee DefaultSelections
        -- Defaults match desktop:
        --   payer: from UserExpenseDefaults.default_payer
        --   expense_category: from tenant ExpenseCategory where is_default
        --   notes: from GlobalSettings.default_note
        --   currency: from GlobalSettings.default_currency
        --   purchased_at: today
        -- Mobile exposes all defaults as removable chips in Phase 1 so the
        -- user can clear any of them before continuing to Phase 2.

    @guarantee CategoryFallbackAppliedAtSubmit
        -- Shared: when submit reaches the backend without an expense
        -- category, the tenant default is resolved server-side.

    @guarantee StoreInfersSupplier
        -- Selecting a store fills supplier from the store's relationship.

    @guarantee SupplierChangeClearsConflictingStore
        -- Removing supplier also removes store; changing supplier clears
        -- stores that don't belong to the new supplier.

    @guarantee LineTotalComputed
        -- Each item's line_total = qty × unit_price. Total is always
        -- computed, never user-entered.

    @guarantee AtLeastOneItemRequired
        -- The form requires at least one item with a positive line total.

    @guarantee AtLeastOneContextRequired
        -- At least one of supplier, store, or category must be selected.

    @guarantee SuccessfulSubmitOutcome
        -- Successful submit navigates to /m/expenses. The new expense
        -- appears in the list on next load.

    @guarantee FailedSubmitOutcome
        -- Validation failures and API errors keep the user on the form
        -- with an inline error banner. No data is lost.

    -- ═══ Mobile-specific divergences ═══

    @guarantee DedicatedPageNotModal
        -- The form renders as a full page within the mobile tab shell
        -- (route /m/upload/manual), not as a modal overlay.
        -- Back navigation uses the mobile header back button.

    @guarantee Phase2UsesPerEntityAutocomplete
        -- Unlike desktop's unified search in Phase 2, mobile Phase 2
        -- renders three SEPARATE autocomplete fields — one each for
        -- supplier, store and category — visible only while the matching
        -- context slot is empty. This replaces the unified
        -- missing_context_types search model used on desktop.

    @guarantee PayerIsDropdownNotChips
        -- Phase 2 payer selection uses a native <select> listing all active
        -- payers. The config.payer_chip_limit quick-chip UI from desktop
        -- does NOT apply on mobile.

    @guarantee CurrencyDropdownUsesFixedList
        -- Mobile currency dropdown is populated from a hardcoded list
        -- ["BAM", "EUR", "USD", "GBP", "CHF", "HRK", "RSD"], NOT from
        -- EnabledCurrency. This diverges from desktop and from the
        -- settings-hierarchy spec. KNOWN DRIFT — tracked for reconciliation.

    @guarantee NoInlineEntityCreation
        -- Mobile Phase 1 does not offer a "Create [text]" option at the
        -- bottom of search dropdowns. Store creation is reachable via a
        -- separate /m/entity-add/store page outside this surface; other
        -- entity types cannot be created from within the form.

    @guarantee NoArticleMode
        -- Mobile does not narrow Phase 1 search to articles-only after the
        -- first article is selected. Search remains unified across all
        -- entity types for the duration of Phase 1. The draft.article_mode
        -- field is unused on mobile.

    @guarantee NoKeyboardShortcuts
        -- Mobile is touch-only. None of the following apply:
        -- ArrowUp/ArrowDown dropdown navigation, Enter-to-select,
        -- Enter-on-empty phase transition, Backspace-remove-last,
        -- Escape-to-close.

    @guarantee NoCrossTypeQuickPickGrid
        -- Mobile Phase 1 shows history-based quick picks only for articles
        -- and categories when search is empty. It does NOT render the
        -- desktop grid of top suppliers/stores/articles/categories together.
        -- Context suggestions (Phase 2) are still shown as chips.
}


-- ═════════════════════════════════════════════
-- DEFERRED
-- ═════════════════════════════════════════════

-- allium-ignore allium.deferred.missingLocationHint
deferred SmartSuggestions    -- see: manual-expense-entry-suggestions.candidate.allium

-- Guidance:
-- Smart suggestions use hybrid ranking: recency-weighted frequency.
-- Recent entries count more, but frequently used references always surface.

-- Guidance:
-- Suggestions should pre-fill payer + category combos based on supplier history.
-- e.g., "last time you bought from Bingo you used Cash and categorized as Groceries."

-- Guidance:
-- Store inline creation requires supplier context (store belongs to supplier).
-- Orphan stores are not allowed.


-- ═════════════════════════════════════════════
-- OPEN QUESTIONS
-- ═════════════════════════════════════════════

open question "Should the form support a total-override mode where the user can enter a total that differs from the computed sum of items?"

open question "Should total-only expenses (no items, no article) be supported, or should every expense require at least one line item?"

open question "Should Phase 1 allow selecting a supplier early to constrain article search by supplier-specific pricing, even before article_mode kicks in?"
