-- allium: 3

-- Sorting on canonical list pages (list-view control)
--
-- Distilled from shared list-view behavior across canonical expenses pages:
-- - Reference-data pages (admin + user) run in client mode (fetch-many + local sorting)
-- - Transactional user pages (receipts, expenses) run in server mode (refresh + backend sorting)
--
-- Covers: sort-state toggle, page reset, client/server mode split,
-- config-driven sortable-column restriction, and allowlist-driven backend ORDER BY.
-- Does NOT cover: filtering, pagination page size selection, or column visibility.

use "../shared/infrastructure.allium" as infra

external entity EntityType { name: String }
external entity ColumnId { name: String }

value SortConfig {
    field: ColumnId
    direction: asc | desc
}

config {
    max_active_sorts: Integer = 3
}

-- Declares which columns may be sorted for a given entity type.
-- Loaded asynchronously from /admin/api/settings/table-columns at app init.
-- An empty columns set means all columns are sortable (open access).
entity SortableColumnsConfig {
    entity_type: EntityType
    columns: Set<ColumnId>

    is_open: columns.count = 0
}

-- Per-entity list state relevant to sorting.
-- Lives in frontend session state; resets on full page reload.
entity ListViewState {
    entity_type: EntityType
    sorts: List<SortConfig>             -- empty = list uses backend default order
    current_page: Integer
    pagination_mode: client | server

    is_sorted: sorts.count > 0
    column_config: SortableColumnsConfig with entity_type = this.entity_type
}

-- Clicking a sortable column header without Shift replaces the active sort stack
-- with a single primary sort entry.
--
-- Toggle logic for the primary sort: same field + current direction asc → desc.
-- All other cases (new field, or current direction desc) → asc.
--
-- Always resets the list to page 1.
-- In server mode, emits ServerSortRefetch so the backend reloads the list.
rule PrimarySortFieldSelected {
    when: UserClicksColumnHeader(list, column_id)
    requires: list.column_config.is_open or column_id in list.column_config.columns
    ensures: list.sorts = replace_primary_sort(list.sorts, column_id)
    ensures: list.current_page = 1
    ensures:
        if list.pagination_mode = server:
            ServerSortRefetch(list)
        else:
            ClientRowsSorted(list)
}

-- Shift-click appends a new sort or toggles an existing sort entry in place.
-- When a new entry would exceed config.max_active_sorts, the lowest-priority
-- entry is dropped before appending the new one.
rule AdditionalSortFieldSelected {
    when: UserShiftClicksColumnHeader(list, column_id)
    requires: list.column_config.is_open or column_id in list.column_config.columns
    ensures: list.sorts = append_or_toggle_sort(list.sorts, column_id, config.max_active_sorts)
    ensures: list.current_page = 1
    ensures:
        if list.pagination_mode = server:
            ServerSortRefetch(list)
        else:
            ClientRowsSorted(list)
}

rule SortFieldRemoved {
    when: RemoveSortField(list, column_id)
    ensures: list.sorts = remove_sort_field(list.sorts, column_id)
    ensures: list.current_page = 1
    ensures:
        if list.pagination_mode = server:
            ServerSortRefetch(list)
        else:
            ClientRowsSorted(list)
}

rule SortFieldMovedLeft {
    when: MoveSortFieldLeft(list, column_id)
    ensures: list.sorts = move_sort_field(list.sorts, column_id, -1)
    ensures: list.current_page = 1
    ensures:
        if list.pagination_mode = server:
            ServerSortRefetch(list)
        else:
            ClientRowsSorted(list)
}

rule SortFieldMovedRight {
    when: MoveSortFieldRight(list, column_id)
    ensures: list.sorts = move_sort_field(list.sorts, column_id, 1)
    ensures: list.current_page = 1
    ensures:
        if list.pagination_mode = server:
            ServerSortRefetch(list)
        else:
            ClientRowsSorted(list)
}

rule AllSortsCleared {
    when: ClearSorts(list)
    ensures: list.sorts = clear_sorts()
    ensures: list.current_page = 1
    ensures:
        if list.pagination_mode = server:
            ServerSortRefetch(list)
        else:
            ClientRowsSorted(list)
}
-- Canonical list-view behavior:
-- - Each active sort field is an app keyword (kebab-case, no namespace).
-- - Server-backed refreshes send the ordered sort stack as
--   `sort=<field>:<dir>,<field2>:<dir>`.
-- - The backend normalizes each sort field into an app keyword (`ensure-app-keyword`)
--   and normalizes directions into :asc|:desc with a per-entity default.
-- - ORDER BY is allowlisted per entity: app-keyword -> SQL identifier/expression.
--   Unknown fields fall back to the entity default sort.
-- - A stable tie-breaker is applied (typically primary key ascending).
--
-- Special case: for receipts, `:status` sorts by the effective-status computed SQL expression.
-- Client mode does not call backend refetch for sorting.
-- allium-ignore allium.deferred.missingLocationHint
deferred ServerSortRefetch    -- dispatched per entity type; handler registered by the domain
-- allium-ignore allium.deferred.missingLocationHint
deferred ClientRowsSorted

surface ListTableHeader {
    facing viewer: User

    context list: ListViewState

    exposes:
        list.sorts
        list.column_config.is_open
        list.column_config.columns

    provides:
        UserClicksColumnHeader(list, column_id)
            when viewer = viewer and (list.column_config.is_open or column_id in list.column_config.columns)
        UserShiftClicksColumnHeader(list, column_id)
            when viewer = viewer and (list.column_config.is_open or column_id in list.column_config.columns)
        RemoveSortField(list, column_id)
        MoveSortFieldLeft(list, column_id)
        MoveSortFieldRight(list, column_id)
        ClearSorts(list)

    @guarantee SortedFieldsRespectConfiguredSortableColumns
        -- When list.is_sorted, every active sort field is either allowed by an open configuration
        -- or is included in list.column_config.columns.

    @guarantee PrimaryClickReplacesSortStack
        -- Clicking a sortable header without Shift replaces the active sort stack with a single
        -- primary sort entry and toggles the same field between ascending and descending.

    @guarantee ShiftClickAccumulatesAdditionalSortsUpToConfiguredLimit
        -- Shift-click appends a new sort entry or toggles an existing one in place.
        -- The active sort stack is capped at config.max_active_sorts entries.

    @guarantee SortChipControlsExposePriorityOrderAndReordering
        -- When more than one sort is active, the UI exposes prioritized sort chips with controls
        -- to move a sort left/right, remove an individual sort, and clear all sorts.

    @guarantee ServerModeSortingTriggersRefetch
        -- In server pagination mode, clicking a sortable header results in ServerSortRefetch(list).

    @guarantee ServerModeSortingUsesCanonicalSortQueryParam
        -- Server-backed list refreshes serialize the ordered sort stack as the canonical
        -- `sort=field:dir,field2:dir` query param.
        -- Backends may remain tolerant of legacy `order-by` / `order-dir` primary-sort params.

    @guarantee ClientModeSortingStaysLocal
        -- In client pagination mode, clicking sortable headers or sort-chip controls results in
        -- ClientRowsSorted(list) without a backend refetch.
}

open question "Should sort state persist across page refresh (e.g. stored in localStorage alongside column-visibility and per-page prefs)?"
open question "Articles: category/subcategory sorting is currently disabled in `:sortable-columns`. Re-enable only if the backend supports a safe allowlist + stable ordering for those fields."

-- allium-ignore allium.deferred.missingLocationHint
deferred replace_primary_sort
-- allium-ignore allium.deferred.missingLocationHint
deferred append_or_toggle_sort
-- allium-ignore allium.deferred.missingLocationHint
deferred remove_sort_field
-- allium-ignore allium.deferred.missingLocationHint
deferred move_sort_field
-- allium-ignore allium.deferred.missingLocationHint
deferred clear_sorts
