-- allium: 1
-- Filtering on canonical list pages (list-view component)
--
-- Distilled from the shared template list-view filtering flow and the canonical
-- expenses list pages that mount list-view.
--
-- Covers:
-- - Filter apply/clear semantics
-- - Per-entity filter state and field-level filterability toggles
-- - Client-mode (local) filtering behavior
-- - Mode-agnostic page reset on filter change (see list-filter-pagination-reset.allium)
-- - Server-mode refresh dispatch behavior
-- - Shared server query-param forwarding contract (see ../shared/list-filter-query-param-forwarding.allium)
-- - Canonical page mode split (reference-data = client, transactional = server)
--
-- Does NOT cover:
-- - Sorting semantics (see list-view-sort.candidate.allium)
-- - Column visibility and table width controls
-- - Domain-specific backend query implementation details

-- Reference-data entities use client-side pagination (small, static datasets).
-- Transactional entities (receipts, expenses) use server-side pagination.
value EntityDataProfile {
    kind: reference_data | transactional

    -- reference_data: categories, cities, countries, manufacturers, subcategories,
    --                 payers, payer_types, expense_categories
    -- transactional:  receipts, expenses, suppliers, stores, articles, aliases
}

entity CanonicalListPage {
    entity_type: EntityType
    route_scope: admin | user
    data_profile: EntityDataProfile
    list: ListViewFilterState with entity_type = this.entity_type

    is_admin: route_scope = admin
    is_user: route_scope = user
    is_reference_data: data_profile.kind = reference_data
}

entity FieldFilterability {
    entity_type: EntityType
    field_id: ColumnId
    allowed_by_config: Boolean
    enabled_by_user: Boolean
    locked: Boolean

    interactive: allowed_by_config and enabled_by_user and not locked
}

entity ListViewFilterState {
    entity_type: EntityType
    pagination_mode: client | server
    current_page: Integer
    show_filtering: Boolean
    active_filters: Set<ColumnFilter>
    active_inline_field: ColumnId?
    modal_open: Boolean
    refresh_event_registered: Boolean

    has_filters: active_filters.count > 0
}

entity ColumnFilter {
    entity_type: EntityType
    field_id: ColumnId
    kind: TextFilter | NumberRangeFilter | DateRangeFilter | SelectFilter
}

variant TextFilter : ColumnFilter {
    query: String
}

variant NumberRangeFilter : ColumnFilter {
    min: Decimal?
    max: Decimal?
}

variant DateRangeFilter : ColumnFilter {
    from: Timestamp?
    to: Timestamp?
}

variant SelectFilter : ColumnFilter {
    selected_values: Set<String>
    selected_labels: Set<String>
}

rule CanonicalPageFilterModeConfigured {
    -- Pagination mode is determined by data profile, not route scope.
    -- Reference-data entities (categories, cities, etc.) always use client mode
    -- in both admin and user pages — datasets are small and static.
    -- Transactional entities (receipts, expenses) use server mode in user pages.
    when: page: CanonicalListPage.created

    ensures:
        if page.is_reference_data:
            page.list.pagination_mode = client
    ensures:
        if not page.is_reference_data and page.is_admin:
            page.list.pagination_mode = client
    ensures:
        if not page.is_reference_data and page.is_user:
            page.list.pagination_mode = server
    ensures:
        if page.list.pagination_mode = server:
            page.list.refresh_event_registered = true
}

rule InlineFilterOpenedFromHeader {
    when: UserClicksColumnFilterIcon(list, field)
    requires: list.show_filtering
    requires: field.interactive
    requires: list.active_inline_field != field.field_id
    ensures: list.active_inline_field = field.field_id
}

rule InlineFilterClosedWhenSameHeaderClicked {
    when: UserClicksColumnFilterIcon(list, field)
    requires: list.show_filtering
    requires: field.interactive
    requires: list.active_inline_field = field.field_id
    ensures: list.active_inline_field = null
}

rule FilterApplied {
    when: UserAppliesFilter(list, field_id, raw_value, keep_open)
    requires: field_id != null

    ensures: NormalizeAndStoreFilter(list, field_id, raw_value)

    -- Page reset is mode-agnostic: applies to both client and server pagination.
    -- Only fires when the filter value actually changed (one-shot guard).
    -- See list-filter-pagination-reset.allium for the full specification.
    ensures: list.current_page = 1
    ensures:
        if list.pagination_mode = server and list.refresh_event_registered:
            ServerFilterRefetch(list)

    ensures:
        if not keep_open:
            list.modal_open = false
}

rule FilterCleared {
    when: UserClearsFilter(list, field_id)

    ensures:
        if field_id != null:
            RemoveFilter(list, field_id)
    ensures:
        if field_id = null:
            ClearAllFilters(list)

    -- Mode-agnostic page reset, same as FilterApplied.
    ensures: list.current_page = 1
    ensures:
        if list.pagination_mode = server and list.refresh_event_registered:
            ServerFilterRefetch(list)
}

rule FieldFilterabilityToggled {
    when: UserTogglesFieldFiltering(list, field)
    requires: not field.locked

    ensures: field.enabled_by_user = not field.enabled_by_user
}

rule ClientFilteringEvaluatesInMemoryRows {
    when: ListRowsRequested(list)
    requires: list.pagination_mode = client

    ensures: ClientRowsFiltered(list)
}

rule ServerFilteringDelegatesToEntityRefresh {
    when: ListRowsRequested(list)
    requires: list.pagination_mode = server
    requires: list.refresh_event_registered

    ensures: ServerFilterRefetch(list)
}

rule ClientModeRefreshRequestIsPageOwned {
    -- Client-mode canonical pages keep ownership of their refresh request shape.
    -- They are not required to ignore current list state just because the list
    -- happens to paginate/filter locally after fetch.
    when: RefreshListTriggered(list)
    requires: list.pagination_mode = client

    ensures: ClientModeRefreshRequestBuilt(list)

    @guidance
        -- In the user-expenses stack, categories/cities/manufacturers/
        -- subcategories/expense-categories and the canonical power-list pages
        -- derive refresh params from current template list state even when their
        -- page still behaves as a client-mode list-view after fetch.
        -- Historical fixed-bulk-fetch behavior remains page-specific: lookup lists
        -- such as payers/payer-types may still use {:limit N :offset 0} outside
        -- server mode, then switch to list-state params if explicitly configured
        -- for server pagination.
}

deferred NormalizeAndStoreFilter
deferred RemoveFilter
deferred ClearAllFilters
deferred ClientRowsFiltered
deferred ServerFilterRefetch
deferred ClientModeRefreshRequestBuilt    -- see: src/app/domain/frontend/expenses/events/user_expenses/list_support.cljs and entity-specific refresh handlers

surface CanonicalListFilterControls {
    facing viewer: User

    context list: ListViewFilterState

    exposes:
        list.show_filtering
        list.active_inline_field
        list.active_filters
        list.current_page
        list.pagination_mode

    provides:
        UserClicksColumnFilterIcon(list, field)
        UserAppliesFilter(list, field_id, raw_value, keep_open)
        UserClearsFilter(list, field_id)
        UserTogglesFieldFiltering(list, field)

    @guarantee CompactFilterChips
        -- When `list.has_filters` and `list.active_inline_field = null`, compact active-filter chips are shown.

    @guarantee PageResetOnFilterChange
        -- Filter apply/clear resets `list.current_page` to `1` regardless of pagination mode
        -- (one-shot, only on actual value change). Server mode additionally dispatches a refresh.

    @guarantee ClientFilteringUsesAndSemantics
        -- Client mode evaluates filters locally with AND semantics across active filters.

    @guarantee FilterKindsMatchCanonicalSemantics
        -- Text filtering matches case-insensitive substrings; number/date ranges are
        -- inclusive; select filters match selected values.
}

open question "Should transactional admin pages move from fetch-many + client filtering to server filtering for very large datasets? (Reference-data pages are intentionally client-mode.)"
open question "Text filters currently auto-apply at 3+ chars in the inline UI, but direct state writes can still apply shorter strings. Should this be enforced uniformly?"
