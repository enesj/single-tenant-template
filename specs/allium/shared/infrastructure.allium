-- allium: 3

-- Shared infrastructure contracts.
--
-- Covers: get-server-port fail-fast (no default port fallback);
--         sanitize-for-serialization platform-boundary type conversion.
--
-- Source: src/app/shared/data.cljc

entity ServiceContainerConfig {
    webserver_port: Integer?
}

surface ServiceContainerPortBoundary {
    context config: ServiceContainerConfig

    provides:
        GetServerPort(service_container)
            when config = config

    @guarantee ReturnsConfiguredPortWhenPresent
        -- GetServerPort(service_container) returns config.webserver_port when present.

    @guarantee FailsFastWhenPortMissing
        -- GetServerPort(service_container) throws when config.webserver_port is absent.
        -- No default port fallback exists.

    @guidance
        -- The fail-fast contract is intentional: a missing :webserver :port is a configuration
        -- error that must surface immediately at startup, not silently resolve to a stale
        -- default (previously 8080).
}

surface SerializationSanitizationBoundary {
    provides:
        SanitizeForSerialization(obj)

    @guarantee SanitizesJvmPlatformTypes
        -- SanitizeForSerialization(obj) converts platform-specific JVM types to their
        -- string representation. Covered types: UUID, all java.time.* date/time types
        -- (LocalDateTime, ZonedDateTime, OffsetDateTime, Instant, LocalDate, LocalTime),
        -- java.sql.* types (Timestamp, Date, Time), BigDecimal, BigInteger, and
        -- unrecognized java.* objects.

    @guarantee SanitizesClojureScriptPlatformTypes
        -- SanitizeForSerialization(obj) on ClojureScript converts js/Date objects to
        -- ISO 8601 strings and UUID values to their string representation.

    @guarantee AppliesRecursivelyThroughNestedData
        -- SanitizeForSerialization(obj) is applied recursively via postwalk to all
        -- nested data structures.

    @guarantee LeavesPrimitiveAndCollectionShapesIntact
        -- Primitive types (string, number, boolean, keyword, symbol, nil) and
        -- collection structures (maps, vectors, sets, lists) pass through unchanged.

    @guidance
        -- This is the canonical pre-serialization sanitizer for session cookies and
        -- JSON responses containing mixed JVM/platform types. It should be applied at
        -- serialization boundaries, not deep inside domain logic.
}
