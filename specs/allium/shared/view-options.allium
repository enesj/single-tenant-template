-- allium: 3

-- Shared view-options configuration schema.
--
-- Covers: DisplayTogglesMap as single source of truth for display toggle keys;
--         display-defaults / display-locks resolution semantics;
--         show-selected-rows? and show-unselected-rows? additions;
--         list-config behavior formerly passed as page props.
--
-- Source: src/app/shared/specs/view_options.cljc
-- Consumers: admin view-options.edn, domain view-options.edn, template user view-options.edn

use "./infrastructure.allium" as infra

entity DisplayTogglesMap {
    show_timestamps: Boolean?
    show_edit: Boolean?
    show_delete: Boolean?
    show_highlights: Boolean?
    show_select: Boolean?
    show_filtering: Boolean?
    show_pagination: Boolean?
    show_add_button: Boolean?
    show_batch_edit: Boolean?
    show_batch_delete: Boolean?
    show_selected_rows: Boolean?
    show_unselected_rows: Boolean?
    per_page: Integer?                -- bounded [1, 1000]
}

value ListConfig {
    form_display: inline | modal
    disallowed_action_mode: hide | disable
    action_gates: Map<String, ActionGateId>?
}

value ActionGateId {
    kind: expenses_can_write
       | expenses_power_user
       | expenses_access
       | expenses_expense_write
       | expenses_expense_delete
       | expenses_expense_items_manage
       | expenses_reference_write
       | expenses_unmapped_access
       | expenses_articles_manage
       | expenses_manufacturers_manage
       | expenses_categories_manage
       | expenses_expense_categories_manage
       | expenses_cities_manage
       | expenses_subcategories_manage
       | expenses_stores_manage
       | expenses_store_aliases_manage
       | expenses_supplier_aliases_manage
       | expenses_danger_execute
       | expenses_settings_write
       | expenses_upload
       | expenses_reports_export
       | expenses_receipts_approve
}

entity EntityViewOptions {
    -- Explicit schema (preferred)
    display_defaults: DisplayTogglesMap?
    display_locks: DisplayTogglesMap?

    -- Declarative list behavior
    list_config: ListConfig?

    -- Column visibility policy
    column_defaults: Map<String, Boolean>?
    column_locks: Map<String, Boolean>?

    -- Legacy flat toggles (treated as locks when present)
    show_timestamps: Boolean?
    show_edit: Boolean?
    show_delete: Boolean?
    show_highlights: Boolean?
    show_select: Boolean?
    show_filtering: Boolean?
    show_pagination: Boolean?
    show_add_button: Boolean?
    show_batch_edit: Boolean?
    show_batch_delete: Boolean?
    show_selected_rows: Boolean?
    show_unselected_rows: Boolean?

    -- Non-display options
    search_fields: List<String>?
    filters: Map<String, FilterConfig>?
    export_formats: List<String>?
    bulk_actions: List<String>?
    pagination: PaginationConfig?
    default_sort: SortConfig?
    per_page: Integer?
}

external entity FilterConfig { type: String, options: List<String>? }
external entity PaginationConfig { default_page_size: Integer?, available_page_sizes: List<Integer>? }
external entity SortConfig { field: String, direction: asc | desc }

surface DisplayTogglesSchemaBoundary {
    provides:
        ValidateDisplayTogglesMap(data)
        ValidateAdminEntityDisplaySettings(data)

    @guarantee DisplayTogglesMapIsAuthoritative
        -- DisplayTogglesMap is the single authoritative list of display toggle keys.
        -- AdminDisplaySettings in specs/entities delegates directly to DisplayTogglesMap
        -- without re-declaring any toggle key.

    @guarantee IncludesSelectedRowsVisibilityToggles
        -- DisplayTogglesMap includes show_selected_rows and show_unselected_rows
        -- as optional booleans.

    @guarantee PerPageRemainsBounded
        -- per_page in DisplayTogglesMap is bounded to [1, 1000] when present.

    @guidance
        -- DRY consolidation is intentional: adding a new toggle key requires one change
        -- in DisplayTogglesMap; both admin entities.edn and view-options.edn validation
        -- inherit the change automatically.
}

surface ViewOptionsResolutionBoundary {
    context config: EntityViewOptions

    provides:
        ResolveEffectiveToggles(entity, user_overrides)
            when config = config
        ResolveListConfig(entity)
        ValidateViewOptionsConfig(data)

    @guarantee DisplayLocksCannotBeOverridden
        -- display_locks keys are not overridable by user preferences.

    @guarantee DisplayDefaultsMayBeOverridden
        -- display_defaults keys may be overridden by user preferences.

    @guarantee LegacyFlatTogglesBehaveAsLocks
        -- Legacy flat show-*? keys at entity top-level are treated as locks
        -- (semantically equivalent to display_locks), not defaults.

    @guarantee RejectsNestedDisplayLocks
        -- ValidateViewOptionsConfig(data) rejects display_locks nested inside
        -- display_defaults as a misconfiguration.

    @guarantee ListConfigIsNotBrowserOverridden
        -- list_config is view-options-owned configuration. It is not overridden by
        -- browser-local display preferences.

    @guarantee ActionGatesOnlyRestrictBehavior
        -- action_gates only further restrict runtime behavior. They never widen an
        -- action or selection capability beyond the configured display policy.

    @guarantee ActionGatesUseValidatedVocabulary
        -- action_gates are chosen from a fixed, validated vocabulary rather than
        -- free-form expressions.

    @guidance
        -- New configurations should prefer the explicit display-defaults / display-locks
        -- form over legacy flat top-level toggles.
}

rule DisplayLocksNestingIsRejected {
    when: ViewOptionsFileValidated(data)

    requires: has_nested_display_locks(data)

    ensures: ValidationFailed(reason: display_locks_nested_in_display_defaults,
                              fix: "Move :display-locks to sibling of :display-defaults")
}
