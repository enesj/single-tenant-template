-- allium: 2
-- workspace-dashboard.candidate.allium

-- Scope: Tenant workspace dashboard — the landing page for authenticated tenant users
-- Includes: Summary statistics, top-entity rankings, price-change insights,
--           spending averages, team overview, navigation shortcuts
-- Excludes:
--   - Admin dashboard (separate page at /admin/dashboard)
--   - Chart/graph rendering details (implementation choice)
--   - Authentication flow (handled before dashboard loads)
--   - Expense CRUD (separate specs)
-- Dependencies: Expense, Supplier, Store, Article, ExpenseItem, Tenant, TenantMembership

use "./implementation.allium" as impl

------------------------------------------------------------
-- External Entities
------------------------------------------------------------

external entity Supplier {
    id: String
    display_name: String
}

external entity Store {
    id: String
    name: String
}

external entity Tenant {
    id: String
}

------------------------------------------------------------
-- Value Types
------------------------------------------------------------

value PeriodSummary {
    expense_count: Integer
    total_spend_bam: Decimal
    comparison_percent: Decimal?
    comparison_direction: up | down | flat
    inline_average: Decimal
    average_label: daily | weekly
}

-- A ranked entity appearing in a "Top 3" widget
value RankedEntity {
    rank: Integer                    -- 1, 2, or 3
    name: String
    total_spend_bam: Decimal
    expense_count: Integer
}

value RankedArticle {
    rank: Integer
    name: String
    purchase_count: Integer
    avg_unit_price: Decimal
    currency: String                 -- primary currency for the price display
}

value PriceChange {
    article_name: String
    previous_avg_price: Decimal
    current_avg_price: Decimal
    change_percent: Decimal          -- positive = increase, negative = decrease
    direction: up | down
    currency: String
}

value CategoryShare {
    category_name: String
    total_spend_bam: Decimal
    expense_count: Integer
    percentage: Decimal               -- share of total spend in the period
}

value MonthlySpend {
    month_label: String              -- e.g. "Mar", "Feb"
    month_index: Integer             -- 0 = current month, 5 = oldest
    total_bam: Decimal
    expense_count: Integer
}

value BiggestExpense {
    total_amount: Decimal
    currency: String
    bam_amount: Decimal
    supplier_name: String?
    store_name: String?
    purchased_at: Timestamp
}

value SpendingAverages {
    daily_avg_30d: Decimal
    weekly_avg_30d: Decimal
    monthly_avg_6m: Decimal
}

value TeamOverview {
    total_members: Integer
    role_breakdown: List<RoleCount>
    tenant_name: String
}

value RoleCount {
    role: owner | admin | member | viewer
    count: Integer
}

------------------------------------------------------------
-- Entities
------------------------------------------------------------

entity DashboardState {
    tenant: Tenant
    viewer_role: owner | admin | member | viewer

    -- Summary cards
    last_30_days: PeriodSummary
    last_6_months: PeriodSummary
    monthly_trend: List<MonthlySpend>       -- 6 entries, one per month

    -- Top rankings
    top_suppliers: List<RankedEntity>       -- max 3, by total spend
    top_stores: List<RankedEntity>          -- max 3, by total spend
    top_articles: List<RankedArticle>       -- max 3, by purchase count

    -- Insights
    price_changes: List<PriceChange>        -- max 3, by absolute change_percent
    category_breakdown: List<CategoryShare> -- all categories with expenses in period
    biggest_expense: BiggestExpense?         -- largest single expense this month
    averages: SpendingAverages

    -- Team & operational
    team: TeamOverview
    unmapped_alias_count: Integer?          -- admin/owner only: aliases with article_id = null

    -- Derived
    has_data: last_30_days.expense_count > 0 or last_6_months.expense_count > 0
    is_power_user: viewer_role in {owner, admin}
}

------------------------------------------------------------
-- Config
------------------------------------------------------------

config {
    -- Period boundaries
    short_period_days: Integer = 30
    long_period_months: Integer = 6
    price_comparison_recent_days: Integer = 30
    price_comparison_baseline_days: Integer = 90

    -- Ranking limits
    top_n: Integer = 3

    -- Minimum data thresholds
    min_observations_for_price_change: Integer = 2
}

------------------------------------------------------------
-- Rules
------------------------------------------------------------

-- Summary card computation

rule ComputeShortPeriodSummary {
    when: DashboardLoaded(tenant)

    -- Current window: last 30 days of tenant expenses
    -- Previous window: 30 days before that (for comparison)

    ensures: last_30_days = PeriodSummary(
        expense_count: count of Expenses
            where tenant_id = tenant.id
            and purchased_at >= now - config.short_period_days.days,
        total_spend_bam: sum of bam_amount from those Expenses,
        comparison_percent: percent_change(
            current: total_spend_bam,
            previous: sum of bam_amount from Expenses
                where tenant_id = tenant.id
                and purchased_at >= now - (config.short_period_days * 2).days
                and purchased_at < now - config.short_period_days.days
        ),
        inline_average: total_spend_bam / config.short_period_days,
        average_label: daily
    )
}

rule ComputeLongPeriodSummary {
    when: DashboardLoaded(tenant)

    ensures: last_6_months = PeriodSummary(
        expense_count: count of Expenses
            where tenant_id = tenant.id
            and purchased_at >= now - config.long_period_months.months,
        total_spend_bam: sum of bam_amount from those Expenses,
        comparison_percent: percent_change(
            current: total_spend_bam,
            previous: sum of bam_amount from Expenses
                where tenant_id = tenant.id
                and purchased_at >= now - (config.long_period_months * 2).months
                and purchased_at < now - config.long_period_months.months
        ),
        inline_average: total_spend_bam / weeks_in(config.long_period_months.months),
        average_label: weekly
    )
}

-- Top-entity ranking

rule ComputeTopSuppliers {
    when: DashboardLoaded(tenant)

    -- Rank suppliers by total bam_amount across tenant expenses in the last 6 months

    ensures: top_suppliers = top(config.top_n,
        Expenses
            where tenant_id = tenant.id
            and purchased_at >= now - config.long_period_months.months
            and supplier_id != null
        grouped by supplier_id
        ranked by sum(bam_amount) descending
        mapped to RankedEntity(
            name: Supplier.display_name,
            total_spend_bam: sum(bam_amount),
            expense_count: count
        )
    )
}

rule ComputeTopStores {
    when: DashboardLoaded(tenant)

    -- Same ranking logic as suppliers, but for stores

    ensures: top_stores = top(config.top_n,
        Expenses
            where tenant_id = tenant.id
            and purchased_at >= now - config.long_period_months.months
            and store_id != null
        grouped by store_id
        ranked by sum(bam_amount) descending
        mapped to RankedEntity(
            name: Store.name,
            total_spend_bam: sum(bam_amount),
            expense_count: count
        )
    )
}

rule ComputeTopArticles {
    when: DashboardLoaded(tenant)

    -- Rank articles by purchase frequency (count of expense_item rows)
    -- Show average unit_price in the primary currency of the tenant

    ensures: top_articles = compute_top_articles(
        tenant,
        config.top_n,
        config.long_period_months
    )
}

-- Price change detection

rule ComputePriceChanges {
    when: DashboardLoaded(tenant)

    -- For each article purchased in the recent window,
    -- compare avg unit_price in last 30 days vs previous 90 days.
    -- Only include articles with at least min_observations_for_price_change
    -- observations in BOTH windows.

    ensures: price_changes = compute_price_changes(
        tenant,
        config.top_n,
        config.price_comparison_recent_days,
        config.price_comparison_baseline_days,
        config.min_observations_for_price_change
    )
}

-- Category breakdown

rule ComputeCategoryBreakdown {
    when: DashboardLoaded(tenant)

    -- Group tenant expenses (last 6 months) by expense_category_id.
    -- Compute each category's share of total spend as a percentage.
    -- Include all categories that have at least one expense.
    -- Uncategorised expenses (expense_category_id = null) are grouped
    -- under a synthetic "Nekategorizirano" / "Uncategorised" label.
    -- Ordered by total_spend_bam descending.

    ensures: category_breakdown = compute_category_breakdown(
        tenant,
        config.long_period_months
    )
}

-- Spending averages

rule ComputeSpendingAverages {
    when: DashboardLoaded(tenant)

    ensures: averages = compute_spending_averages(
        tenant,
        config.short_period_days,
        config.long_period_months
    )
}

-- Monthly spending trend

rule ComputeMonthlyTrend {
    when: DashboardLoaded(tenant)

    -- 6 buckets, one per calendar month, most recent first.
    -- Each bucket aggregates all tenant expenses whose purchased_at
    -- falls within that calendar month.

    ensures: monthly_trend = compute_monthly_trend(
        tenant,
        config.long_period_months
    )
}

-- Biggest expense this month

rule ComputeBiggestExpense {
    when: DashboardLoaded(tenant)

    -- Single largest expense by bam_amount in the current calendar month.
    -- Null if no expenses exist this month.

    ensures: biggest_expense = compute_biggest_expense(tenant)
}

-- Unmapped alias count (admin/owner only)

rule ComputeUnmappedAliasCount {
    when: DashboardLoaded(tenant, viewer_role)
    requires: viewer_role in {owner, admin}

    -- Count article_aliases that have no article_id assigned.
    -- These are OCR-extracted labels not yet linked to a canonical article.
    -- Not tenant-scoped (aliases are global), but filtered via
    -- expense_items that belong to this tenant's expenses.

    ensures: unmapped_alias_count = compute_unmapped_alias_count(tenant)
}

-- Team overview

rule ComputeTeamOverview {
    when: DashboardLoaded(tenant)

    ensures: team = compute_team_overview(tenant)
}

------------------------------------------------------------
-- Invariants
------------------------------------------------------------

invariant RankingBound {
    top_suppliers.count <= config.top_n
    and top_stores.count <= config.top_n
    and top_articles.count <= config.top_n
    and price_changes.count <= config.top_n
    and monthly_trend.count = config.long_period_months
}

invariant AdminOnlyFields {
    -- unmapped_alias_count is only populated when viewer_role is
    -- owner or admin. For member/viewer roles, it is null and the
    -- corresponding widget is hidden.
}

invariant TenantScoped {
    -- All dashboard data is scoped to the authenticated user's active tenant.
    -- No cross-tenant data leakage.
}

invariant BamAsCommonDenominator {
    -- All monetary totals and comparisons use the pre-computed bam_amount column,
    -- not runtime currency conversion. This ensures consistent aggregation
    -- across multi-currency expenses.
}

------------------------------------------------------------
-- Surfaces
------------------------------------------------------------

surface DashboardAPI {
    -- Backend endpoint serving dashboard data for the authenticated tenant user

    provides:
        GetDashboardData(tenant_id, viewer_role) -> DashboardState

    @guarantee TenantIsolation
        -- tenant_id and viewer_role are extracted from the authenticated
        -- session, not from request parameters. Users cannot request
        -- another tenant's dashboard or escalate their role.

    @guarantee SingleRequest
        -- Dashboard data is served in a single API response.
        -- The frontend makes one fetch on page load, not
        -- separate requests per widget.

    @guarantee RoleAwareResponse
        -- When viewer_role is member or viewer, the response omits
        -- unmapped_alias_count (set to null).
        -- The backend does not run that query at all for
        -- non-admin roles — not just hidden client-side.

    @guidance
        -- The backend may compute all aggregates in a single SQL query
        -- or a small batch of queries. Avoid N+1 patterns.
        -- Consider a materialized/cached approach if query time
        -- exceeds acceptable thresholds.
}

surface DashboardPage {
    -- Frontend page rendering the workspace dashboard

    provides:
        RenderDashboard(state: DashboardState)
        RenderEmptyState()                        -- when has_data = false
        RenderLoadingState()
        RenderErrorState(message: String)

    @guarantee ResponsiveLayout
        -- Widgets reflow from multi-column to single-column
        -- on narrow viewports. Summary cards stack vertically
        -- on mobile.

    @guarantee SkeletonLoading
        -- Each widget shows a skeleton placeholder while data loads.
        -- The page is usable immediately, not blocked by a full-page spinner.

    @guidance
        -- Row 1: Two summary cards (Zadnjih 30 dana, Zadnjih 6 mjeseci)
        --         Each card includes inline avg (daily/weekly) and % comparison
        -- Row 2: Monthly trend bar chart (6 months, full width)
        -- Row 3: Three top-3 cards (Dobavljači, Prodavnice, Artikli)
        -- Row 4: Price changes + Category breakdown (2 columns)
        -- Row 5: Spending averages + Biggest expense this month (2 columns)
        -- Row 6: Team widget + Admin alerts (pending count, unmapped count) (2 columns)
        --         Admin alerts only visible for owner/admin roles
        -- Row 7: Prečice (shortcuts) — horizontal, role-gated
        --         Unmapped alias shortcut shows count badge for admins

    @guidance
        -- Trend arrows: ↑ green for increase, ↓ red for decrease, — grey for flat.
        -- For price changes: ↑/↓ arrows with percentage, colored by direction.
        -- "Flat" = less than 1% change.

    @guidance
        -- Category breakdown renders as a horizontal stacked bar or simple
        -- ranked list with percentage bars. Not a pie chart — hard to read
        -- with many small slices.
}

surface DashboardNavigation {
    -- Sidebar and in-page navigation related to the dashboard

    @guarantee WorkspaceMembersOnDashboard
        -- The sidebar Workspace section (Members, Impersonation links)
        -- is removed for non-power-users. Team management is accessed
        -- via the Team widget on the dashboard instead.

    @guarantee DashboardIsLandingPage
        -- Authenticated tenant users land on /dashboard after login
        -- and after tenant selection.
}

------------------------------------------------------------
-- Open Questions
------------------------------------------------------------

open question "Should price change arrows be colored (green/red) or neutral?"
    -- Green ↑ / red ↓ implies judgment (increase = bad). For groceries this
    -- makes sense, but for revenue-type expenses it might not. Decide based
    -- on primary use case.

open question "Should the Team widget show online/active status of members?"
    -- Current session tracking only exists for admins. Adding it for tenant
    -- members would require new infrastructure.

open question "Sparkline/trend chart in summary cards?"
    -- A mini bar chart showing daily/weekly spending over the period
    -- would make summary cards more visually engaging. Adds frontend
    -- complexity (chart library or SVG rendering). Consider for v2.
