-- allium: 3

entity BackendDomainManifest {
    id: String
    has_admin_api_route: Boolean
    has_user_api_route: Boolean
    has_spa_routes: Boolean
}

entity CanonicalRouteDescriptor {
    id: String
    path: String
    spa_fallback: Boolean
}

entity ExpensesRouteFactoryConfig {
    route_segment: String
    has_route_middleware: Boolean
    supports_count: Boolean
    supports_search: Boolean
}

surface ExpensesDomainManifestBoundary {
    context manifest: BackendDomainManifest

    provides:
        ResolveExpensesDomainManifest()
            when manifest = manifest
        BuildExpensesAdminDomainRouteTree(db, service_container)
        BuildExpensesUserDomainRouteTree(db, wrap_user_authentication, app_config)
        ResolveExpensesSpaFallbackPaths()

    @guarantee ExpensesManifestUsesStableId
        -- ResolveExpensesDomainManifest().id = "expenses".

    @guarantee AdminRouteTreeUsesExpensesRoot
        -- BuildExpensesAdminDomainRouteTree(db, service_container) is rooted at "/expenses".

    @guarantee UserRouteTreeUsesExpensesRoot
        -- BuildExpensesUserDomainRouteTree(db, wrap_user_authentication, app_config) is rooted at "/expenses".

    @guarantee UserRouteTreeAppliesInjectedAuthAtRoot
        -- BuildExpensesUserDomainRouteTree(db, wrap_user_authentication, app_config) applies injected
        -- `wrap_user_authentication` middleware at the "/expenses" route root.

    @guarantee SpaFallbackPathsDelegateToSharedDescriptorContract
        -- ResolveExpensesSpaFallbackPaths() delegates to shared descriptor-derived
        -- `expenses-user-route-contract/spa-fallback-paths`.
}

surface TemplateCompositionBoundaryForExpenses {
    provides:
        ComposeAdminApiRoutes(db, service_container)
        ComposeVersionedUserApiRoutes(db, service_container)
        ComposeSpaFallbackRoutes()

    @guarantee AdminRoutesMountUnderTemplateAdminRoot
        -- ComposeAdminApiRoutes(db, service_container) mounts domain admin trees under template root
        -- "/admin/api".

    @guarantee ExpensesAdminSubtreeRemainsStable
        -- Expenses admin domain route tree rooted at "/expenses" composes to stable subtree
        -- "/admin/api/expenses".

    @guarantee UserRoutesMountUnderTemplateVersionedRoot
        -- ComposeVersionedUserApiRoutes(db, service_container) mounts domain user trees under
        -- template root "/api/v1".

    @guarantee ExpensesUserSubtreeRemainsStable
        -- Expenses user domain route tree rooted at "/expenses" composes to stable subtree
        -- "/api/v1/expenses".

    @guarantee UserRoutesReceiveOptionalAppConfig
        -- ComposeVersionedUserApiRoutes(db, service_container) passes optional `app_config` from
        -- service container into `all-user-api-routes` before domain route invocation.

    @guarantee NullDomainUserRouteTreesAreFiltered
        -- ComposeVersionedUserApiRoutes(db, service_container) filters null domain user route trees
        -- before insertion.

    @guarantee SpaFallbackCompositionUsesDomainRegistryOutput
        -- ComposeSpaFallbackRoutes() maps backend SPA GET handlers from
        -- `domain-registry/all-spa-routes`; expenses contributes paths via shared canonical descriptors.
}

surface ExpensesUserApiRouteFamilies {
    provides:
        AccessSummaryEndpoints(actor)
        AccessSettingsEndpoints(actor)
        AccessReferenceDataEndpoints(actor)
        AccessReceiptEndpoints(actor)
        AccessArticleAndAliasEndpoints(actor)
        AccessExpenseCrudAndBatchEndpoints(actor)

    @guarantee SummaryEndpointsRemainGroupedUnderExpensesPrefix
        -- AccessSummaryEndpoints(actor) includes representative grouped routes under
        -- "/api/v1/expenses", including "/summary", "/by-month", and "/by-supplier".

    @guarantee SettingsEndpointsRemainGrouped
        -- AccessSettingsEndpoints(actor) includes the current user-expense profile/settings routes
        -- under "/api/v1/profile": "" (get), "/defaults" (put), "/export" (get),
        -- and "/all" (delete).

    @guarantee ReferenceDataEndpointsCoverCoreExpenseReferences
        -- AccessReferenceDataEndpoints(actor) includes representative grouped routes for suppliers,
        -- payers, stores, cities, manufacturers, categories, expense-categories,
        -- subcategories, and reference aliases.

    @guarantee ReceiptEndpointsCoverUploadReviewAndBatchFlows
        -- AccessReceiptEndpoints(actor) includes representative grouped routes such as
        -- "/upload", "/receipts", "/receipts/:id", "/receipts/:id/approve",
        -- "/receipts/:id/review", "/receipts/:id/ocr", and "/receipts/batch".

    @guarantee ArticleAndAliasEndpointsCoverMappingFlows
        -- AccessArticleAndAliasEndpoints(actor) includes representative grouped routes for
        -- "/articles", "/articles/unmapped-aliases", alias mapping, and alias batch/update surfaces.

    @guarantee ExpenseCrudAndBatchEndpointsRemainAvailable
        -- AccessExpenseCrudAndBatchEndpoints(actor) includes representative grouped routes such as
        -- the root list/create surface, "/:id" (get/put), "/batch" (put/delete), and
        -- "/batch-delete" (post).

    @guidance
        -- User route comments mark practical role-gated intent (for example: power-user-only and
        -- admin/owner-only semantics on selected mutation routes). Enforcement for these semantics
        -- is implemented in handlers and route-specific middleware, not by a single global role
        -- gate on the route table.
}

surface ExpensesAdminRouteFactoryBoundary {
    context config: ExpensesRouteFactoryConfig

    provides:
        ReadJsonBody(request)
        NormalizeKeysToAppBoundary(data)
        ConvertToDbBoundary(data)
        BuildStandardEntityRoutes(db, config)
        BuildExtendedEntityRoutes(db, config)

    @guarantee JsonBodyReaderUsesFiveStageFallback
        -- ReadJsonBody(request) fallback order is: pre-parsed map in `:body`, map in
        -- `:body-params`, map in `[:parameters :body]`, raw body JSON parse (InputStream/String),
        -- and `{}` when body is nil or parse fails.

    @guarantee KeyNormalizationProducesCanonicalAppKeys
        -- NormalizeKeysToAppBoundary(data) converts boundary map keys into canonical app keys
        -- (snake_case/string accepted, app kebab-case keywords produced).

    @guarantee DbBoundaryConversionPerformsConservativeUuidCoercion
        -- ConvertToDbBoundary(data) converts app keys back to DB snake_case keys and performs
        -- conservative UUID coercion for `id` and `*_id` string values (blank => null, valid UUID
        -- string => UUID object).

    @guarantee StandardEntityRoutesExposeCoreCrudSurfaces
        -- BuildStandardEntityRoutes(db, config) assembles route root `"/" + route_segment` with
        -- standard surfaces: root get/post, "/batch" delete, and "/:id" get/put.

    @guarantee ExtendedEntityRoutesMayAddOptionalSurfaces
        -- BuildExtendedEntityRoutes(db, config) includes standard surfaces and may add "/count",
        -- "/search", and configured additional routes.

    @guarantee RouteMiddlewareAppliesAtEntityRootWhenConfigured
        -- When `config.has_route_middleware`, both standard and extended builders apply route
        -- middleware at the entity route root.

    @guarantee PayerRoutesUseConfiguredEntityBuilder
        -- Payer admin routes are assembled from the payer route config through the generic
        -- entity-route builder and expose the standard payer CRUD subtree.
}

surface ExpensesAdminDuplicatesBoundary {
    provides:
        DetectDuplicates(actor, entity_type, strategy, options)
        PreviewDuplicateMerge(actor, entity_type, primary_id, secondary_ids)
        ExecuteDuplicateMerge(actor, entity_type, primary_id, secondary_ids)
        IgnoreDuplicateCluster(actor, entity_type, cluster_id, member_ids)
        UnignoreDuplicateCluster(actor, entity_type, cluster_id)
        ListIgnoredDuplicateClusters(actor, filters)

    @guarantee DuplicateMergeRequiresElevatedAdminTier
        -- PreviewDuplicateMerge(actor, entity_type, primary_id, secondary_ids) and
        -- ExecuteDuplicateMerge(actor, entity_type, primary_id, secondary_ids) require elevated
        -- admin role tier (`admin`, `owner`, or `super_admin`), returning 403 for lower tiers.

    @guarantee PrefixDuplicateDetectionBoundsFetchLimit
        -- DetectDuplicates(actor, entity_type, :prefix, options) supports optional `fetch-limit`;
        -- the effective value is bounded to [1, 20000] with default 5000 when omitted or invalid.

    @guarantee IgnoreDuplicateClusterFlowsNeedOnlyAuthenticatedAdminSession
        -- IgnoreDuplicateCluster(actor, entity_type, cluster_id, member_ids),
        -- UnignoreDuplicateCluster(actor, entity_type, cluster_id), and
        -- ListIgnoredDuplicateClusters(actor, filters) require authenticated admin session and do
        -- not require elevated role tier.
}

surface SharedDescriptorSourceOfTruthBoundary {
    context descriptors: List<CanonicalRouteDescriptor>

    provides:
        BuildFrontendUserRoutesFromDescriptors()
            when descriptors = descriptors
        BuildBackendSpaFallbackPathsFromDescriptors()

    @guarantee FrontendUserRoutesAreDescriptorBacked
        -- Frontend user route declarations for expenses are generated from shared expenses route
        -- descriptors.

    @guarantee BackendSpaFallbacksUseSameDescriptorSet
        -- Backend expenses SPA fallback paths are extracted from the same descriptor set through
        -- `route-contract/spa-fallback-paths`.

    @guarantee DescriptorWiringKeepsFrontendAndBackendInSync
        -- Descriptor-backed wiring keeps frontend navigable user paths and backend SPA fallback
        -- coverage synchronized at source.
}

-- allium-ignore allium.deferred.missingLocationHint
deferred DetailedExpenseReceiptOCRLifecycle

-- Guidance:
-- Detailed receipt OCR lifecycle/state-machine behavior is intentionally deferred to
-- candidate spec `specs/allium/drafts/expenses/receipt-ocr.candidate.allium`.
