entity BackendDomainManifest {
    id: String
    has_admin_api_route: Boolean
    has_user_api_route: Boolean
    has_spa_routes: Boolean
}

entity CanonicalRouteDescriptor {
    id: String
    path: String
    spa_fallback: Boolean
}

entity ExpensesRouteFactoryConfig {
    route_segment: String
    has_route_middleware: Boolean
    supports_count: Boolean
    supports_search: Boolean
}

surface ExpensesDomainManifestBoundary {
    context manifest: BackendDomainManifest

    provides:
        ResolveExpensesDomainManifest()
        BuildExpensesAdminDomainRouteTree(db, service_container)
        BuildExpensesUserDomainRouteTree(db, wrap_user_authentication, app_config)
        ResolveExpensesSpaFallbackPaths()

    guarantee:
        ResolveExpensesDomainManifest().id = "expenses"

    guarantee:
        BuildExpensesAdminDomainRouteTree(db, service_container) is rooted at "/expenses".

    guarantee:
        BuildExpensesUserDomainRouteTree(db, wrap_user_authentication, app_config) is rooted at "/expenses".

    guarantee:
        BuildExpensesUserDomainRouteTree(db, wrap_user_authentication, app_config) applies injected `wrap_user_authentication` middleware at the "/expenses" route root.

    guarantee:
        ResolveExpensesSpaFallbackPaths() delegates to shared descriptor-derived `expenses-user-route-contract/spa-fallback-paths`.
}

surface TemplateCompositionBoundaryForExpenses {
    provides:
        ComposeAdminApiRoutes(db, service_container)
        ComposeVersionedUserApiRoutes(db, service_container)
        ComposeSpaFallbackRoutes()

    guarantee:
        ComposeAdminApiRoutes(db, service_container) mounts domain admin trees under template root "/admin/api".

    guarantee:
        Expenses admin domain route tree rooted at "/expenses" composes to stable subtree "/admin/api/expenses".

    guarantee:
        ComposeVersionedUserApiRoutes(db, service_container) mounts domain user trees under template root "/api/v1".

    guarantee:
        Expenses user domain route tree rooted at "/expenses" composes to stable subtree "/api/v1/expenses".

    guarantee:
        ComposeVersionedUserApiRoutes(db, service_container) passes optional `app_config` from service container into `all-user-api-routes` before domain route invocation.

    guarantee:
        ComposeVersionedUserApiRoutes(db, service_container) filters null domain user route trees before insertion.

    guarantee:
        ComposeSpaFallbackRoutes() maps backend SPA GET handlers from `domain-registry/all-spa-routes`; expenses contributes paths via shared canonical descriptors.
}

surface ExpensesUserApiRouteFamilies {
    provides:
        AccessSummaryEndpoints(actor)
        AccessSettingsEndpoints(actor)
        AccessReferenceDataEndpoints(actor)
        AccessReceiptEndpoints(actor)
        AccessArticleAndAliasEndpoints(actor)
        AccessExpenseCrudAndBatchEndpoints(actor)

    guarantee:
        AccessSummaryEndpoints(actor) includes representative grouped routes under "/api/v1/expenses":
        - "/summary"
        - "/by-month"
        - "/by-supplier"

    guarantee:
        AccessSettingsEndpoints(actor) includes representative grouped routes:
        - "/settings" (get/put)
        - "/export" (get)
        - "/all" (delete)

    guarantee:
        AccessReferenceDataEndpoints(actor) includes representative grouped routes for suppliers, payers, payer-types, stores, cities, manufacturers, categories, expense-categories, subcategories, and reference aliases.

    guarantee:
        AccessReceiptEndpoints(actor) includes representative grouped routes:
        - "/upload"
        - "/receipts"
        - "/receipts/:id"
        - "/receipts/:id/approve"
        - "/receipts/:id/review"
        - "/receipts/:id/ocr"
        - "/receipts/batch"

    guarantee:
        AccessArticleAndAliasEndpoints(actor) includes representative grouped routes for "/articles", "/articles/unmapped-aliases", alias mapping, and alias batch/update surfaces.

    guarantee:
        AccessExpenseCrudAndBatchEndpoints(actor) includes representative grouped routes:
        - "" (expenses list/create at root)
        - "/:id" (get/put)
        - "/batch" (put/delete)
        - "/batch-delete" (post)

    guidance:
        User route comments mark practical role-gated intent (for example: power-user-only and admin/owner-only semantics on selected mutation routes). Enforcement for these semantics is implemented in handlers and route-specific middleware, not by a single global role gate on the route table.
}

surface ExpensesAdminRouteFactoryBoundary {
    context config: ExpensesRouteFactoryConfig

    provides:
        ReadJsonBody(request)
        NormalizeKeysToAppBoundary(data)
        ConvertToDbBoundary(data)
        BuildStandardEntityRoutes(db, config)
        BuildExtendedEntityRoutes(db, config)

    guarantee:
        ReadJsonBody(request) fallback order is:
        1) pre-parsed map in `:body`
        2) map in `:body-params`
        3) map in `[:parameters :body]`
        4) raw body JSON parse (InputStream/String)
        5) `{}` when body is nil or parse fails.

    guarantee:
        NormalizeKeysToAppBoundary(data) converts boundary map keys into canonical app keys (snake_case/string accepted, app kebab-case keywords produced).

    guarantee:
        ConvertToDbBoundary(data) converts app keys back to DB snake_case keys and performs conservative UUID coercion for `id` and `*_id` string values (blank => null, valid UUID string => UUID object).

    guarantee:
        BuildStandardEntityRoutes(db, config) assembles route root `"/" + route_segment` with standard surfaces:
        - "" (get/post)
        - "/batch" (delete)
        - "/:id" (get/put)

    guarantee:
        BuildExtendedEntityRoutes(db, config) includes standard surfaces and may add "/count", "/search", and configured additional routes.

    guarantee:
        When `config.has_route_middleware`, both standard and extended builders apply route middleware at the entity route root.

    guarantee:
        Payer-types admin config uses route-level middleware requiring at least admin role via `wrap-admin-role ... :admin`.
}

surface SharedDescriptorSourceOfTruthBoundary {
    context descriptors: List<CanonicalRouteDescriptor>

    provides:
        BuildFrontendUserRoutesFromDescriptors()
        BuildBackendSpaFallbackPathsFromDescriptors()

    guarantee:
        Frontend user route declarations for expenses are generated from shared expenses route descriptors.

    guarantee:
        Backend expenses SPA fallback paths are extracted from the same descriptor set through `route-contract/spa-fallback-paths`.

    guarantee:
        Descriptor-backed wiring keeps frontend navigable user paths and backend SPA fallback coverage synchronized at source.
}

deferred DetailedExpenseReceiptOCRLifecycle

guidance:
    Detailed receipt OCR lifecycle/state-machine behavior is intentionally deferred to candidate spec `specs/allium/drafts/expenses/receipt-ocr.candidate.allium`.
