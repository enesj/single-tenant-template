{;; =============================================================================
 ;; Admin/Template Core Table Column Configurations
 ;; =============================================================================
 ;; Runtime-editable table column settings for template/admin entities.
 ;; Domain-specific table columns are in their respective domain config files.

 :admins
 {:available-columns
  ["id"
   "email"
   "full-name"
   "role"
   "status"
   "last-login-at"
   "created-at"
   "updated-at"],
  :default-visible-columns
  ["id"
   "email"
   "full-name"
   "role"
   "status"
   "last-login-at"
   "created-at"
   "updated-at"],
  :filterable-columns
  ["email" "full-name" "role" "status" "last-login-at"],
  :sortable-columns ["email" "full-name" "role" "status" "created-at"],
  :always-visible ["id"],
  :computed-fields {},
  :column-config
  {:role {:width "100px", :formatter "admin-role-badge"},
   :updated-at {:width "140px", :formatter "date"},
   :email {:width "220px", :formatter "email-link"},
   :last-login-at {:width "160px", :formatter "date"},
   :status {:width "100px", :formatter "status-badge"},
   :full-name {:width "180px"},
   :created-at {:width "140px", :formatter "date"}}}

 :audit-logs
 {:available-columns
  ["action"
   "entity-type"
   "entity-id"
   "entity-name"
   "admin-email"
   "admin-name"
   "ip-address"
   "user-agent"
   "changes"],
  :default-visible-columns
  ["action"
   "entity-type"
   "entity-name"
   "admin-email"
   "admin-name"
   "ip-address"
   "changes"],
  :filterable-columns
  ["action"
   "entity-type"
   "entity-id"
   "entity-name"
   "admin-email"
   "admin-name"
   "ip-address"
   "user-agent"
   "changes"],
  :sortable-columns
  ["action"
   "entity-type"
   "entity-id"
   "entity-name"
   "admin-email"
   "admin-name"
   "ip-address"
   "user-agent"
   "changes"],
  :always-visible ["action"],
  :computed-fields
  {:entity-name
   {:type "join",
    :compute-fn "join-entity-name",
    :dependencies ["entity-type" "entity-id"]},
   :admin-email
   {:type "join",
    :compute-fn "join-admin-email",
    :dependencies ["admin-id"]},
   :admin-name
   {:type "join",
    :compute-fn "join-admin-name",
    :dependencies ["admin-id"]}},
  :column-config
  {:entity-type {:width "120px"},
   :user-agent {:width "200px"},
   :admin-email {:width "180px"},
   :entity-id {:width "140px"},
   :entity-name {:width "200px", :computed-field true},
   :changes {:width "220px", :formatter "collapsible-json"},
   :action {:width "120px", :formatter "audit-action-badge"},
   :admin-name {:width "140px"},
   :ip-address {:width "140px"}}}

 :login-events
 {:available-columns
  ["created-at"
   "principal-type"
   "principal-email"
   "principal-name"
   "success"
   "reason"
   "ip-address"
   "user-agent"],
  :default-visible-columns
  ["created-at"
   "principal-type"
   "principal-email"
   "principal-name"
   "success"
   "reason"
   "ip-address"],
  :filterable-columns
  ["created-at"
   "principal-type"
   "principal-email"
   "principal-name"
   "success"
   "reason"
   "ip-address"
   "user-agent"],
  :sortable-columns
  ["created-at"
   "principal-type"
   "principal-email"
   "principal-name"
   "success"
   "ip-address"
   "user-agent"],
  :always-visible ["user-agent"],
  :computed-fields {},
  :column-config
  {:created-at {:width "180px", :formatter "date"},
   :principal-type {:width "110px"},
   :principal-email {:width "220px"},
   :principal-name {:width "180px"},
   :success {:width "100px"},
   :reason {:width "200px"},
   :ip-address {:width "140px"},
   :user-agent {:width "260px"}}}

 :users
 {:available-columns
  ["id"
   "email"
   "full-name"
   "status"
   "role"
   "last-login-at"
   "email-verified-at"
   "created-at"
   "updated-at"],
  :default-visible-columns
  ["id" "status" "role" "email-verified-at" "created-at"],
  :filterable-columns
  ["status" "role" "last-login-at" "created-at" "updated-at"],
  :sortable-columns ["status" "created-at"],
  :always-visible ["id" "email"],
  :computed-fields {},
  :column-config
  {:role {:width "100px", :formatter "role-badge"},
   :updated-at {:width "140px", :formatter "date"},
   :email {:width "200px", :formatter "email-link"},
   :email-verified-at {:width "180px", :formatter "date"},
   :last-login-at {:width "160px", :formatter "date"},
   :status {:width "100px", :formatter "status-badge"},
   :full-name {:width "180px"},
   :created-at {:width "140px", :formatter "date"}}}}
