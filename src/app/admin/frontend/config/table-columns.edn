{;; =============================================================================
 ;; Admin/Template Core Table Column Configurations
 ;; =============================================================================
 ;; Runtime-editable table column settings for template/admin entities.
 ;; Domain-specific table columns are in their respective domain config files.

 :admins
 {:available-columns
  ["id" "email" "full-name" "role" "status" "last-login-at" "created-at" "updated-at" "password-hash"],
  :default-visible-columns
  ["id"
   "email"
   "full-name"
   "role"
   "status"
   "last-login-at"
   "created-at"
   "updated-at"],
  :filterable-columns
  ["email" "full-name" "role" "status" "last-login-at"],
  :sortable-columns ["email" "full-name" "role" "status" "created-at"],
  :always-visible ["id"],
  :computed-fields {},
  :column-config
  {:role {:width "100px", :formatter "admin-role-badge"},
   :updated-at {:width "140px", :formatter "date"},
   :email {:width "220px", :formatter "email-link"},
   :last-login-at {:width "160px", :formatter "date"},
   :status {:width "100px", :formatter "status-badge"},
   :full-name {:width "180px"},
   :created-at {:width "140px", :formatter "date"}}}

 :audit-logs
 {:available-columns
  ["action" "entity-name" "admin-email" "admin-name" "user-agent" "id" "actor-type" "actor-id" "target-type" "target-id" "metadata" "ip" "created-at"],
  :default-visible-columns
  ["action" "entity-name" "admin-email" "admin-name"],
  :filterable-columns
  ["action" "entity-name" "admin-email" "admin-name" "user-agent"],
  :sortable-columns
  ["action" "entity-name" "admin-email" "admin-name" "user-agent"],
  :always-visible ["action"],
  :computed-fields
  {:entity-name
   {:type "join",
    :compute-fn "join-entity-name",
    :dependencies ["entity-type" "entity-id"]},
   :admin-email
   {:type "join",
    :compute-fn "join-admin-email",
    :dependencies ["admin-id"]},
   :admin-name
   {:type "join",
    :compute-fn "join-admin-name",
    :dependencies ["admin-id"]}},
  :column-config
  {:user-agent {:width "200px"},
   :admin-email {:width "180px"},
   :entity-name {:width "200px", :computed-field true},
   :action {:width "120px", :formatter "audit-action-badge"},
   :admin-name {:width "140px"}}}

 :login-events
 {:available-columns
  ["created-at" "principal-type" "success" "reason" "user-agent" "id" "principal-id" "ip"],
  :default-visible-columns
  ["created-at" "principal-type" "success" "reason"],
  :filterable-columns
  ["created-at" "principal-type" "success" "reason" "user-agent"],
  :sortable-columns
  ["created-at" "principal-type" "success" "user-agent"],
  :always-visible ["user-agent"],
  :computed-fields {},
  :column-config
  {:created-at {:width "180px", :formatter "date"},
   :principal-type {:width "110px"},
   :success {:width "100px"},
   :reason {:width "200px"},
   :user-agent {:width "260px"}}}

 :users
 {:available-columns
  ["id" "email" "full-name" "status" "role" "last-login-at" "created-at" "updated-at" "password-hash" "email-verified" "avatar-url" "auth-provider" "provider-user-id"],
  :default-visible-columns
  ["id" "status" "role" "created-at"],
  :filterable-columns
  ["status" "role" "last-login-at" "created-at" "updated-at"],
  :sortable-columns ["status" "created-at"],
  :always-visible ["id" "email"],
  :computed-fields {},
  :column-config
  {:role {:width "100px", :formatter "role-badge"},
   :updated-at {:width "140px", :formatter "date"},
   :email {:width "200px", :formatter "email-link"},
   :last-login-at {:width "160px", :formatter "date"},
   :status {:width "100px", :formatter "status-badge"},
   :full-name {:width "180px"},
   :created-at {:width "140px", :formatter "date"}}}}
