{;; =============================================================================
 ;; Admin/Template Core Entity Configurations
 ;; =============================================================================
 ;; These are infrastructure entities owned by template/admin.
 ;; Domain-specific entities (e.g., expenses) are configured in their respective
 ;; domain config files (src/app/domain/**/admin/config/entities.edn).

 :audit-logs
 {:entity-key :audit-logs
  :page-title "Audit Logs"
  :page-description "Complete system audit trail and security monitoring"
  :adapter-init-fn app.admin.frontend.adapters.audit/init-audit-adapter!
  :display-settings {:show-select? true
                     :show-edit? true
                     :show-delete? true
                     :show-filtering? true
                     :show-highlights? true
                     :show-batch-edit? false
                     :show-batch-delete? true
                     :show-add-button? false
                     :show-pagination? true
                     :per-page 20}
  :features {:read-only? true
             :batch-operations? true
             :deletion-constraints? true
             :security-wrapper? false}
  :components {:actions app.admin.frontend.components.enhanced-action-buttons/enhanced-action-buttons
               :custom-actions app.admin.frontend.components.audit-actions/admin-audit-actions
               :modals [app.admin.frontend.components.audit-details-modal/audit-details-modal]
               :custom-header app.admin.frontend.components.audit-export-controls/export-controls}
  :custom-content {:active-filters-display true}}

 :login-events
 {:entity-key :login-events
  :page-title "Login Events"
  :page-description "Global view of admin and user login attempts"
  :adapter-init-fn app.admin.frontend.adapters.login-events/init-login-events-adapter!
  :display-settings {:show-select? true
                     :show-edit? false
                     :show-delete? false
                     :show-filtering? true
                     :show-pagination? true
                     :show-add-button? false
                     :per-page 20}
  :features {:read-only? false
             :batch-operations? true
             :deletion-constraints? false
             :security-wrapper? false}
  :components {:actions app.admin.frontend.components.enhanced-action-buttons/enhanced-action-buttons}}

 :users
 {:entity-key :users
  :page-title "Advanced User Management"
  :page-description "Manage users for this single-tenant app"
  :adapter-init-fn app.admin.frontend.adapters.users/init-users-adapter!
  :display-settings {:show-select? true
                     :show-edit? true
                     :show-delete? false
                     :show-filtering? true
                     :show-pagination? true
                     :show-add-button? true
                     :per-page 25}
  :features {:batch-operations? true
             :deletion-constraints? true
             :security-wrapper? true}
  :components {:actions app.admin.frontend.components.enhanced-action-buttons/enhanced-action-buttons
               :modals [app.admin.frontend.components.user-details-modal/user-details-modal
                        app.admin.frontend.components.user-activity-modal/user-activity-modal]
               :custom-actions app.admin.frontend.components.user-actions/admin-user-actions}}

 :admins
 {:entity-key :admins
  :page-title "Admin Management"
  :page-description "Manage system administrators (owner-only access)"
  :adapter-init-fn app.admin.frontend.adapters.admins/init-admins-adapter!
  :display-settings {:show-select? true
                     :show-edit? true
                     :show-delete? true
                     :show-filtering? true
                     :show-pagination? true
                     :show-add-button? true
                     :per-page 20}
  :features {:batch-operations? false
             :deletion-constraints? false
             :security-wrapper? true}
  :components {:actions app.admin.frontend.components.enhanced-action-buttons/enhanced-action-buttons
               :custom-actions app.admin.frontend.components.admin-actions/admin-admin-actions}}}
