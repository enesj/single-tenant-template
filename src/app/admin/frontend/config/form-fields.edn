{;; =============================================================================
 ;; Admin/Template Core Form Field Configurations
 ;; =============================================================================
 ;; Runtime-editable form field settings for template/admin entities.
 ;; Domain-specific form fields are in their respective domain config files.

 :users
 {:create-fields
  ["email" "status" "full-name"],
  :edit-fields ["role" "status"],
  :required-fields ["email"],
  :field-config
  {:email {:type "email", :validation "email"},
   :role {:type "select", :options ["member" "admin" "owner"]},
   :status
   {:type "select", :options ["active" "inactive" "suspended"]}}}

 :admins
 {:create-fields [:email :full-name :role :status],
  :edit-fields [:email :full-name :role :status],
  :required-fields [:email],
  :field-config
  {:email
   {:type :email,
    :validation :email,
    :placeholder "admin@example.com"},
   :full-name {:type :text, :max-length 255, :placeholder "Full Name"},
   :role
   {:type :select, :options [:admin :support :owner], :default :admin},
   :status
   {:type :select, :options [:active :suspended], :default :active}}}}
