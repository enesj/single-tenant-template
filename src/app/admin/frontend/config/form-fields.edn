{:expense-items
 {:edit-fields ["article_id" "qty" "unit" "unit_price" "line_total"],
  :field-config
  {:article_id
   {:type "select",
    :label "Article",
    :options ["articles" "canonical_name"]},
   :qty {:type "number", :step 0.001},
   :unit {:type "select", :label "Unit", :options ["kom" "kg" "g" "l" "pak"]},
   :unit_price {:type "number", :step 0.01},
   :line_total {:type "number", :step 0.01}},
  :removed-fields {:edit-fields ["raw_label"]}},
 :admins
 {:create-fields [:email :full-name :role :status],
  :edit-fields [:email :full-name :role :status],
  :required-fields [:email],
  :field-config
  {:email
   {:type :email,
    :validation :email,
    :placeholder "admin@example.com"},
   :full-name {:type :text, :max-length 255, :placeholder "Full Name"},
   :role
   {:type :select, :options [:admin :support :owner], :default :admin},
   :status
   {:type :select, :options [:active :suspended], :default :active}}},
 :articles
 {:edit-fields
  ["manufacturer_id"
   "canonical_name"
   "unit"
   "subcategory_id"
   "link"
   "normalized_key"],
  :field-config
  {:unit {:type "select", :label "Unit", :default "kom", :options ["kom" "kg" "g" "l" "pak"]}
   :manufacturer_id
   {:type "select",
    :label "Manufacturer",
    :options ["manufacturers" "display_name"]}
   :subcategory_id
   {:type "select",
    :label "Subcategory",
    :options ["subcategories" "name"]}}}

 :categories
 {:create-fields ["name" "description"],
  :edit-fields ["name" "description"],
  :field-config
  {:name {:type "text", :label "Name"},
   :description {:type "textarea", :label "Description"}}}

 :cities
 {:create-fields ["name"],
  :edit-fields ["name"],
  :field-config {:name {:type "text", :label "Name"}}}

 :subcategories
 {:create-fields ["category_id" "name" "description"],
  :edit-fields ["category_id" "name" "description"],
  :field-config
  {:category_id
   {:type "select",
    :label "Category",
    :options ["categories" "name"]},
   :name {:type "text", :label "Name"},
   :description {:type "textarea", :label "Description"}}},
 :expenses
 {:create-fields
  ["purchased_at"
   "supplier_id"
   "currency"
   "total_amount"
   "notes"
   "is_posted"],
  :edit-fields
  ["purchased_at"
   "supplier_id"
   "currency"
   "total_amount"
   "notes"
   "is_posted"],
  :field-config
  {:purchased_at {:type "datetime-local"},
   :supplier_id
   {:type "select",
    :label "Supplier",
    :options ["suppliers" "display_name"]},
   :currency
   {:type "select", :label "Currency", :options ["BAM" "EUR" "USD"]},
   :total_amount {:type "number", :step 0.01},
   :notes {:type "textarea"},
   :is_posted {:type "checkbox"}}},
 :manufacturers
 {:create-fields ["display_name"],
  :edit-fields ["display_name"],
  :field-config {:display_name {:type "text", :label "Display name"}}},
 :supplier-aliases
 {:edit-fields ["raw_label" "raw_label_normalized" "supplier_id"],
  :field-config
  {:supplier_id
   {:type "select",
    :label "Supplier",
    :options ["suppliers" "display_name"]}}},
 :article-aliases
 {:edit-fields
  ["raw_label"
   "raw_label_normalized"
   "unit"
   "supplier_id"
   "article_id"
   "confidence"],
  :field-config
  {:supplier_id
   {:type "select",
    :label "Supplier",
    :options ["suppliers" "display_name"]},
   :unit {:type "select", :label "Unit", :options ["kom" "kg" "g" "l" "pak"]},
   :article_id
   {:type "select",
    :label "Article",
    :options ["articles" "canonical_name"]}}},
 :stores
 {:edit-fields ["display_name" "address"],
  :field-config
  {:display_name {:type "text", :label "Display name"},
   :address {:type "textarea", :label "Address"}}},
 :store-aliases
 {:edit-fields
  ["raw_label" "raw_label_normalized" "store_id" "confidence"],
  :field-config
  {:raw_label {:type "text", :label "Raw label"},
   :raw_label_normalized {:type "text", :label "Alias"},
   :store_id
   {:type "select", :label "Store", :options ["stores" "display_name"]},
   :confidence {:type "number", :step 1}}},
 :users
 {:create-fields ["email" "status" "full-name"],
  :edit-fields ["email" "full-name" "status"],
  :required-fields ["email"],
  :field-config
  {:email {:type "email", :validation "email"},
   :full-name
   {:type "text", :max-length 255, :placeholder "Full Name"},
   :status
   {:type "select", :options ["active" "inactive" "suspended"]}}}

 :backlog
 {:create-fields ["description" "status" "type"],
  :edit-fields ["description" "status" "type"],
  :required-fields ["description" "type"],
  :field-config
  {:number {:type "number", :label "Number", :step 1},
   :description {:type "textarea", :label "Description"},
   :status
   {:type "select",
    :label "Status",
    :default "Waiting",
    :options
    [{:value "Waiting", :label "Waiting", :color "#64748b"}
     {:value "In progress", :label "In Progress", :color "#0ea5e9"}
     {:value "Completed", :label "Completed", :color "#10b981"}
     {:value "Need improvements",
      :label "Need Improvements",
      :color "#f59e0b"}]},
   :type
   {:type "select",
    :label "Type",
    :options
    [{:value "Issue", :label "Issue", :color "#ef4444"}
     {:value "Feature", :label "Feature", :color "#22c55e"}
     {:value "Refactoring", :label "Refactoring", :color "#f59e0b"}
     {:value "Review", :label "Review", :color "#0ea5e9"}
     {:value "Improvement", :label "Improvement", :color "#6366f1"}]}}}}
