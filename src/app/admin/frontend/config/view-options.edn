{;; =============================================================================
 ;; Admin/Template Core View Options
 ;; =============================================================================
 ;; Runtime-editable view options for template/admin entities.
 ;; Domain-specific view options are in their respective domain config files.

 :admins
 {:column-locks {},
  :display-locks
  {:show-select? true, :show-pagination? true, :show-filtering? true},
  :column-defaults {:id true, :email false}}

 :audit-logs
 {:display-locks
  {:show-edit? false,
   :show-select? true,
   :show-add-button? false,
   :show-batch-edit? false},
  :display-defaults {:show-batch-delete? true}}

 :login-events
 {:display-locks
  {:show-add-button? false,
   :show-edit? false,
   :show-batch-edit? false},
  :display-defaults {:show-batch-delete? false}}

 :users
 {:display-defaults {:show-add-button? true, :show-edit? true},
  :display-locks {:show-batch-edit? true},
  :column-defaults {},
  :column-locks {:full-name true}}}
