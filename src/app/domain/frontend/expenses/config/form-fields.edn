{:expenses
 {:create-fields
  ["purchased_at"
   "supplier_id"
   "payer_id"
   "currency"
   "total_amount"
   "notes"
   "is_posted"],
  :edit-fields
  ["purchased_at"
   "supplier_id"
   "payer_id"
   "currency"
   "total_amount"
   "notes"
   "is_posted"],
  :field-config
  {:purchased_at {:type "datetime-local"},
   :supplier_id
   {:type "select",
    :label "Supplier",
    :options ["suppliers" "display_name"]},
   :payer_id
   {:type "select", :label "Payer", :options ["payers" "label"]},
   :currency
   {:type "select", :label "Currency", :options ["BAM" "EUR" "USD"]},
   :total_amount {:type "number", :step 0.01},
   :notes {:type "textarea"},
   :is_posted {:type "checkbox"}}},
 :article-aliases
 {:edit-fields
  ["raw_label" "raw_label_normalized" "supplier_id" "article_id"],
  :field-config
  {:supplier_id
   {:type "select",
    :label "Supplier",
    :options ["suppliers" "display_name"]},
   :article_id
   {:type "select",
    :label "Article",
    :options ["articles" "canonical_name"]}}},
 :supplier-aliases
 {:edit-fields ["raw_label" "raw_label_normalized" "supplier_id"],
  :field-config
  {:supplier_id
   {:type "select",
    :label "Supplier",
    :options ["suppliers" "display_name"]}}},
 :articles
 {:edit-fields
  ["manufacturer"
   "canonical_name"
   "category"
   "link"
   "normalized_key"]},
 :expense-items
 {:edit-fields
  ["article_id" "qty" "unit_price" "line_total"],
  :field-config
  {:article_id
   {:type "select",
    :label "Article",
    :options ["articles" "canonical_name"]},
   :qty {:type "number", :step 0.001},
   :unit_price {:type "number", :step 0.01},
   :line_total {:type "number", :step 0.01}} :removed-fields {:edit-fields ["raw_label"]}},
 :price-observations
 {:edit-fields
  ["observed_at" "article_id" "supplier_id" "unit_price" "currency"],
  :field-config
  {:observed_at {:type "datetime-local"},
   :article_id
   {:type "select",
    :label "Article",
    :options ["articles" "canonical_name"]},
   :supplier_id
   {:type "select",
    :label "Supplier",
    :options ["suppliers" "display_name"]},
   :unit_price {:type "number", :step 0.01},
   :currency
   {:type "select", :label "Currency", :options ["BAM" "EUR" "USD"]}}}}
