{;; =============================================================================
 ;; Expenses Domain - Form Field Configurations
 ;; =============================================================================
 ;; Runtime-editable form field settings for expenses domain entities.

 :suppliers
 {:create-fields [:display-name :address :tax-id],
  :edit-fields [:display-name :address :tax-id],
  :required-fields [:display-name],
  :field-config
  {:display-name
   {:type :text, :max-length 255, :placeholder "Supplier name"},
   :address {:type :text, :placeholder "Address (optional)"},
   :tax-id
   {:type :text, :max-length 50, :placeholder "Tax ID (optional)"}}}

 :payers
 {:create-fields [:type :label :last4 :is-default],
  :edit-fields [:type :label :last4 :is-default],
  :required-fields [:type :label],
  :field-config
  {:type {:type :select, :options [:cash :card :account :person]},
   :label
   {:type :text, :max-length 255, :placeholder "Payment method name"},
   :last4
   {:type :text,
    :max-length 4,
    :placeholder "Last 4 digits (cards only)"},
   :is-default {:type :boolean}}}

 :articles
 {:create-fields [:canonical-name :barcode :category],
  :edit-fields [:canonical-name :barcode :category],
  :required-fields [:canonical-name],
  :field-config
  {:canonical-name
   {:type :text, :max-length 255, :placeholder "Canonical name"},
   :barcode
   {:type :text, :max-length 50, :placeholder "Barcode (optional)"},
   :category
   {:type :text,
    :max-length 100,
    :placeholder "Category (optional)"}}}

 :expense-items
 {:create-fields [:expense-id :raw-label :article-id :qty :unit-price :line-total],
  :edit-fields [:expense-id :raw-label :article-id :qty :unit-price :line-total],
  :required-fields [:expense-id :raw-label :line-total],
  :field-config
  {:expense-id {:type :text,
                :label "Expense ID",
                :placeholder "Expense ID (UUID)"},
   :raw-label {:type :text,
               :label "Raw label",
               :max-length 255,
               :placeholder "Line item label"},
   :article-id {:type :text,
                :label "Article ID",
                :placeholder "Article ID (UUID, optional)"},
   :qty {:type :number, :step 0.001},
   :unit-price {:type :number, :step 0.01},
   :line-total {:type :number, :step 0.01}}}

 :article-aliases
 {:create-fields [:supplier-id :article-id :raw-label-normalized :confidence],
  :edit-fields [:article-id :raw-label-normalized :confidence],
  :required-fields [:supplier-id :article-id :raw-label-normalized],
  :field-config
  {:supplier-id {:type :select},
   :article-id {:type :select},
   :raw-label-normalized {:type :text,
                          :label "Raw label",
                          :max-length 255,
                          :placeholder "Raw label"},
   :confidence {:type :number, :min 0, :max 100, :default 100}}}

 :price-observations
 {:create-fields
  [:article-id
   :supplier-id
   :observed-at
   :qty
   :unit-price
   :line-total
   :currency],
  :edit-fields
  [:article-id
   :supplier-id
   :observed-at
   :qty
   :unit-price
   :line-total
   :currency],
  :required-fields [:article-id :supplier-id :line-total],
  :field-config
  {:article-id {:type :select},
   :supplier-id {:type :select},
   :observed-at {:type :datetime},
   :qty {:type :number, :step 0.001},
   :unit-price {:type :number, :step 0.01},
   :line-total {:type :number, :step 0.01},
   :currency {:type :text, :placeholder "Currency (default BAM)"}}}}
